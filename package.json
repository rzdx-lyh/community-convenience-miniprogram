{
  "name": "community-convenience-miniprogram",
  "version": "1.2.1",
  "private": true,
  "description": "公共服务 · 社区便民微信小程序（原生 + TypeScript，AI 问答 + 报修工单）",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint miniprogram tests",
    "lint:fix": "eslint miniprogram tests --fix",
    "format": "prettier --write \"{miniprogram,tests,docs,tools,cloudfunctions}/**/*.{ts,mjs,js,json,wxml,wxss,md}\" \"*.{json,md}\"",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "mock": "node scripts/mock-server.mjs",
    "mock:smoke": "node scripts/selftest.mjs",
    "build:cf": "node scripts/build-cf.mjs",
    "preflight": "node scripts/cloud-preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.13.0",
    "globals": "^15.12.0",
    "miniprogram-api-typings": "^4.0.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^5.0.3"
  }
}
