/* 我的页补充样式 */

/* 恢复图标尺寸档（layout 的 .ic 覆盖了 icons 的 .ic-s/.ic-m） */
.ic.ic-s { width: 32rpx; height: 32rpx; }
.ic.ic-m { width: 40rpx; height: 40rpx; }

.hover-dim { opacity: .86; }

/* 资料头：原型内联 padding-bottom:56px */
.hd--prof { padding-bottom: 40rpx; }

.pf-row { display: flex; align-items: flex-start; gap: 22rpx; padding: 0 0 8rpx; }
.pf-mid { flex: 1; min-width: 0; padding-top: 4rpx; }
.pf-badges { display: flex; align-items: center; gap: 10rpx; margin-top: 14rpx; }

/* 我的页不让统计卡压到蓝色资料头，避免统计文字骑在蓝白交界上 */
.body.body--prof { margin-top: 0; padding-top: 24rpx; }

/* 头像底色（原型内联 background） */
.av1 { background: #1F5FD6; }
.a2 { background: #0E7C6B; }
.a3 { background: #A86A05; }

/* 数据统计（原型 .pstats .c b / span） */
.pstats .c .n {
  display: block;
  font-size: calc(38rpx * var(--care-scale, 1));
  font-weight: 800;
  color: var(--blue);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.pstats .c .l { display: block; font-size: calc(18rpx * var(--care-scale, 1)); color: var(--t3); margin-top: 6rpx; }

/* 原型 HTML 标签选择器（b / em / span）改为类名后补排版 */
.st .b { font-size: calc(28rpx * var(--care-scale, 1)); font-weight: 800; flex: 1; }
.st .em { font-style: normal; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); }

.card--memb { padding-bottom: 12rpx; }
.card--pad { padding: 0 24rpx; }

.memb .mb .mb-n {
  font-size: calc(19rpx * var(--care-scale, 1));
  color: var(--t2);
  white-space: nowrap;
  max-width: 112rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.addr-list { padding: 4rpx 24rpx 0; }

.row .m-t { font-size: calc(25rpx * var(--care-scale, 1)); font-weight: 700; display: block; }
.row .m-s { font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); display: block; margin-top: 4rpx; }

.v-def { color: var(--blue); font-weight: 700; }
.v-set { color: var(--blue); font-size: calc(19rpx * var(--care-scale, 1)); }

/* 行内图标底色 */
.k-blue { background: #EAF1FE; }
.k-gray { background: #F1F4F9; }
.tone-blue { background: #EAF1FE; }
.tone-gold { background: #FDF3E1; }
.tone-teal { background: #E6F5F2; }

/* 设置项文案（.t/.d 已是类选择器，补 display） */
.pset .pr .plb .t { display: block; }
.pset .pr .plb .d { display: block; }

.pfoot {
  text-align: center;
  font-size: calc(19rpx * var(--care-scale, 1));
  color: var(--t3);
  padding: 32rpx 24rpx 44rpx;
  line-height: 1.7;
}
.pfoot text { display: block; }

/* 头像实图（2026-10-22）：铺满圆形头像框，替换首字占位 */
.pfa-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* ===== 我的页 · 暖纸社区视觉 ===== */
.hd--prof {
  position: relative;
  overflow: hidden;
  background: var(--brand-gradient);
  border-radius: 0 0 38rpx 38rpx;
  box-shadow: 0 18rpx 40rpx rgba(23, 58, 94, .18);
}
.hd--prof::after {
  content: '';
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  right: -100rpx;
  top: -130rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .08);
}
.pf-row { position: relative; z-index: 1; }
.pfa { box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .16); }
.pbadge { background: rgba(255, 255, 255, .15); border: 1rpx solid rgba(255, 255, 255, .18); }
.pstats { margin: 0 24rpx; border: 1rpx solid rgba(89, 74, 58, .08); border-radius: 26rpx; background: var(--card); box-shadow: var(--shadow-card); overflow: hidden; }
.pstats .c .n { color: var(--accent-warm); }
.k-blue,
.tone-blue { background: var(--brand-light); }
.tone-gold { background: var(--accent-warm-light); }
.tone-teal { background: var(--green-light); }
.pset .pr { border-bottom-color: var(--line); }
.pset .pr:last-child { border-bottom: 0; }
.pfoot { color: var(--text-3); }
