/* 健康服务（CR-027）· 全部取 Design Token v1.5 */
.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: var(--bg);
}

.top {
  padding: var(--space-4);
  background: var(--brand-gradient);
}
.top__t {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}
.top__s {
  margin-top: var(--space-1);
  font-size: var(--font-cap);
  color: rgba(255, 255, 255, 0.8);
}

.tabs {
  display: flex;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4) 0;
}
.tab {
  flex: 1;
  height: 64rpx;
  border-radius: var(--radius-m);
  background: var(--card);
  color: var(--text-2);
  font-size: var(--font-cap);
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab.is-on {
  background: var(--brand);
  color: #fff;
  font-weight: 700;
}

.note {
  padding: var(--space-2) var(--space-4) 0;
  font-size: 20rpx;
  color: var(--text-3);
}

.card {
  margin: var(--space-3) var(--space-4) 0;
  padding: var(--space-3);
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
}
.card__n {
  font-size: var(--font-sub);
  font-weight: 700;
  color: var(--text-1);
}
.card__tip {
  margin-top: var(--space-2);
  padding: var(--space-2);
  border-radius: var(--radius-s);
  background: var(--bg);
  font-size: 20rpx;
  color: var(--text-2);
  line-height: 1.6;
}

.kv {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-2);
  font-size: var(--font-cap);
  line-height: 1.6;
}
.kv__k {
  flex: none;
  width: 72rpx;
  color: var(--text-3);
}
.kv__v {
  flex: 1;
  min-width: 0;
  color: var(--text-1);
}

.step {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-2);
}
.step__i {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-full);
  background: var(--brand-light);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step__t {
  flex: 1;
  min-width: 0;
  font-size: var(--font-cap);
  color: var(--text-2);
  line-height: 1.6;
}

.btn {
  margin-top: var(--space-3);
  height: 76rpx;
  border-radius: var(--radius-m);
  background: var(--brand);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.foot {
  padding: var(--space-4);
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.7;
}
.foot__b {
  color: var(--error);
  font-weight: 700;
}

.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: var(--mask);
  z-index: var(--z-mask);
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 84vh;
  padding: var(--space-4) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom));
  background: var(--card);
  border-radius: var(--radius-l) var(--radius-l) 0 0;
  z-index: var(--z-modal);
  overflow-y: auto;
}
.sheet__hd {
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--text-1);
}
.sheet__lb {
  margin-top: var(--space-3);
  font-size: var(--font-sub);
  color: var(--text-2);
}
.sheet__tip {
  margin-top: var(--space-2);
  font-size: var(--font-cap);
  color: var(--text-3);
  line-height: 1.6;
}
.req { color: var(--error); font-size: 20rpx; }
.opt { color: var(--text-3); font-size: 20rpx; }
.inp {
  width: 100%;
  box-sizing: border-box;
  margin-top: var(--space-1);
  padding: var(--space-2) var(--space-3);
  background: var(--bg);
  border-radius: var(--radius-m);
  font-size: var(--font-sub);
  color: var(--text-1);
}
.ta {
  width: 100%;
  box-sizing: border-box;
  margin-top: var(--space-1);
  height: 140rpx;
  padding: var(--space-2) var(--space-3);
  background: var(--bg);
  border-radius: var(--radius-m);
  font-size: var(--font-sub);
  color: var(--text-1);
}
.sheet__btn {
  margin-top: var(--space-3);
  height: 84rpx;
  border-radius: var(--radius-m);
  background: var(--bg);
  color: var(--text-2);
  font-size: var(--font-body);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet__btn--main {
  background: var(--brand);
  color: #fff;
  font-weight: 700;
}
.sheet__ft {
  display: flex;
  gap: var(--space-2);
}
.sheet__ft .sheet__btn { flex: 1; }
.is-dis { opacity: 0.6; }
