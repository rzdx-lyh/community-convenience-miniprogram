<!-- 健康服务 · 疫苗 / 报告代取 / 慢病随访 / 年度体检（只做预约，不做诊断） -->
<view class="page">
  <view class="pgh pgh--teal" style="padding-top:{{statusBarHeight}}px">
    <view class="pgh-nav">
      <view class="pgh-bk" bindtap="goBack">‹</view>
      <text class="pgh-t">健康服务</text>
      <text class="pgh-rt">卫生服务站</text>
    </view>
    <view class="ph">
      <view class="pgh-ic"><view class="ic ic-l icw ic-syringe" /></view>
      <view class="ph__b">
        <view class="ph__t">健康服务</view>
        <view class="ph__s">预约登记 · 只做办事指引，不替代医生诊断</view>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="blk tabs-card">
      <view class="chips">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="chip {{tab === item.key ? 'on' : ''}}"
          data-t="{{item.key}}"
          bindtap="onSwitchTab"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="tip blue tip--row">
      <view class="ic ic-s ic-info" />
      <text>{{tabNote}}</text>
    </view>

    <!-- 年度体检 -->
    <block wx:if="{{isAnnual}}">
      <view class="grp">
        <view class="gh">
          <text class="gh__b">65 岁以上年度免费体检</text>
          <text class="gh__p">每年 1 次 · 社区统一组织</text>
        </view>
        <view class="grp__bd">
          <view wx:for="{{annual}}" wx:key="label" class="kv">
            <text class="kv__k">{{item.label}}</text>
            <text class="kv__v">{{item.value}}</text>
          </view>
          <view class="acts">
            <view class="btn" data-id="" bindtap="onBook">预约年度体检</view>
          </view>
        </view>
      </view>
    </block>

    <!-- 报告代取流程 -->
    <view wx:if="{{tab === 'report'}}" class="grp">
      <view class="gh">
        <text class="gh__b">代取流程</text>
        <text class="gh__p">行动不便可申请，隐私结果密封交付</text>
      </view>
      <view class="grp__bd">
        <view wx:for="{{steps}}" wx:key="step" class="step">
          <view class="step__n">{{item.step}}</view>
          <text class="step__t">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 事项列表 -->
    <view wx:for="{{items}}" wx:key="id" class="grp">
      <view class="gh">
        <text class="gh__b">{{item.name}}</text>
        <text class="gh__p">适用：{{item.target}}</text>
      </view>
      <view class="grp__bd">
        <view class="kv">
          <text class="kv__k">携带</text>
          <text class="kv__v">{{item.materials}}</text>
        </view>
        <view class="kv">
          <text class="kv__k">地点</text>
          <text class="kv__v">{{item.place}}</text>
        </view>
        <view class="kv">
          <text class="kv__k">时间</text>
          <text class="kv__v">{{item.time}}</text>
        </view>
        <view class="hint">
          <view class="ic ic-s ic-info" />
          <text>{{item.tips}}</text>
        </view>
        <view class="acts">
          <view class="btn3 solid" data-id="{{item.id}}" bindtap="onBook">
            {{tab === 'report' ? '提交代取申请' : '预约登记'}}
          </view>
        </view>
      </view>
    </view>

    <view class="tip">
      健康提示：本页只提供预约与办事指引，不构成诊断意见，也不能替代医生面诊；身体不适请及时到社区卫生服务站就诊，紧急情况拨打 120。
    </view>
    <view class="gap" />
  </view>

  <!-- 预约弹层 -->
  <view wx:if="{{showBook}}" class="mask show" bindtap="onCloseBook" />
  <view wx:if="{{showBook}}" class="sheet show">
    <view class="sh-h">预约登记</view>
    <view class="sh-sub">{{tabName}} · {{itemName}}</view>
    <view class="sh-body">
      <view class="lbl">期望时段 <text class="lbl__em">可选</text></view>
      <view class="chips">
        <view
          wx:for="{{slots}}"
          wx:key="*this"
          class="chip {{slot === item ? 'on' : ''}}"
          data-v="{{item}}"
          bindtap="onPickSlot"
        >{{item}}</view>
      </view>
      <view class="lbl">楼栋房号</view>
      <input class="inp" value="{{room}}" maxlength="20" placeholder="例：3 号楼 2 单元 502" bindinput="onInputRoom" />
      <view class="lbl">联系电话</view>
      <input class="inp" value="{{contact}}" type="number" maxlength="15" placeholder="工作人员电话确认用" bindinput="onInputContact" />
      <view class="lbl">备注 <text class="lbl__em">可选</text></view>
      <input class="inp" value="{{note}}" maxlength="50" placeholder="如：需要轮椅、第几针" bindinput="onInputNote" />
      <view class="sh-note">提交后由工作人员电话确认，不收取任何预付款。</view>
    </view>
    <view class="sh-btns">
      <view class="btn ghost" bindtap="onCloseBook">取消</view>
      <view class="btn" bindtap="onSubmit">{{submitting ? '提交中…' : '提交预约'}}</view>
    </view>
  </view>
</view>
