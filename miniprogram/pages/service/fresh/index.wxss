/* 生鲜零售 · 页面补充样式（商品卡沿用 .sk/.skc 原型类） */
.tip-row { display: flex; align-items: center; gap: 10rpx; }
.tip-row .ic { flex: none; }
.strong { font-weight: 800; }
.tb--top { margin-top: 10rpx; border-top: 1px solid var(--line); }
.tab-note { padding: 14rpx 28rpx 0; font-size: 18rpx; color: var(--t3); }

/* 商品卡徽标 / 价格 / 进度 */
.skc .hot { z-index: 2; }
.skc .pr-b { font-size: 28rpx; font-weight: 800; color: var(--red); font-family: ui-monospace, Menlo, monospace; }
.skc .pr-i { font-style: normal; font-size: 18rpx; color: var(--t3); }
.skc .prog { margin-top: 10rpx; }
.skc .prog .bar { margin-top: 6rpx; height: 6rpx; }
.bar-fill { display: block; height: 100%; border-radius: 4rpx; background: var(--teal); }
.prog-t { margin-top: 5rpx; font-size: 16rpx; color: var(--t3); line-height: 1.4; }
.sold { margin-top: 6rpx; font-size: 17rpx; color: var(--red); font-weight: 700; }

/* 数量控件（原型 .qty i 针对 i 标签，这里用 view 重写） */
.skc .qty .qty-i {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  border: 1px solid var(--blue);
  color: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
}
.skc .qty .qty-n { font-size: 22rpx; font-weight: 800; color: var(--blue); }
.skc .add { z-index: 2; }

.grid-note { padding: 10rpx 28rpx 30rpx; font-size: 18rpx; color: var(--t3); text-align: center; line-height: 1.6; }

/* 底部购物车 */
.footbar { left: 0; right: 0; z-index: 20; }
.fb-l { flex: 1; min-width: 0; }
.fb-c { font-size: 18rpx; color: var(--t3); }
.fb-t { font-size: 30rpx; font-weight: 800; color: var(--red); font-family: ui-monospace, Menlo, monospace; }
.fb-btn {
  width: 240rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: var(--blue);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fb-btn.is-dis { background: #DCE3EC; color: #9AA6B6; }

/* 预订弹层 */
.sheet { max-height: 84vh; overflow-y: auto; }
.sh-hd { font-size: 28rpx; font-weight: 800; text-align: center; }
.sh-sub { margin-top: 8rpx; font-size: 19rpx; color: var(--t3); text-align: center; }
.olist { margin-top: 18rpx; border-top: 1px solid #F1F4F9; }
.orow { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; border-bottom: 1px solid #F6F8FB; font-size: 22rpx; }
.on { flex: 1; min-width: 0; font-weight: 700; }
.os { margin-left: 8rpx; font-size: 17rpx; font-weight: 400; color: var(--t3); }
.oc { color: var(--t2); font-size: 20rpx; }
.oa { width: 120rpx; text-align: right; font-weight: 800; }
.ototal { display: flex; justify-content: space-between; align-items: baseline; padding: 18rpx 0 4rpx; font-size: 21rpx; color: var(--t2); }
.ot { font-size: 30rpx; font-weight: 800; color: var(--red); font-family: ui-monospace, Menlo, monospace; }
.lbl .em { margin-left: auto; font-size: 18rpx; font-weight: 400; color: var(--t3); font-style: normal; }
.pay-note { margin-top: 18rpx; padding: 14rpx 18rpx; background: var(--gold-l); border-radius: 14rpx; font-size: 18rpx; color: #8A5A00; line-height: 1.6; }
.sh-btns { display: flex; gap: 16rpx; margin-top: 22rpx; }
.sh-btns .btn { flex: 1; width: auto; height: 80rpx; font-size: 26rpx; }
