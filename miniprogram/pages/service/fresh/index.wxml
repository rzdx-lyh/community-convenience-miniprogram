<!-- 生鲜零售 · 提示条 → 频道 tab → 商品双列 → 购物车 → 预订 -->
<view class="page page--fbar">
  <view class="sbar dark" style="padding-top:{{statusBarHeight}}px">
    <text>邻里百事通小助手</text>
    <text>● ● ●</text>
  </view>
  <view class="nav">
    <text class="bk" bindtap="goBack">‹</text>
    生鲜零售
  </view>

  <view class="tip blue tip-row">
    <view class="ic ic-s ic-scooter"></view>
    <text>30 分钟配送到家 · 满 39 元免配送费 · <text class="strong">只做预订，不在此支付</text></text>
  </view>

  <view class="tb tb--top">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="t {{tab === item.key ? 'on' : ''}}"
      data-t="{{item.key}}"
      bindtap="onSwitchTab"
    >{{item.name}}</view>
  </view>

  <view class="tab-note">{{tabNote}}</view>

  <view class="sk">
    <view wx:for="{{items}}" wx:key="id" class="skc">
      <view wx:if="{{item.discount}}" class="hot">{{item.discount}}</view>
      <view wx:elif="{{item.isGroup}}" class="hot">拼单</view>
      <view class="im">{{item.emoji}}</view>
      <!-- ⚠ 类名必须是 pib：全局 .ib 是图标底座（80rpx 方块 flex），撞名会把信息块压成竖排小方块 -->
      <view class="pib">
        <view class="nm">{{item.name}}</view>
        <view class="ds">{{item.spec}}</view>
        <view class="pr">
          <text class="pr-b">¥{{item.price}}</text>
          <text class="pr-i">/份</text>
        </view>
        <view wx:if="{{item.isGroup}}" class="prog">
          <view class="bar"><view class="bar-fill" style="width:{{item.percent}}%"></view></view>
          <view class="prog-t">{{item.meta}}</view>
        </view>
        <view wx:if="{{item.soldOutText}}" class="sold">{{item.soldOutText}}</view>
      </view>

      <view wx:if="{{item.count > 0}}" class="qty">
        <view class="qty-i" data-t="{{tab}}" data-i="{{item.id}}" bindtap="onMinus">−</view>
        <text class="qty-n">{{item.count}}</text>
        <view class="qty-i" data-t="{{tab}}" data-i="{{item.id}}" bindtap="onPlus">+</view>
      </view>
      <view wx:else class="add" data-t="{{tab}}" data-i="{{item.id}}" bindtap="onPlus">+</view>
    </view>
  </view>

  <view class="grid-note">生鲜每日 6:00 到货，图片为示意；价格随行就市，以档口当日标价为准。</view>

  <ai-bar page="fresh" />

  <view class="footbar">
    <view class="fb-l">
      <view class="fb-c">已选 {{cartCount}} 件</view>
      <view class="fb-t">¥{{cartTotalText}}</view>
    </view>
    <view class="fb-btn {{cartCount ? '' : 'is-dis'}}" bindtap="onOpenOrder">提交预订</view>
  </view>

  <!-- 预订弹层 -->
  <view wx:if="{{showOrder}}" class="mask" bindtap="onCloseOrder">
    <view class="sheet show" catchtap="noop" catchtouchmove="noop">
      <view class="sh-hd">确认预订</view>
      <view class="sh-sub">{{tabName}} · 共 {{cartCount}} 件</view>
      <view class="olist">
        <view wx:for="{{cartLines}}" wx:key="key" class="orow">
          <view class="on">{{item.name}}<text class="os">{{item.spec}}</text></view>
          <view class="oc">× {{item.count}}</view>
          <view class="oa">¥{{item.lineTotal}}</view>
        </view>
      </view>
      <view class="ototal">参考合计<text class="ot">¥{{cartTotalText}}</text></view>
      <view class="lbl">楼栋房号<text class="em">必填</text></view>
      <input class="inp" placeholder="例：3 号楼 2 单元 502" maxlength="32" value="{{room}}" bindinput="onInputRoom" />
      <view class="lbl">联系电话<text class="em">必填</text></view>
      <input class="inp" type="number" placeholder="用于到货通知" maxlength="15" value="{{contact}}" bindinput="onInputContact" />
      <view class="lbl">备注<text class="em">选填</text></view>
      <textarea class="ta" placeholder="例如：放门口，不用敲门" maxlength="120" value="{{note}}" bindinput="onInputNote" />
      <view class="pay-note">本页不收款。预订成功后到驿站自提时现场结算，未取自动取消。</view>
      <view class="sh-btns">
        <view class="btn ghost" bindtap="onCloseOrder">再看看</view>
        <view class="btn" bindtap="onSubmit">{{submitting ? '提交中…' : '确认预订'}}</view>
      </view>
    </view>
  </view>
</view>
