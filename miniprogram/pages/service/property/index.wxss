/* 物业延伸（CR-027）· 全部取 Design Token v1.5 */
.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: var(--bg);
}

.top { padding: var(--space-4); background: var(--brand-gradient); }
.top__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}
.top__home {
  flex: none;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}
.top__home:active { opacity: 0.82; }
.top__t { font-size: 36rpx; font-weight: 800; color: #fff; }
.top__s {
  margin-top: var(--space-1);
  font-size: var(--font-cap);
  color: rgba(255, 255, 255, 0.8);
}

.tabs {
  display: flex;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4) 0;
}
.tab {
  flex: 1;
  height: 64rpx;
  border-radius: var(--radius-m);
  background: var(--card);
  color: var(--text-2);
  font-size: var(--font-cap);
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab.is-on { background: var(--brand); color: #fff; font-weight: 700; }
.tabs--s { padding: var(--space-3) 0 0; }
.tabs--s .tab { height: 60rpx; font-size: var(--font-cap); }

.note {
  padding: var(--space-2) var(--space-4) 0;
  font-size: 20rpx;
  color: var(--text-3);
}

.sec {
  margin: var(--space-3) var(--space-4) 0;
  padding: var(--space-3);
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
}
.sec__hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.sec__t { font-size: var(--font-body); font-weight: 700; color: var(--text-1); }
.sec__s { font-size: var(--font-cap); color: var(--text-3); }

.spot { padding: var(--space-2) 0; border-bottom: 2rpx solid var(--line); }
.spot__n { font-size: var(--font-sub); font-weight: 600; color: var(--text-1); }
.spot__a { margin-top: 4rpx; font-size: var(--font-cap); color: var(--text-2); }
.spot__h { margin-top: 4rpx; font-size: 20rpx; color: var(--text-3); }

.rule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-1) 0;
  font-size: var(--font-cap);
}
.rule__l { color: var(--text-2); }
.rule__v { color: var(--text-1); }

.cv { padding: var(--space-2) 0; border-bottom: 2rpx solid var(--line); }
.cv__t { font-size: var(--font-sub); font-weight: 600; color: var(--text-1); }
.cv__d {
  margin-top: 4rpx;
  font-size: var(--font-cap);
  color: var(--text-2);
  line-height: 1.6;
}

.ls { padding: var(--space-3) 0; border-bottom: 2rpx solid var(--line); }
.ls__hd { display: flex; align-items: center; justify-content: space-between; }
.ls__n { font-size: var(--font-sub); font-weight: 700; color: var(--text-1); }
.ls__tag {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-s);
  font-size: 20rpx;
  color: #fff;
  background: var(--text-3);
}
.ls__tag--rent { background: var(--brand); }
.ls__tag--sale { background: var(--accent-warm); }
.ls__m { margin-top: 4rpx; font-size: var(--font-cap); color: var(--text-2); }
.ls__p { margin-top: 4rpx; font-size: 30rpx; font-weight: 800; color: var(--error); }
.ls__f { display: flex; align-items: center; gap: var(--space-2); margin-top: 6rpx; }
.ls__o { font-size: 20rpx; color: var(--text-3); }
.ls__v { font-size: 20rpx; color: var(--text-3); }
.ls__v.is-on { color: var(--green); }
.ls__d { margin-top: 6rpx; font-size: 20rpx; color: var(--text-2); }
.ls__btn {
  margin-top: var(--space-2);
  height: 64rpx;
  border-radius: var(--radius-m);
  background: var(--brand-light);
  color: var(--brand);
  font-size: var(--font-cap);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn {
  margin-top: var(--space-3);
  height: 76rpx;
  border-radius: var(--radius-m);
  background: var(--brand);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.acts { display: flex; gap: var(--space-2); }
.acts .btn { flex: 1; }
.btn--ghost { background: var(--brand-light); color: var(--brand); }

.foot {
  padding: var(--space-4);
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.7;
}
.foot__b { color: var(--error); font-weight: 700; }

.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: var(--mask);
  z-index: var(--z-mask);
}
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  max-height: 84vh;
  padding: var(--space-4) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom));
  background: var(--card);
  border-radius: var(--radius-l) var(--radius-l) 0 0;
  z-index: var(--z-modal);
  overflow-y: auto;
}
.sheet__hd { font-size: var(--font-card); font-weight: 700; color: var(--text-1); }
.sheet__lb { margin-top: var(--space-3); font-size: var(--font-sub); color: var(--text-2); }
.sheet__tip {
  margin-top: var(--space-2);
  font-size: var(--font-cap);
  color: var(--text-3);
  line-height: 1.6;
}
.req { color: var(--error); font-size: 20rpx; }
.opt { color: var(--text-3); font-size: 20rpx; }
.pk {
  margin-top: var(--space-1);
  padding: var(--space-2) var(--space-3);
  background: var(--bg);
  border-radius: var(--radius-m);
  font-size: var(--font-sub);
  color: var(--text-1);
}
.inp {
  width: 100%;
  box-sizing: border-box;
  margin-top: var(--space-1);
  padding: var(--space-2) var(--space-3);
  background: var(--bg);
  border-radius: var(--radius-m);
  font-size: var(--font-sub);
  color: var(--text-1);
}
.ta {
  width: 100%;
  box-sizing: border-box;
  margin-top: var(--space-1);
  height: 140rpx;
  padding: var(--space-2) var(--space-3);
  background: var(--bg);
  border-radius: var(--radius-m);
  font-size: var(--font-sub);
  color: var(--text-1);
}
.row2 { display: flex; gap: var(--space-2); }
.row2__i { flex: 1; min-width: 0; }
.sheet__btn {
  margin-top: var(--space-3);
  height: 84rpx;
  border-radius: var(--radius-m);
  background: var(--bg);
  color: var(--text-2);
  font-size: var(--font-body);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet__btn--main { background: var(--brand); color: #fff; font-weight: 700; }
.sheet__ft { display: flex; gap: var(--space-2); }
.sheet__ft .sheet__btn { flex: 1; }
.is-dis { opacity: 0.6; }
