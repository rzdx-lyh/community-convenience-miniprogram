/* 健康档案（CR-028）· 补充投影色与 text 节点排版 */
.pgh--teal { --h1: #0E8F9E; --h2: #0A5A66; }
.pgh-main { flex: none; }
.pgh-side { flex: 1; min-width: 0; padding-bottom: 4rpx; padding-right: 140rpx; }
.pgh-num .num-u { font-size: 24rpx; font-weight: 600; opacity: 0.8; margin-left: 6rpx; }

.dash .dh-b { font-size: 25rpx; font-weight: 800; }
.dash .dh-e { font-size: 18rpx; color: var(--t3); margin-left: auto; }

/* 趋势条（原型用 SVG，小程序改条形） */
.trd { display: flex; align-items: flex-end; gap: 12rpx; height: 120rpx; padding: 12rpx 4rpx 0; }
.trd-i { flex: 1; height: 100%; display: flex; align-items: flex-end; }
.trd-b { width: 100%; min-height: 8rpx; border-radius: 8rpx 8rpx 0 0; background: #BFE3DC; }
.trd-b.on { background: #0E8F9E; }
.trd-empty { padding: 26rpx 0 6rpx; font-size: 20rpx; color: var(--t3); text-align: center; }

.met .met-n { display: block; font-size: 30rpx; font-weight: 800; letter-spacing: -0.6rpx; }
.met .met-l { display: block; font-size: 17rpx; color: var(--t3); margin-top: 4rpx; }
.met .met-tag {
  display: inline-block;
  font-size: 15rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-top: 8rpx;
}
.tag-ok { background: #E6F5F2; color: #0E7C6B; }
.tag-warn { background: #FDF3E1; color: #A86A05; }
.tag-hi { background: #FDECEC; color: #C9302C; }
.tag-mute { background: #F1F4F9; color: var(--t3); }

/* 录入 */
.kchips { margin-top: 14rpx; }
.frow { display: flex; gap: 16rpx; margin-top: 16rpx; }
.fitem { flex: 1; min-width: 0; margin-top: 16rpx; }
.frow .fitem { margin-top: 0; }
.flb { display: block; font-size: 20rpx; color: var(--t2); margin-bottom: 10rpx; }
.fnote { font-size: 18rpx; color: var(--t3); margin-top: 10rpx; line-height: 1.55; }
.ph { color: #A8B3C4; }
.acts { display: flex; gap: 14rpx; margin-top: 20rpx; }

.pv { margin-top: 18rpx; border-radius: 16rpx; padding: 18rpx 20rpx; background: var(--blue-l); }
.pv-watch { background: var(--gold-l); }
.pv-high { background: #FDECEC; }
.pv-h { font-size: 22rpx; font-weight: 800; color: var(--t1); }
.pv-b { font-size: 19rpx; color: var(--t2); line-height: 1.65; margin-top: 6rpx; }

/* 记录 */
.tl { margin-top: 6rpx; }
.tl-a { font-size: 18rpx; color: var(--t2); line-height: 1.55; margin-top: 6rpx; }
.hint { font-size: 17rpx; color: var(--t3); text-align: center; margin-top: 8rpx; }
.empty { padding: 30rpx 0; }

/* 入口行 */
.ai-si { background: #EDEAFE; color: #4B45B8; }
.doc-si { background: #E6F5F2; color: #0E7C6B; }
.sa-t { font-size: 21rpx; color: var(--blue); font-weight: 800; }
.redline {
  margin: 6rpx 28rpx 20rpx;
  font-size: 18rpx;
  color: var(--t3);
  line-height: 1.65;
  text-align: center;
}

/* 签约弹层 */
.sht-h { font-size: 28rpx; font-weight: 800; text-align: center; margin-bottom: 12rpx; }
.sht-tip { font-size: 19rpx; color: var(--t3); line-height: 1.6; margin-bottom: 14rpx; }
.slb { font-size: 21rpx; font-weight: 700; margin: 16rpx 0 10rpx; }
.req { color: var(--red); font-size: 17rpx; font-weight: 400; }
.opt-t { color: var(--t3); font-size: 17rpx; font-weight: 400; }
.sht-ft { display: flex; gap: 16rpx; margin-top: 22rpx; }
.sht-btn2 {
  flex: 1;
  height: 80rpx;
  border-radius: 18rpx;
  background: #F2F5FA;
  color: var(--t2);
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sht-main { background: var(--blue); color: #fff; font-weight: 800; }
