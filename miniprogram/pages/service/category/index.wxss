/* 服务分类页（FE-14 · CR-022）· 一律使用 Design Token，禁止硬编码色值 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 分类 Tab */
.cats {
  display: flex;
  white-space: nowrap;
  background: var(--card);
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 2rpx solid var(--line);
  box-sizing: border-box;
}

.cat {
  display: inline-block;
  flex: none;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 26rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: var(--font-sub, 28rpx);
}

.cat.on {
  background: var(--brand);
  color: #ffffff;
  font-weight: 600;
}

/* 页头 */
.hd {
  padding: 28rpx 24rpx 8rpx;
}

.hd-t {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.4;
}

.hd-s {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.5;
}

/* 板块 */
.grp {
  margin-top: 20rpx;
}

.gh {
  padding: 0 24rpx 12rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.gh-n {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}

.gh-n::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: var(--brand);
  margin-right: 12rpx;
  vertical-align: -3rpx;
}

.gh-note {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 两列服务卡 */
.g2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
}

.gi {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 108rpx;
  padding: 18rpx 16rpx;
  box-sizing: border-box;
  background: var(--card);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(43, 43, 43, 0.06);
}

.gi:active {
  background: var(--brand-light);
}

.gi-ic {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gi-b {
  flex: 1;
  min-width: 0;
}

.gi-n {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gi-d {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gi-ar {
  flex: none;
  color: var(--text-3);
  font-size: 30rpx;
}

.foot {
  margin: 32rpx 24rpx 0;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--brand-light);
  color: var(--brand-press);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

/* ===== 预约弹层 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--mask);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.22s ease;
  max-height: 86vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.sheet.show {
  transform: translateY(0);
}

.sh-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sh-t {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
}

.sh-x {
  font-size: 26rpx;
  color: var(--text-3);
  padding: 8rpx 12rpx;
}

.sh-lb {
  margin: 24rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

.req {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--urgent);
}

.opt {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--line);
  background: var(--card);
  color: var(--text-2);
  font-size: 26rpx;
}

.chip.on {
  border-color: var(--brand);
  background: var(--brand-light);
  color: var(--brand-press);
  font-weight: 600;
}

.inp {
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--line);
  background: #fbfaf8;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

.ta {
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--line);
  background: #fbfaf8;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
  line-height: 1.6;
}

.sh-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}

.sh-ft {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn.ghost {
  background: #f2efea;
  color: var(--text-2);
}

.btn.main {
  background: var(--brand);
  color: #ffffff;
}

.btn.main:active {
  background: var(--brand-press);
}

.btn.dis {
  opacity: 0.6;
  pointer-events: none;
}
