<!-- 缴费账单（CR-026）· 待缴合计 → 户号绑定 → 账单列表 → 水费试算 → 缴费引导 -->
<view class="page">
  <!-- 待缴合计 -->
  <view class="top">
    <view class="top__t">本期待缴合计</view>
    <view class="top__n">¥ {{unpaid}}</view>
    <view class="top__s">{{demoHintText}} · 共 {{bills.length}} 笔</view>
    <view class="top__btn" bindtap="onPayGuide">去微信「生活缴费」缴纳</view>
  </view>

  <!-- 户号绑定 -->
  <view class="sec">
    <view class="sec__hd">
      <text class="sec__t">户号绑定</text>
      <text class="sec__s">绑定后可查欠费与账单</text>
    </view>
    <view
      wx:for="{{accounts}}"
      wx:key="key"
      class="acc {{item.bound ? 'acc--on' : ''}}"
      data-k="{{item.key}}"
      bindtap="onBind"
    >
      <view class="acc__l">
        <view class="acc__n">{{item.name}}</view>
        <view class="acc__m">{{item.masked}}</view>
      </view>
      <view class="acc__r">{{item.bound ? '重新绑定' : '去绑定'}}</view>
    </view>
  </view>

  <!-- 账单列表 -->
  <view class="sec">
    <view class="sec__hd">
      <text class="sec__t">账单明细</text>
    </view>
    <view wx:for="{{bills}}" wx:key="id" class="bill">
      <view class="bill__l">
        <view class="bill__tag" style="background:{{item.color}}">{{item.name}}</view>
        <view class="bill__p">{{item.period}}</view>
      </view>
      <view class="bill__m">{{item.usage}} {{item.unit}}</view>
      <view class="bill__r">
        <text class="bill__a">¥ {{item.amount}}</text>
        <text class="bill__s {{item.paid ? 'is-paid' : ''}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <!-- 水费试算 -->
  <view class="sec">
    <view class="sec__hd">
      <text class="sec__t">水费试算</text>
      <text class="sec__s">阶梯价 + 污水处理费 1.1 元/吨</text>
    </view>
    <input
      class="inp"
      type="digit"
      value="{{usage}}"
      placeholder="输入本月用水量（吨）"
      placeholder-class="inp__ph"
      bindinput="onUsageInput"
    />
    <block wx:if="{{calc}}">
      <view wx:for="{{calc.tiers}}" wx:key="label" class="tier">
        <text class="tier__l">{{item.label}}</text>
        <text class="tier__m">{{item.usage}} 吨 × {{item.price}}</text>
        <text class="tier__a">¥ {{item.amount}}</text>
      </view>
      <view class="tier">
        <text class="tier__l">污水处理费</text>
        <text class="tier__m">{{calc.usage}} 吨 × 1.1</text>
        <text class="tier__a">¥ {{calc.sewage}}</text>
      </view>
      <view class="tier tier--sum">
        <text class="tier__l">合计</text>
        <text class="tier__a">¥ {{calc.total}}</text>
      </view>
    </block>
  </view>

  <view class="foot">
    本页仅做账单查询与户号登记，<text class="foot__b">不收款、不代扣</text>；
    金额以官方账单为准，实际缴纳请在微信「生活缴费」完成。
  </view>

  <!-- CR-024：页面级 AI 入口（上下文 = 缴费账单） -->
  <ai-bar page="bill" />

  <!-- 户号绑定弹层 -->
  <view wx:if="{{showBind}}" class="mask" bindtap="onCloseBind">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">户号绑定 · {{bindKindName}}</view>
      <view class="sheet__tip">{{bindHint}}</view>
      <view class="sheet__lb">户号 <text class="req">必填</text></view>
      <input class="inp" placeholder="按上方提示填写户号" maxlength="24" value="{{bindAccount}}" bindinput="onInputAccount" />
      <view class="sheet__lb">楼栋房号 <text class="req">必填</text></view>
      <input class="inp" placeholder="例：3 号楼 2 单元 502" maxlength="24" value="{{bindRoom}}" bindinput="onInputRoom" />
      <view class="sheet__lb">备注 <text class="opt">选填</text></view>
      <textarea class="ta" placeholder="例如：户名是家人的名字" maxlength="120" value="{{bindNote}}" bindinput="onInputNote" />
      <view class="sheet__tip">提交后由工作人员核对户名与房号，一致即可生效；本页不收款。</view>
      <view class="sheet__ft">
        <view class="sheet__btn" bindtap="onCloseBind">取消</view>
        <view class="sheet__btn sheet__btn--main {{submitting ? 'is-dis' : ''}}" bindtap="onSubmitBind">{{submitting ? '提交中…' : '提交登记'}}</view>
      </view>
    </view>
  </view>
</view>
