/* 缴费代办 · 页面补充样式（原型类之外只补这些） */
.pgh--gold { --h1: #F2A93B; --h2: #A85A08; }
.pgh-num .cur { font-size: 28rpx; font-weight: 700; opacity: .92; margin-right: 4rpx; }
.tint-teal { background: #E6F5F2; color: #0E7C6B; }
.tint-gold { background: #FDF3E1; color: #A86A05; }
.tint-blue { background: #EAF1FE; color: #1F5FD6; }
.hover-dim { opacity: .86; }

.sc .sa .b {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.6rpx;
}
.sc .sa .sa-s { display: block; margin-top: 1rpx; font-size: 17rpx; color: var(--t3); }
.bar .bar-fill { display: block; height: 100%; border-radius: 4rpx; }
.dh-b { font-size: 25rpx; font-weight: 800; }
.dh-em { margin-left: auto; font-size: 18rpx; color: var(--t3); font-style: normal; }

/* 水费试算 */
.calc-inp { margin-top: 16rpx; height: 72rpx; }
.calc-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  font-size: 21rpx;
  color: var(--t2);
  border-bottom: 1px solid #F3F6FA;
}
.calc-l { flex: 1; min-width: 0; }
.calc-m { color: var(--t3); font-size: 19rpx; }
.calc-a { font-weight: 700; color: var(--t1); }
.calc-row--sum { border-bottom: 0; font-weight: 800; color: var(--t1); }
.calc-row--sum .calc-a { color: var(--red); font-size: 26rpx; }
.calc-ph { margin-top: 12rpx; font-size: 18rpx; color: var(--t3); line-height: 1.6; }

.page-note {
  margin: 12rpx 28rpx 40rpx;
  font-size: 18rpx;
  color: var(--t3);
  line-height: 1.65;
  text-align: center;
}

/* 弹层 */
.sheet { max-height: 82vh; overflow-y: auto; }
.sh-hd { font-size: 28rpx; font-weight: 800; text-align: center; }
.sh-sub { margin-top: 8rpx; font-size: 19rpx; color: var(--t3); text-align: center; }
.lbl .em { margin-left: auto; font-size: 18rpx; font-weight: 400; color: var(--t3); font-style: normal; }
.sh-btns { display: flex; gap: 16rpx; margin-top: 26rpx; }
.sh-btns .btn { flex: 1; width: auto; height: 80rpx; font-size: 26rpx; }
.help-list { margin-top: 20rpx; font-size: 21rpx; color: var(--t2); line-height: 1.9; }
