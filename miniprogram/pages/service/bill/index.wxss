/* 缴费账单（CR-026）· 全部取 Design Token v1.5 */
.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: var(--bg);
}

/* 待缴合计 */
.top {
  padding: var(--space-4);
  background: var(--brand-gradient);
}
.top__t {
  font-size: var(--font-cap);
  color: rgba(255, 255, 255, 0.8);
}
.top__n {
  margin-top: var(--space-1);
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
}
.top__s {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
}
.top__btn {
  margin-top: var(--space-3);
  height: 76rpx;
  border-radius: var(--radius-full);
  background: #fff;
  color: var(--brand);
  font-size: var(--font-sub);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 区块 */
.sec {
  margin: var(--space-3) var(--space-4) 0;
  padding: var(--space-3);
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
}
.sec__hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.sec__t {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--text-1);
}
.sec__s {
  font-size: var(--font-cap);
  color: var(--text-3);
}

/* 户号 */
.acc {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) 0;
  margin-top: var(--space-1);
  border-bottom: 2rpx solid var(--line);
}
.acc__n {
  font-size: var(--font-sub);
  color: var(--text-1);
  font-weight: 600;
}
.acc__m {
  margin-top: 2rpx;
  font-size: var(--font-cap);
  color: var(--text-3);
}
.acc--on .acc__m {
  color: var(--green);
}
.acc__r {
  font-size: var(--font-cap);
  color: var(--brand);
}

/* 账单行 */
.bill {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-bottom: 2rpx solid var(--line);
}
.bill__l {
  width: 180rpx;
  flex: none;
}
.bill__tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-s);
  color: #fff;
  font-size: 20rpx;
}
.bill__p {
  margin-top: 4rpx;
  font-size: var(--font-cap);
  color: var(--text-3);
}
.bill__m {
  flex: 1;
  font-size: var(--font-cap);
  color: var(--text-2);
}
.bill__r {
  text-align: right;
}
.bill__a {
  font-size: var(--font-sub);
  font-weight: 700;
  color: var(--text-1);
}
.bill__s {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--error);
}
.bill__s.is-paid {
  color: var(--text-3);
}

/* 试算 */
.inp {
  width: 100%;
  box-sizing: border-box;
  margin-top: var(--space-2);
  padding: var(--space-2) var(--space-3);
  background: var(--bg);
  border-radius: var(--radius-m);
  font-size: var(--font-sub);
  color: var(--text-1);
}
.inp__ph {
  color: var(--text-3);
}
.tier {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-1) 0;
  font-size: var(--font-cap);
}
.tier__l {
  width: 260rpx;
  color: var(--text-2);
}
.tier__m {
  flex: 1;
  color: var(--text-3);
}
.tier__a {
  color: var(--text-1);
  font-weight: 600;
}
.tier--sum {
  margin-top: var(--space-1);
  padding-top: var(--space-2);
  border-top: 2rpx solid var(--line);
}
.tier--sum .tier__a {
  font-size: var(--font-body);
  font-weight: 800;
  color: var(--brand);
}

.foot {
  padding: var(--space-4);
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.7;
  text-align: center;
}
.foot__b {
  color: var(--error);
  font-weight: 700;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--mask);
  z-index: var(--z-mask);
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 84vh;
  padding: var(--space-4) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom));
  background: var(--card);
  border-radius: var(--radius-l) var(--radius-l) 0 0;
  z-index: var(--z-modal);
  overflow-y: auto;
}
.sheet__hd {
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--text-1);
}
.sheet__lb {
  margin-top: var(--space-3);
  font-size: var(--font-sub);
  color: var(--text-2);
}
.sheet__tip {
  margin-top: var(--space-2);
  font-size: var(--font-cap);
  color: var(--text-3);
  line-height: 1.6;
}
.req {
  color: var(--error);
  font-size: 20rpx;
}
.opt {
  color: var(--text-3);
  font-size: 20rpx;
}
.ta {
  width: 100%;
  box-sizing: border-box;
  margin-top: var(--space-1);
  height: 140rpx;
  padding: var(--space-2) var(--space-3);
  background: var(--bg);
  border-radius: var(--radius-m);
  font-size: var(--font-sub);
  color: var(--text-1);
}
.sheet__btn {
  margin-top: var(--space-3);
  height: 84rpx;
  border-radius: var(--radius-m);
  background: var(--bg);
  color: var(--text-2);
  font-size: var(--font-body);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet__btn--main {
  background: var(--brand);
  color: #fff;
  font-weight: 700;
}
.sheet__ft {
  display: flex;
  gap: var(--space-2);
}
.sheet__ft .sheet__btn {
  flex: 1;
}
.is-dis {
  opacity: 0.6;
}
