/* 通用预约（CR-028）· 仅补充原型没有的投影色与文本节点样式 */
.pgh--blue { --h1: #2E6BE0; --h2: #153F9B; }
.pgh-km { flex: 1; min-width: 0; padding-right: 150rpx; }
.pgh-svc { font-size: 36rpx; font-weight: 800; line-height: 1.28; }

/* 步骤条在蓝头内（对齐原型 pgBook，2026-10-22 从 .body 移入 .pgh）：
   蓝底上把非当前步的灰色文字提亮一档，保证可读 */
.stp--in-pgh { margin: 44rpx 24rpx 0; position: relative; z-index: 2; }
.stp--in-pgh .tx { color: rgba(255, 255, 255, 0.75); }
.stp--in-pgh .s.on .tx { color: #fff; }
.stp--in-pgh .ln { background: rgba(255, 255, 255, 0.28); }

/* body 不做全局 -72rpx 上拉：本页首个内容是表单标签（非卡片），
   上拉会把「要办哪项」骑到蓝白交界上（2026-10-22 真机截图实锤） */
.body { margin-top: 4rpx; }

/* 原型用 b/span/h4/p 承载的文案，小程序统一换成 text，这里补齐排版 */
.lblw { padding: 0 28rpx; }
.lbl { margin: 24rpx 0 14rpx; }
.lbl-em { font-size: 19rpx; font-weight: 400; color: var(--t3); }
.opt-t { display: block; font-size: 25rpx; font-weight: 800; padding-right: 32rpx; }
.opt-d { display: block; font-size: 18rpx; color: var(--t3); margin-top: 6rpx; }
.dchip .dc-t { display: block; font-size: 23rpx; font-weight: 800; }
.dchip .dc-s { display: block; font-size: 17rpx; color: var(--t3); margin-top: 4rpx; }
.ts .ts-t { display: block; font-size: 24rpx; font-weight: 700; }
.ts .ts-s { display: block; font-size: 18rpx; color: var(--t3); margin-top: 4rpx; }
.ts.on .ts-t { color: var(--blue); }
.rcpt .rc-t { display: block; margin-top: 20rpx; font-size: 30rpx; font-weight: 800; }
.rcpt .rc-p { display: block; margin-top: 14rpx; font-size: 20rpx; color: var(--t3); line-height: 1.6; }
.dash .dh-b { font-size: 25rpx; font-weight: 800; }
.dash .dh-e { font-size: 18rpx; color: var(--t3); margin-left: auto; }
.dash .tk-r { padding: 6rpx 0; }
.pgpad { padding: 12rpx 24rpx 32rpx; }
.pgtail { height: 20rpx; }
.pad12 { padding: 0 24rpx; }
.chipsw { padding: 0 24rpx; }
.ph { color: #A8B3C4; }

/* 底部固定条：修 layout.wxss 里 position:fixed 的生成器偏差 */
.fbar { left: 0; right: 0; }
.fbar .sum { position: static; flex: 1; min-width: 0; }
.fbar .sum-b { display: block; font-size: 25rpx; color: var(--t1); font-weight: 800; }
.fbar .sum-s { display: block; font-size: 18rpx; color: var(--t3); margin-top: 2rpx; }
.fbar .btn2 {
  position: static;
  background: var(--blue);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  padding: 0 40rpx;
}
.fbar .btn2.is-dis { background: #DCE3EC; color: #9AA6B6; box-shadow: none; }

/* 服务说明弹层：避开 .sheet 内 position:fixed 的原型偏差 */
.sht-h { font-size: 28rpx; font-weight: 800; text-align: center; margin-bottom: 18rpx; }
.sht-b { font-size: 21rpx; color: var(--t2); line-height: 1.75; }
.sht-warn {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--gold-l);
  color: #8A5A00;
  font-size: 19rpx;
}
.sht-btn {
  margin-top: 22rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: #F2F5FA;
  color: var(--t2);
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
