/* 共享设备 · 页面补充样式（原型类之外只补这些） */
.pgh--teal { --h1: #12A08A; --h2: #0A6153; }
.pgh-num .unit { margin-left: 6rpx; font-size: 24rpx; font-weight: 600; opacity: .8; }
.tint-teal { background: #E6F5F2; color: #0E7C6B; }
.tint-gold { background: #FDF3E1; color: #A86A05; }
.tint-blue { background: #EAF1FE; color: #1F5FD6; }
.tint-indigo { background: #EDECFB; color: #4B45B8; }
.hover-dim { opacity: .86; }

/* 借用状态卡 */
.dev {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: var(--sh);
  padding: 34rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.dev-ring {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  position: relative;
  background: conic-gradient(#12A08A 0 100%);
}
.dev-ring.is-on { background: conic-gradient(#12A08A 0 62%, #EDF1F7 62% 100%); }
.dev-ring::after {
  content: '';
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
  border-radius: 50%;
  background: #fff;
}
.rc {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.rc-b { font-size: 28rpx; font-weight: 800; letter-spacing: -0.4rpx; color: var(--t1); }
.rc-s { margin-top: 8rpx; font-size: 16rpx; color: var(--t3); }
.dn { margin-top: 20rpx; font-size: 30rpx; font-weight: 800; }
.ds { margin-top: 6rpx; font-size: 19rpx; color: var(--t3); line-height: 1.5; }
.dev-btns { display: flex; gap: 16rpx; margin-top: 24rpx; width: 100%; }
.dev-remind { display: flex; align-items: center; gap: 8rpx; margin-top: 16rpx; font-size: 18rpx; color: var(--t3); }

/* 列表小标题 / 设备卡 */
.st .st-b { font-size: 28rpx; font-weight: 800; flex: 1; }
.st .st-e { font-size: 19rpx; color: var(--t3); }
.sc .sa .stock { font-size: 30rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.sc .sa .stock-u { margin-left: 2rpx; font-size: 17rpx; font-weight: 400; color: var(--t3); }
.dh-b { font-size: 25rpx; font-weight: 800; }
.dh-em { margin-left: auto; font-size: 18rpx; color: var(--t3); font-style: normal; }

/* 借还记录 */
.rec { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; border-bottom: 1px solid #F1F4F9; }
.rec:last-child { border-bottom: 0; }
.rec-l { flex: 1; min-width: 0; }
.rec-n { display: flex; align-items: center; gap: 10rpx; font-size: 23rpx; font-weight: 700; }
.rec-s { margin-top: 4rpx; font-size: 18rpx; color: var(--t3); }
.rec-btn { flex: none; width: 132rpx; height: 56rpx; font-size: 20rpx; }
.notice-list { font-size: 20rpx; color: var(--t2); line-height: 1.85; }

.page-note { margin: 12rpx 28rpx 40rpx; font-size: 18rpx; color: var(--t3); line-height: 1.65; text-align: center; }

/* 弹层 */
.sheet { max-height: 84vh; overflow-y: auto; }
.sh-hd { font-size: 28rpx; font-weight: 800; text-align: center; }
.sh-sub { margin-top: 8rpx; font-size: 19rpx; color: var(--t3); text-align: center; }
.lbl .em { margin-left: auto; font-size: 18rpx; font-weight: 400; color: var(--t3); font-style: normal; }
.due-preview { margin-top: 10rpx; font-size: 18rpx; color: var(--teal); }
.pay-note { margin-top: 18rpx; padding: 14rpx 18rpx; background: var(--teal-l); border-radius: 14rpx; font-size: 18rpx; color: var(--teal); line-height: 1.6; }
.sh-btns { display: flex; gap: 16rpx; margin-top: 22rpx; }
.sh-btns .btn { flex: 1; width: auto; height: 80rpx; font-size: 26rpx; }
.spot-list { margin-top: 12rpx; }
.spot-list .rb { font-size: 24rpx; font-weight: 700; }
.spot-list .rs { margin-top: 3rpx; font-size: 18rpx; color: var(--t3); line-height: 1.4; }
