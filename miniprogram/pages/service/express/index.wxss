/* 快递代取 · 页面补充样式（券/规则/弹层沿用原型类） */
.pgh--teal { --h1: #12A08A; --h2: #0A6153; }
.pgh-num .unit { margin-left: 6rpx; font-size: 24rpx; font-weight: 600; opacity: .8; }
.tint-teal { background: #E6F5F2; color: #0E7C6B; }
.tk-tag { margin-left: auto; }
.dh-b { font-size: 25rpx; font-weight: 800; }
.dh-em { margin-left: auto; font-size: 18rpx; color: var(--t3); font-style: normal; }
.notice-list { font-size: 20rpx; color: var(--t2); line-height: 1.85; }

/* 服务费规则 */
.rule-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1px solid #F6F8FB;
  font-size: 21rpx;
}
.rule-row:last-child { border-bottom: 0; }
.rule-l { flex: 1; min-width: 0; color: var(--t2); }
.rule-v { font-weight: 700; color: var(--t1); text-align: right; }
.rule-note { margin-top: 10rpx; font-size: 18rpx; color: var(--teal); line-height: 1.6; }

/* 我的申请 */
.st .st-b { font-size: 28rpx; font-weight: 800; flex: 1; }
.st .st-e { font-size: 19rpx; color: var(--t3); }
.ord {
  margin: 0 24rpx 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: var(--sh);
  padding: 22rpx 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}
.ord-l { flex: 1; min-width: 0; }
.ord-n { font-size: 24rpx; font-weight: 800; }
.ord-s { margin-top: 5rpx; font-size: 18rpx; color: var(--t3); line-height: 1.45; }
.ord-r { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 14rpx; }
.ord-x { font-size: 20rpx; color: var(--red); padding: 4rpx 0; }

.page-note { margin: 12rpx 28rpx 40rpx; font-size: 18rpx; color: var(--t3); line-height: 1.65; text-align: center; }

/* 底部条 */
.fbar { left: 0; right: 0; z-index: 20; }
.fbar-sum { flex: 1; min-width: 0; }
.fbar-t { font-size: 22rpx; font-weight: 800; color: var(--t1); }
.fbar-s { margin-top: 2rpx; font-size: 17rpx; color: var(--t3); }
.fbar-btn {
  width: 210rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: var(--teal);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

/* 弹层 */
.sheet { max-height: 86vh; overflow-y: auto; }
.sh-hd { font-size: 28rpx; font-weight: 800; text-align: center; }
.sh-sub { margin-top: 8rpx; font-size: 19rpx; color: var(--t3); text-align: center; }
.lbl .em { margin-left: auto; font-size: 18rpx; font-weight: 400; color: var(--t3); font-style: normal; }
.size-hint { margin-top: 10rpx; font-size: 18rpx; color: var(--teal); }
.pay-note { margin-top: 18rpx; padding: 14rpx 18rpx; background: var(--teal-l); border-radius: 14rpx; font-size: 18rpx; color: var(--teal); line-height: 1.6; }
.sh-btns { display: flex; gap: 16rpx; margin-top: 22rpx; }
.sh-btns .btn { flex: 1; width: auto; height: 80rpx; font-size: 26rpx; }
.spot-list { margin-top: 12rpx; }
.spot-list .rb { font-size: 24rpx; font-weight: 700; }
.spot-list .rs { margin-top: 3rpx; font-size: 18rpx; color: var(--t3); line-height: 1.4; }
