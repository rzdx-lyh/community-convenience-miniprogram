/* 房屋租售 · 页面补充样式（房源卡沿用 .hcard/.hph/.hinfo 原型类） */
.pgh--indigo { --h1: #4A4E86; --h2: #34385F; }
.pgh-num .unit { margin-left: 6rpx; font-size: calc(24rpx * var(--care-scale, 1)); font-weight: 600; opacity: .8; }
.hover-dim { opacity: .86; }

.seg--filter { margin-bottom: 20rpx; }

/* 房源封面渐变（原型为 4 组内联渐变，这里改成修饰类） */
.hph--0 { background: linear-gradient(120deg, #D8D0C3, #8A949D); }
.hph--1 { background: linear-gradient(120deg, #CFE7E0, #8FC7BA); }
.hph--2 { background: linear-gradient(120deg, #EEEAF6, #8A82A8); }
.hph--3 { background: linear-gradient(120deg, #F6E2C8, #E0B57F); }
.hp-i { font-style: normal; font-size: calc(20rpx * var(--care-scale, 1)); font-weight: 600; opacity: .9; }

/* 原型 .htags span 针对 HTML 标签，这里用 text 重写 */
.htags .htag {
  font-size: calc(17rpx * var(--care-scale, 1));
  background: #F1EDE4;
  color: #5B6874;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.page-note { margin: 12rpx 28rpx 40rpx; font-size: calc(18rpx * var(--care-scale, 1)); color: var(--t3); line-height: 1.65; text-align: center; }

/* 弹层通用 */
.sheet { max-height: 86vh; overflow-y: auto; }
.sh-hd { font-size: calc(28rpx * var(--care-scale, 1)); font-weight: 800; text-align: center; }
.sh-sub { margin-top: 8rpx; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); text-align: center; }
.lbl .em { margin-left: auto; font-size: calc(18rpx * var(--care-scale, 1)); font-weight: 400; color: var(--t3); font-style: normal; }
.pay-note {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  background: var(--indigo-l);
  border-radius: 14rpx;
  font-size: calc(18rpx * var(--care-scale, 1));
  color: var(--indigo);
  line-height: 1.6;
}
.sh-btns { display: flex; gap: 16rpx; margin-top: 22rpx; }
.sh-btns .btn { flex: 1; width: auto; height: 80rpx; font-size: calc(26rpx * var(--care-scale, 1)); }

/* 房源详情 */
.dt-hd { display: flex; align-items: center; gap: 18rpx; }
.dt-emoji {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, #EEEAF6, #8A82A8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(46rpx * var(--care-scale, 1));
  flex: none;
}
.dt-hl { flex: 1; min-width: 0; }
.dt-t { font-size: calc(28rpx * var(--care-scale, 1)); font-weight: 800; }
.dt-d { margin-top: 6rpx; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); }
.dt-price { margin-top: 20rpx; font-size: calc(40rpx * var(--care-scale, 1)); font-weight: 800; color: var(--indigo); letter-spacing: -0.8rpx; }
.dt-detail {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #FBF7EF;
  border-radius: 16rpx;
  font-size: calc(21rpx * var(--care-scale, 1));
  color: var(--t2);
  line-height: 1.7;
}

/* ⚠ 房源描述类名是 .hds（不是 .hd）：全局 .hd 是渐变页头（蓝紫渐变+96rpx 底 padding），
   撞名会把描述渲染成蓝色色块（2026-10-22 用户截图实锤）。
   layout.wxss 原型带的 .hinfo .hd 因改名失效，这里在页面层补回同款排版。 */
.hinfo .hds { font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); margin-top: 6rpx; }

/* 实拍图（2026-10-22）：铺满图位，渐变底色作加载兜底；压暗渐变保证白字可读 */
.hph-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.hph-shade {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(10, 16, 32, 0.02) 35%, rgba(10, 16, 32, 0.38) 100%);
}
.hph .hb { z-index: 2; }
.hph .hp,
.hph .hv { position: relative; z-index: 2; }
