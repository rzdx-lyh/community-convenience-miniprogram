/* 房屋租售 · 页面补充样式（房源卡沿用 .hcard/.hph/.hinfo 原型类） */
.pgh--indigo { --h1: #5B54C9; --h2: #322C88; }
.pgh-num .unit { margin-left: 6rpx; font-size: 24rpx; font-weight: 600; opacity: .8; }
.hover-dim { opacity: .86; }

.seg--filter { margin-bottom: 20rpx; }

/* 房源封面渐变（原型为 4 组内联渐变，这里改成修饰类） */
.hph--0 { background: linear-gradient(120deg, #C7D8F6, #8FB0E8); }
.hph--1 { background: linear-gradient(120deg, #CFE7E0, #8FC7BA); }
.hph--2 { background: linear-gradient(120deg, #E8DCF6, #B9A0E3); }
.hph--3 { background: linear-gradient(120deg, #F6E2C8, #E0B57F); }
.hp-i { font-style: normal; font-size: 20rpx; font-weight: 600; opacity: .9; }

/* 原型 .htags span 针对 HTML 标签，这里用 text 重写 */
.htags .htag {
  font-size: 17rpx;
  background: #F1F5FD;
  color: #4A5D78;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.page-note { margin: 12rpx 28rpx 40rpx; font-size: 18rpx; color: var(--t3); line-height: 1.65; text-align: center; }

/* 弹层通用 */
.sheet { max-height: 86vh; overflow-y: auto; }
.sh-hd { font-size: 28rpx; font-weight: 800; text-align: center; }
.sh-sub { margin-top: 8rpx; font-size: 19rpx; color: var(--t3); text-align: center; }
.lbl .em { margin-left: auto; font-size: 18rpx; font-weight: 400; color: var(--t3); font-style: normal; }
.pay-note {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  background: var(--indigo-l);
  border-radius: 14rpx;
  font-size: 18rpx;
  color: var(--indigo);
  line-height: 1.6;
}
.sh-btns { display: flex; gap: 16rpx; margin-top: 22rpx; }
.sh-btns .btn { flex: 1; width: auto; height: 80rpx; font-size: 26rpx; }

/* 房源详情 */
.dt-hd { display: flex; align-items: center; gap: 18rpx; }
.dt-emoji {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, #E8DCF6, #B9A0E3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  flex: none;
}
.dt-hl { flex: 1; min-width: 0; }
.dt-t { font-size: 28rpx; font-weight: 800; }
.dt-d { margin-top: 6rpx; font-size: 19rpx; color: var(--t3); }
.dt-price { margin-top: 20rpx; font-size: 40rpx; font-weight: 800; color: var(--indigo); letter-spacing: -0.8rpx; }
.dt-detail {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #F7F9FD;
  border-radius: 16rpx;
  font-size: 21rpx;
  color: var(--t2);
  line-height: 1.7;
}
