/* 文化便民活动页 · 每周义诊 / 邻里活动 / 长者手机课 */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.act-hero {
  padding: 12rpx 4rpx 4rpx;
  position: relative;
  z-index: 2;
}

.act-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 198rpx;
  background: rgba(255, 255, 255, .2);
  font-size: 19rpx;
  font-weight: 700;
}

.act-sub {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.act-meta {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 20rpx;
  opacity: .9;
}

.act-meta__i {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* calendar 没有白色版素材：在彩色页头用反色滤镜，避免出现透明块 */
.act-wicon {
  filter: brightness(0) invert(1);
}

.act-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  padding: 0 24rpx 4rpx;
}

.act-feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx 18rpx;
  border-radius: var(--radius-m);
  background: var(--card);
  border: 2rpx solid var(--line);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.act-feature--hover {
  background: var(--bg);
  transform: scale(.985);
}

.act-feature__ic {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  background: var(--green-light);
  color: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
}

.act-feature__n {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-1);
  white-space: nowrap;
}

.act-feature__d {
  margin-top: 4rpx;
  font-size: 17rpx;
  color: var(--text-3);
  line-height: 1.35;
}

/* 活动信息行（health 页的 .kv 是页面级，这里补一份） */
.grp__bd .kv {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 12rpx 0;
  font-size: 23rpx;
  border-top: 1rpx solid var(--line);
}

.grp__bd .kv:first-child { border-top: 0; }

.grp__bd .kv__k {
  flex: none;
  width: 78rpx;
  color: var(--text-3);
}

.grp__bd .kv__v {
  flex: 1;
  min-width: 0;
  color: var(--text-1);
  line-height: 1.5;
}

.act-signup {
  margin-top: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-m);
  background: var(--brand-light);
  border: 2rpx solid #D6E4FF;
}

.act-signup--hover { opacity: .86; }

.act-signup__t {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
  color: var(--brand);
}

.act-signup__s {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  color: var(--text-2);
}

.act-note {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0;
  font-size: 21rpx;
  line-height: 1.55;
  color: var(--text-2);
}

.act-note__dot {
  flex: none;
  color: var(--green);
  font-weight: 800;
}

.act-note__t { flex: 1; }

/* 报名弹层（health 页的 .sh-* 是页面级，这里补一份） */
.sh-h {
  padding: 28rpx 28rpx 4rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-1);
}

.sh-sub {
  padding: 4rpx 28rpx 0;
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.sh-body {
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.sh-body .lbl {
  margin-top: 18rpx;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-1);
}

.lbl__em {
  font-size: 17rpx;
  font-weight: 400;
  color: var(--text-3);
}

.acts {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.acts .btn3 {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 700;
}

.acts .btn3.busy { opacity: .7; }

.gap { height: 24rpx; }
