/* 办事指南补充样式 */
.pgh--blue{--h1:#2E6BE0;--h2:#153F9B}
.ph{display:flex;align-items:center;gap:22rpx;margin-top:22rpx;position:relative;z-index:2}
.ph__t{font-size:42rpx;font-weight:800}
.ph__s{font-size:19rpx;opacity:.86;margin-top:8rpx}
.gsearch{margin-top:26rpx;position:relative;z-index:2}
.gph{color:#98A2B3}
.st__b{font-size:28rpx;font-weight:800;flex:1}
.st__em{font-size:19rpx;color:var(--t3)}
.lbl__em{font-style:normal;font-size:19rpx;font-weight:400;color:var(--t3)}
.cats-card{padding:18rpx 20rpx}
.cats{display:flex;gap:12rpx;overflow-x:auto;flex-wrap:nowrap}
.cat{flex:none;height:58rpx;padding:0 20rpx;border-radius:14rpx;background:#F5F7FB;border:1px solid transparent;font-size:21rpx;color:var(--t2);display:flex;align-items:center}
.cat.on{background:var(--blue-l);border-color:var(--blue);color:var(--blue);font-weight:800}
.gcard{padding:24rpx;margin-bottom:18rpx}
.gcard--hover{transform:scale(.992)}
.gc__top{display:flex;align-items:center;gap:12rpx}
.gc__n{flex:1;font-size:28rpx;font-weight:800;color:var(--t1)}
.gc__d{font-size:20rpx;color:var(--t3);margin-top:8rpx;line-height:1.5}
.gc__m{margin-top:14rpx;background:#F7F9FC;border-radius:14rpx;padding:12rpx 16rpx}
.gm{display:flex;gap:12rpx;font-size:19rpx;line-height:1.7}
.gm__k{width:76rpx;flex:none;color:var(--t3)}
.gm__v{flex:1;color:var(--t2)}
.gc__more{display:flex;align-items:center;justify-content:flex-end;margin-top:10rpx;font-size:19rpx;color:var(--blue);font-weight:700}
.gc__more .ar{font-size:28rpx;margin-left:4rpx}
.gap{height:24rpx}

.sh-h{font-size:29rpx;font-weight:800;text-align:center}
.sh-sub{text-align:center;font-size:19rpx;color:var(--t3);margin-top:6rpx;line-height:1.5}
.sh-body{margin-top:12rpx;max-height:54vh;overflow-y:auto}
.sh-lb{font-size:23rpx;font-weight:800;color:var(--t1);margin:18rpx 0 10rpx;padding-left:12rpx;border-left:5rpx solid var(--blue);line-height:1.2}
.mat{display:flex;gap:12rpx;padding:7rpx 0;font-size:21rpx;line-height:1.55;color:var(--t2)}
.mat__n{width:34rpx;height:34rpx;border-radius:50%;background:var(--blue-l);color:var(--blue);font-size:17rpx;font-weight:800;display:flex;align-items:center;justify-content:center;flex:none;margin-top:2rpx}
.mat__t{flex:1}
.kv{display:flex;gap:14rpx;padding:6rpx 0;font-size:21rpx;line-height:1.55}
.kv__k{width:68rpx;flex:none;color:var(--t3)}
.kv__v{flex:1;color:var(--t2)}
.flow{font-size:20rpx;color:var(--t2);line-height:1.7;background:#F7F9FC;border-radius:14rpx;padding:14rpx 16rpx}
.pit{font-size:19rpx;color:#8A5A00;background:var(--gold-l);border-radius:10rpx;padding:10rpx 14rpx;margin-bottom:8rpx;line-height:1.5}
.sh-note{margin-top:14rpx;font-size:17rpx;color:var(--t3);line-height:1.5}
.sh-btns{display:flex;gap:18rpx;margin-top:20rpx}
.sh-btns .btn{flex:1;width:auto}
