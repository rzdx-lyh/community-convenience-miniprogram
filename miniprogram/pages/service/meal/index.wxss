/* 智慧配餐（CR-028）· 补充投影色与 text 节点排版 */
.pgh--green { --h1: #1FA97A; --h2: #0B6146; }
.pgh-km { flex: 1; min-width: 0; }
.pgh-svc { font-size: 34rpx; font-weight: 800; line-height: 1.28; }
.pgh-main { flex: none; }
.pgh-side { flex: 1; min-width: 0; padding-bottom: 4rpx; padding-right: 150rpx; }
.pgh-num .num-u { font-size: 24rpx; font-weight: 600; opacity: 0.8; margin-left: 6rpx; }

.lblw { padding: 0 28rpx; }
.lbl { margin: 24rpx 0 14rpx; }
.lbl-em { font-size: 19rpx; font-weight: 400; color: var(--t3); }
.opt-t { display: block; font-size: 25rpx; font-weight: 800; padding-right: 32rpx; }
.opt-d { display: block; font-size: 18rpx; color: var(--t3); margin-top: 6rpx; }
.dchip .dc-t { display: block; font-size: 23rpx; font-weight: 800; }
.dchip .dc-s { display: block; font-size: 17rpx; color: var(--t3); margin-top: 4rpx; }
.prow { display: flex; gap: 14rpx; padding: 0 24rpx; }
.prow .dchip { flex: 1; min-width: 0; height: 96rpx; }
.chipsw { padding: 0 24rpx; }
.pgtail { height: 20rpx; }

/* 营养达成：原型 mring 依赖内联 CSS 变量，改为数值 + 线性条 */
.nut { display: flex; align-items: center; gap: 22rpx; }
.nut-l { width: 150rpx; flex: none; text-align: center; }
.nut-p { display: block; font-size: 42rpx; font-weight: 800; color: #1FA97A; letter-spacing: -1rpx; }
.nut-s { display: block; font-size: 17rpx; color: var(--t3); margin-top: 2rpx; }
.nut-tr { height: 8rpx; margin-top: 10rpx; }
.nbl .nbr-k { font-style: normal; width: 52rpx; flex: none; color: var(--t3); font-size: 19rpx; }
.nbl .nbr-v { font-size: 18rpx; width: 128rpx; text-align: right; color: var(--t1); font-weight: 700; flex: none; }
.nbl .nbr .bar { flex: 1; margin-top: 0; }
.bar-in { display: block; height: 100%; border-radius: 4rpx; }

.wkd .wk-t { display: block; font-size: 22rpx; font-weight: 800; }
.wkd .wk-d { display: block; font-size: 16rpx; color: var(--t3); margin-top: 4rpx; }
.wkd.on .wk-t { color: var(--blue); }

.dish .dinfo { flex: 1; min-width: 0; }
.dish .dac view {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 18rpx 0;
  font-size: 21rpx;
  color: var(--t2);
}
.dish .dac view + view { border-left: 1px solid #F2F5FA; }
.dish .dac view.on { color: var(--gold); font-weight: 800; }
.meal-note {
  margin: 0 28rpx 6rpx;
  font-size: 18rpx;
  color: var(--t3);
  line-height: 1.65;
  text-align: center;
}

/* 底部固定条：修 layout.wxss 里 position:fixed 的生成器偏差 */
.fbar { left: 0; right: 0; }
.fbar .sum { position: static; flex: 1; min-width: 0; }
.fbar .sum-b { display: block; font-size: 25rpx; color: var(--t1); font-weight: 800; }
.fbar .sum-s { display: block; font-size: 18rpx; color: var(--t3); margin-top: 2rpx; }
.fbar .btn2 {
  position: static;
  background: var(--blue);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  padding: 0 40rpx;
}

/* 弹层 */
.sht-h { font-size: 28rpx; font-weight: 800; text-align: center; margin-bottom: 12rpx; }
.sht-tip { font-size: 19rpx; color: var(--t3); line-height: 1.6; margin-bottom: 12rpx; }
.sht-b { font-size: 20rpx; color: var(--t2); line-height: 1.7; }
.sht-warn {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--gold-l);
  color: #8A5A00;
  font-size: 18rpx;
}
.sht-btn {
  margin-top: 22rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: #F2F5FA;
  color: var(--t2);
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.slb { font-size: 21rpx; font-weight: 700; margin: 16rpx 0 10rpx; }
.req { color: var(--red); font-size: 17rpx; font-weight: 400; }
.opt-n { color: var(--t3); font-size: 17rpx; font-weight: 400; }
.sht-ft { display: flex; gap: 16rpx; margin-top: 22rpx; }
.sht-btn2 {
  flex: 1;
  height: 80rpx;
  border-radius: 18rpx;
  background: #F2F5FA;
  color: var(--t2);
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sht-main { background: var(--blue); color: #fff; font-weight: 800; }
.ing {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
  font-size: 24rpx;
}
.ing-n { font-size: 19rpx; color: var(--t3); }
