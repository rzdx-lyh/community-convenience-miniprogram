/* 图书文化补充样式 */
.pgh--indigo{--h1:#5B55D6;--h2:#2E2A8A}
.ph{display:flex;align-items:center;gap:22rpx;margin-top:22rpx;position:relative;z-index:2}
.ph__t{font-size:42rpx;font-weight:800}
.ph__s{font-size:19rpx;opacity:.86;margin-top:8rpx}
.tabs-card{padding:18rpx 20rpx}
.tabs-card .chips{flex-wrap:nowrap}
.tabs-card .chip{flex:1;justify-content:center}
.tip--row{display:flex;align-items:flex-start;gap:10rpx}
.tip--row .ic{flex:none;margin-top:2rpx}
.catbar{display:flex;gap:12rpx;overflow-x:auto;padding:20rpx 24rpx 0}
.cat{flex:none;height:56rpx;padding:0 20rpx;border-radius:14rpx;background:#fff;border:1px solid var(--line);font-size:21rpx;color:var(--t2);display:flex;align-items:center}
.cat.on{border-color:var(--indigo);background:var(--indigo-l);color:var(--indigo);font-weight:800}
.grp__bd{padding:8rpx 24rpx 22rpx}
.gh__b{font-size:25rpx;font-weight:800;display:flex;align-items:center;gap:12rpx}
.gh__b::before{content:'';width:5rpx;height:22rpx;border-radius:4rpx;background:var(--blue);flex:none}
.gh__p{display:block;margin-top:8rpx;font-size:19rpx;color:var(--t3);line-height:1.4}
.lbl__em{font-style:normal;font-size:19rpx;font-weight:400;color:var(--t3)}
.book{display:flex;align-items:center;gap:18rpx;padding:18rpx 0;border-bottom:1px solid #EFF1F4}
.book:last-child{border-bottom:0}
.cover{width:80rpx;height:104rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;flex:none;color:#fff}
.cb--0{background:linear-gradient(150deg,#3B7DEE,#1B4FB8)}
.cb--1{background:linear-gradient(150deg,#16A085,#0A6B58)}
.cb--2{background:linear-gradient(150deg,#D99636,#A86A05)}
.cb--3{background:linear-gradient(150deg,#6C63D8,#403AA0)}
.book__b{flex:1;min-width:0}
.book__n{font-size:25rpx;font-weight:800;color:var(--t1)}
.book__m{font-size:18rpx;color:var(--t3);margin-top:4rpx}
.book__tags{display:flex;align-items:center;gap:10rpx;margin-top:8rpx}
.book__meta{font-size:17rpx;color:var(--t3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.book__btn{flex:none;height:58rpx;padding:0 22rpx;border-radius:14rpx;background:var(--blue-l);color:var(--blue);font-size:21rpx;font-weight:800;display:flex;align-items:center}
.book__btn.off{background:#F2F5FA;color:var(--t3)}
.kv{display:flex;gap:14rpx;padding:8rpx 0;font-size:21rpx;line-height:1.55}
.kv__k{width:76rpx;flex:none;color:var(--t3)}
.kv__v{flex:1;color:var(--t2)}
.seat{display:flex;align-items:baseline;justify-content:space-between;margin-top:12rpx}
.seat__t{font-size:20rpx;font-weight:700;color:var(--t2)}
.seat__p{font-size:18rpx;color:var(--t3)}
.bar .fill{display:block;height:100%;border-radius:4rpx;background:var(--indigo)}
.acts{margin-top:18rpx}
.acts .btn3{width:100%;height:78rpx}
.gap{height:24rpx}

.sh-h{font-size:28rpx;font-weight:800;text-align:center}
.sh-sub{text-align:center;font-size:19rpx;color:var(--t3);margin-top:6rpx}
.sh-body{margin-top:10rpx;max-height:52vh;overflow-y:auto}
.sh-note{margin-top:18rpx;font-size:17rpx;color:var(--t3);line-height:1.5}
.sh-btns{display:flex;gap:18rpx;margin-top:22rpx}
.sh-btns .btn{flex:1;width:auto}
