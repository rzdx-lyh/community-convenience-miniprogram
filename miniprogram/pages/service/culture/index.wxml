<!-- 文化服务（CR-027）· 图书角借阅 / 四点半课堂 -->
<view class="page">
  <view class="top">
    <view class="top__t">文化服务</view>
    <view class="top__s">社区活动室 · 免费参加</view>
  </view>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{tab === item.key ? 'is-on' : ''}}"
      data-t="{{item.key}}"
      bindtap="onSwitchTab"
    >{{item.name}}</view>
  </view>

  <view class="note">{{tabNote}}</view>

  <!-- 图书角 -->
  <block wx:if="{{tab === 'library'}}">
    <view class="sec">
      <view class="sec__hd">
        <text class="sec__t">在架书目</text>
        <text class="sec__s">共 {{books.length}} 本</text>
      </view>
      <picker mode="selector" range="{{cats}}" value="{{catIndex}}" bindchange="onCatChange">
        <view class="pk">{{cat}} ▾</view>
      </picker>

      <view wx:for="{{books}}" wx:key="id" class="bk">
        <view class="bk__l">
          <view class="bk__n">{{item.name}}</view>
          <view class="bk__d">{{item.cat}} · {{item.author}}</view>
          <view class="bk__m">{{item.meta}}</view>
        </view>
        <view class="bk__r">
          <view class="bk__s">在架 {{item.stock}}/{{item.total}}</view>
          <view class="bk__btn {{item.stock > 0 ? '' : 'is-dis'}}" data-id="{{item.id}}" bindtap="onBorrow">
            {{item.stock > 0 ? '借阅' : '已借出'}}
          </view>
        </view>
      </view>
    </view>

    <view class="sec">
      <view class="sec__hd"><text class="sec__t">借阅规则</text></view>
      <view wx:for="{{rules}}" wx:key="label" class="rule">
        <text class="rule__l">{{item.label}}</text>
        <text class="rule__v">{{item.value}}</text>
      </view>
    </view>
  </block>

  <!-- 四点半课堂 -->
  <block wx:else>
    <view class="sec">
      <view class="sec__hd">
        <text class="sec__t">本周课程</text>
        <text class="sec__s">放学后托管</text>
      </view>
      <view wx:for="{{classes}}" wx:key="id" class="cl">
        <view class="cl__n">{{item.name}}</view>
        <view class="kv"><text class="kv__k">时间</text><text class="kv__v">{{item.time}}</text></view>
        <view class="kv"><text class="kv__k">对象</text><text class="kv__v">{{item.target}}</text></view>
        <view class="kv"><text class="kv__k">师资</text><text class="kv__v">{{item.teacher}}</text></view>
        <view class="cl__d">{{item.desc}}</view>
        <view class="bar"><view class="bar__in" style="width:{{item.percent}}%"></view></view>
        <view class="cl__f">
          <text class="cl__s">余 {{item.seats}} / {{item.total}} 个名额</text>
          <view class="cl__btn {{item.full ? 'is-dis' : ''}}" data-id="{{item.id}}" bindtap="onJoin">
            {{item.full ? '已满' : '报名'}}
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="foot">
    本页<text class="foot__b">不收款</text>；图书角免费借阅，课堂材料费（如有）现场收取并公示。
  </view>

  <ai-bar page="culture" />

  <view wx:if="{{showForm}}" class="mask" bindtap="onCloseForm">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">{{kind === '借书' ? '借阅登记' : '课堂报名'}} · {{itemName}}</view>
      <view class="sheet__tip">提交后到社区活动室（会所 2 层 201）办理；本页不收款。</view>

      <view class="sheet__lb">楼栋房号 <text class="req">必填</text></view>
      <input class="inp" placeholder="例：3 号楼 2 单元 502" maxlength="24" value="{{room}}" bindinput="onInputRoom" />
      <view class="sheet__lb">联系电话 <text class="req">必填</text></view>
      <input class="inp" type="number" placeholder="例：13800138000" maxlength="16" value="{{contact}}" bindinput="onInputContact" />
      <view class="sheet__lb">备注 <text class="opt">选填</text></view>
      <textarea class="ta" placeholder="例如：孩子二年级，想报周二书法" maxlength="120" value="{{note}}" bindinput="onInputNote" />

      <view class="sheet__ft">
        <view class="sheet__btn" bindtap="onCloseForm">取消</view>
        <view class="sheet__btn sheet__btn--main {{submitting ? 'is-dis' : ''}}" bindtap="onSubmit">{{submitting ? '提交中…' : '提交'}}</view>
      </view>
    </view>
  </view>
</view>
