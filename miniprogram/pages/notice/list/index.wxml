<!-- 社区通知（CR-028 · 对照 demo.html pgNotice 重建） -->
<view class="page">
  <view class="sbar dark" style="padding-top:{{statusBarHeight}}px">
    <text>{{clock}}</text>
    <text class="sbar__sig">●●● ▮</text>
  </view>

  <view class="nav nav--plain">
    <view class="bk" bindtap="goBack"><text>‹</text></view>
    <text>消息通知</text>
    <view wx:if="{{demoMode}}" class="rt rt--muted">示例</view>
  </view>

  <!-- 类型筛选 -->
  <view class="tb">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="t {{activeTab === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    ><text>{{item.label}}</text></view>
  </view>

  <view wx:if="{{demoMode}}" class="tip">当前展示本地示例通知（云服务未返回数据），实际以社区公告为准。</view>

  <!-- 通知列表 -->
  <block wx:for="{{list}}" wx:key="id">
    <view class="nt" data-id="{{item.id}}" bindtap="onCardTap" hover-class="hv">
      <view class="h">
        <view class="tag {{item.tagClass}}"><text>{{item.tagLabel}}</text></view>
        <view wx:if="{{item.levelLabel}}" class="tag red"><text>{{item.levelLabel}}</text></view>
        <text class="nt__ago">{{item.timeText}}</text>
      </view>

      <view class="tt">{{item.title}}</view>
      <view wx:if="{{item.summary !== item.title}}" class="bd">{{item.summary}}</view>

      <!-- 展开：全文 + 地点 + 起止 -->
      <view wx:if="{{expandedId === item.id}}" class="nt__more">
        <view wx:if="{{item.content}}" class="bd bd--full">{{item.content}}</view>
        <view class="nt__rows">
          <view wx:if="{{item.placeText}}" class="nt__row">
            <view class="ic ic-s ic-pin"></view>
            <text>{{item.placeText}}</text>
          </view>
          <view wx:if="{{item.rangeText}}" class="nt__row">
            <view class="ic ic-s ic-clock"></view>
            <text>{{item.rangeText}}</text>
          </view>
        </view>
        <view class="nt__fold">收起</view>
      </view>

      <view class="mt">
        <text>{{item.metaText}}</text>
        <text wx:if="{{item.placeText && expandedId !== item.id}}">· {{item.placeText}}</text>
        <text class="nt__expand">{{expandedId === item.id ? '' : '展开 ›'}}</text>
      </view>
    </view>
  </block>

  <!-- 首屏空态 -->
  <view wx:if="{{list.length === 0 && !loading}}" class="empty">
    <view class="empty__t">暂无该类通知</view>
    <view class="empty__s">社区有消息会第一时间发布</view>
  </view>

  <view wx:if="{{loading && list.length === 0}}" class="empty">加载中…</view>
  <view wx:if="{{loading && list.length > 0}}" class="aifoot">加载更多…</view>
  <view wx:if="{{!loading && !hasMore && list.length > 0 && !demoMode}}" class="aifoot">没有更多了</view>

  <!-- 页面级 AI 入口（保留既有能力） -->
  <ai-bar page="notice" />
</view>
