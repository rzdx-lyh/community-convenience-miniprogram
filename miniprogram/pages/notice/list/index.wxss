/* 社区通知 · 原型类之外的最小补充（原型类见 styles/layout.wxss） */

.sbar__sig {
  font-size: calc(17rpx * var(--care-scale, 1));
  letter-spacing: 1rpx;
  color: var(--t3);
}

.nav--plain {
  border-bottom: 0;
}

.rt--muted {
  color: var(--t3);
  font-weight: 600;
}

/* 6 个 tab 平分：原型 24rpx 在 750rpx 下偏挤，降到 22rpx */
.tb .t {
  font-size: calc(22rpx * var(--care-scale, 1));
}

.nt .h .tag {
  flex: none;
}

.nt__ago {
  margin-left: auto;
  font-size: calc(18rpx * var(--care-scale, 1));
  color: var(--t3);
}

.nt .tt {
  font-size: calc(26rpx * var(--care-scale, 1));
}

/* 展开后的全文 */
.nt__more {
  margin-top: 12rpx;
  padding-top: 14rpx;
  border-top: 1px dashed var(--line);
}

.bd--full {
  font-size: calc(22rpx * var(--care-scale, 1));
  line-height: 1.72;
  color: var(--t2);
  white-space: pre-wrap;
}

.nt__rows {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.nt__row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: calc(19rpx * var(--care-scale, 1));
  color: var(--t3);
}

.nt__row .ic {
  width: 28rpx;
  height: 28rpx;
  border-radius: 0;
  font-size: calc(22rpx * var(--care-scale, 1));
  color: var(--t3);
}

.nt__fold {
  margin-top: 12rpx;
  font-size: calc(19rpx * var(--care-scale, 1));
  font-weight: 700;
  color: var(--blue);
}

.nt .mt {
  align-items: center;
}

.nt__expand {
  margin-left: auto;
  color: var(--blue);
  font-weight: 700;
}

.empty__t {
  font-size: calc(24rpx * var(--care-scale, 1));
  color: var(--t2);
  font-weight: 700;
}

.empty__s {
  margin-top: 6rpx;
  font-size: calc(20rpx * var(--care-scale, 1));
  color: var(--t3);
}

/* 按压态（原型 :active 在小程序不生效） */
.hv {
  opacity: 0.72;
}
