<!-- 社区圈子（FE-12 · 最小版只读流） -->
<view class="page {{elderMode ? 'care-mode' : ''}}">
  <!-- Tag 分类 Tab -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tabs__item {{activeType === item.value ? 'is-active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </view>

  <!-- 列表 -->
  <block wx:if="{{list.length > 0}}">
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="post"
      data-id="{{item._id}}"
      bindtap="onCardTap"
    >
      <view class="post__head">
        <text class="post__type">{{item.typeLabel}}</text>
        <text wx:if="{{item.topFlag}}" class="post__top">置顶</text>
        <text class="post__time">{{item.timeText}}</text>
      </view>
      <view class="post__title">{{item.title}}</view>
      <view class="post__content {{item.expanded ? 'is-expanded' : ''}}">{{item.content}}</view>
      <view class="post__foot">
        <view class="post__author">
          <text class="post__author-name">{{item.authorName}}</text>
          <text wx:if="{{item.isOfficial}}" class="post__badge">官方</text>
        </view>
        <text class="post__view">{{item.viewCount}} 次浏览</text>
      </view>
      <view wx:if="{{item.tags.length > 0}}" class="post__tags">
        <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="post__tag">{{tag}}</text>
      </view>
    </view>
    <view class="list-footer">
      <text wx:if="{{loadingMore}}">加载中…</text>
      <text wx:elif="{{hasMore}}">上拉加载更多</text>
      <text wx:else>没有更多了</text>
    </view>
  </block>

  <empty-state
    wx:else
    type="circle"
    text="{{emptyText}}"
    subText="{{emptySubText}}"
  />
</view>
