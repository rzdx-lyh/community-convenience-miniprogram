/* 社区圈子页（FE-12） */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 var(--space-4) var(--space-5);
}

/* Tag 分类 Tab */
.tabs {
  display: flex;
  gap: var(--space-2);
  padding: var(--space-3) 0;
}

.tabs__item {
  padding: 0 var(--space-4);
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-full);
  background: var(--card);
  color: var(--text-2);
  font-size: var(--font-sub);
}

.tabs__item.is-active {
  background: var(--brand);
  color: var(--card);
  font-weight: 700;
}

/* 帖子卡片 */
.post {
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.post__head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--font-cap);
  color: var(--text-2);
}

.post__type {
  padding: 0 var(--space-2);
  height: 40rpx;
  line-height: 40rpx;
  border-radius: var(--radius-s);
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 600;
}

.post__top {
  padding: 0 var(--space-2);
  height: 40rpx;
  line-height: 40rpx;
  border-radius: var(--radius-s);
  background: var(--accent-warm-light);
  color: var(--accent-warm);
  font-weight: 600;
}

.post__time {
  margin-left: auto;
}

.post__title {
  margin-top: var(--space-2);
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--text-1);
}

.post__content {
  margin-top: var(--space-1);
  font-size: var(--font-body);
  color: var(--text-2);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post__content.is-expanded {
  -webkit-line-clamp: unset;
  overflow: visible;
}

.post__foot {
  margin-top: var(--space-3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--font-cap);
  color: var(--text-2);
}

.post__author {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.post__badge {
  padding: 0 var(--space-1);
  height: 36rpx;
  line-height: 36rpx;
  border-radius: var(--radius-s);
  background: var(--brand);
  color: var(--card);
  font-weight: 600;
}

.post__tags {
  margin-top: var(--space-2);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

.post__tag {
  padding: 0 var(--space-2);
  height: 40rpx;
  line-height: 40rpx;
  border-radius: var(--radius-full);
  background: var(--green-light);
  color: var(--green);
  font-size: var(--font-cap);
}

.list-footer {
  text-align: center;
  padding: var(--space-3) 0;
  font-size: var(--font-cap);
  color: var(--text-2);
}

/* 关怀模式：时间戳等辅助文字升为次级文字（design-tokens §③ 对比度升级） */
.care-mode .post__time,
.care-mode .post__foot,
.care-mode .list-footer {
  color: var(--text-2);
}
