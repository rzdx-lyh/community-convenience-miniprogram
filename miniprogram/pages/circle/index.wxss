/* 社区圈子补充样式 */

/* 恢复图标尺寸档（layout 的 .ic 覆盖了 icons 的 .ic-s/.ic-m） */
.ic.ic-s { width: 32rpx; height: 32rpx; }
.ic.ic-m { width: 40rpx; height: 40rpx; }

.hover-dim { opacity: .86; }

.nav--flat { border-bottom: 0; }

/* 圈子信息条（原型用内联 style） */
.cb-ic {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #D8D0C3;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.cbar .cb-b { flex: 1; min-width: 0; }
.cbar .cb-b .t { display: block; font-size: calc(25rpx * var(--care-scale, 1)); font-weight: 800; color: #173A5E; }
.cbar .cb-b .s { display: block; font-size: calc(19rpx * var(--care-scale, 1)); color: #5B6874; margin-top: 4rpx; }

/* AI 摘要（原型 b / i / ul / li 换成 view + 类名） */
.aidig .d-top { display: flex; align-items: center; gap: 8rpx; font-size: calc(25rpx * var(--care-scale, 1)); font-weight: 800; position: relative; }
.aidig .dt { font-weight: 800; }
.aidig .d-badge {
  font-size: calc(17rpx * var(--care-scale, 1));
  background: rgba(255, 255, 255, .24);
  padding: 1px 10rpx;
  border-radius: 6rpx;
  font-weight: 400;
}
.aidig .d-li { position: relative; margin-top: 12rpx; font-size: calc(21rpx * var(--care-scale, 1)); line-height: 1.62; padding-left: 24rpx; }
.aidig .d-li::before { content: '·'; position: absolute; left: 6rpx; }

/* feed tab 计数 */
.ftabs .em {
  font-style: normal;
  font-size: calc(17rpx * var(--care-scale, 1));
  color: var(--blue);
  background: var(--blue-l);
  padding: 0 8rpx;
  border-radius: 6rpx;
  margin-left: 6rpx;
  vertical-align: 1px;
}

/* 话题广场标题（原型内联 margin） */
.st--topic { margin: 24rpx 24rpx 0; padding: 0 0 12rpx; }

/* 话题卡文案（原型 .tc b / .tc span） */
.tc .tc-b { display: flex; align-items: center; gap: 8rpx; font-size: calc(23rpx * var(--care-scale, 1)); font-weight: 800; color: var(--t1); }
.tc .tc-s { display: block; font-size: calc(18rpx * var(--care-scale, 1)); color: var(--t3); margin-top: 6rpx; }

/* 帖子动作条（原型 .p-act div） */
.p-act .a { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: calc(22rpx * var(--care-scale, 1)); color: var(--t2); padding: 6rpx 0; border-radius: 12rpx; }
.p-act .a.on { color: #C34A36; font-weight: 700; }

/* 帖子扩展信息行（价格 / 时间 / 状态） */
.p-x {
  margin-top: 16rpx;
  font-size: calc(20rpx * var(--care-scale, 1));
  color: #5B6874;
  background: #FBF7EF;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  line-height: 1.5;
}

.circle-foot { height: 168rpx; }

.page { background: var(--bg); }
