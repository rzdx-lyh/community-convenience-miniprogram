/* 发布动态：只补原型未覆盖的表单行、图片宫格与底部条定位 */
.fbar { left: 0; right: 0; }
.fbar .btn { flex: 1; width: auto; height: 80rpx; font-size: calc(26rpx * var(--care-scale, 1)); }
.fbar .btn[disabled] { background: #EEE8DD; color: #9AA6B6; }
.fbar__sum { flex: none; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); }

.lbl { font-size: calc(23rpx * var(--care-scale, 1)); font-weight: 700; color: var(--t2); margin: 24rpx 0 12rpx; }
.cnt { margin-top: 8rpx; text-align: right; font-size: calc(18rpx * var(--care-scale, 1)); color: var(--t3); }
.ph { color: #A3ADBB; }

.dgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-top: 6rpx; }
.d { position: relative; height: 186rpx; border-radius: 16rpx; overflow: hidden; background: linear-gradient(135deg, #E8F0F2, #D8D0C3); }
.d image { width: 100%; height: 100%; display: block; }
.d .del { position: absolute; right: 8rpx; top: 8rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: rgba(0, 0, 0, .5); color: #fff; font-size: calc(24rpx * var(--care-scale, 1)); line-height: 34rpx; text-align: center; }
.d.add { border: 1px dashed #D8D0C3; background: var(--card); color: #A3ADBB; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; font-size: calc(19rpx * var(--care-scale, 1)); }
.d.add .plus { font-size: calc(46rpx * var(--care-scale, 1)); line-height: 1; }

.fitem { display: flex; align-items: center; height: 84rpx; border-bottom: 1px solid #EEE8DD; }
.fitem .k { width: 180rpx; flex: none; font-size: calc(23rpx * var(--care-scale, 1)); color: var(--t2); }
.fitem input { flex: 1; font-size: calc(23rpx * var(--care-scale, 1)); text-align: right; }

.aipolish { display: inline-flex; align-items: center; gap: 8rpx; margin-top: 22rpx; padding: 10rpx 20rpx; border-radius: 198rpx; background: var(--blue-l); color: var(--blue); font-size: calc(20rpx * var(--care-scale, 1)); font-weight: 700; }
.tip2 { margin-top: 20rpx; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); line-height: 1.6; }
