/* AI 助手 · 原型类之外的补充（气泡/思考/引用均在 layout.wxss，这里只补布局与固定输入条） */

.page--chat {
  padding-bottom: 200rpx;
}

.sbar__sig {
  font-size: calc(17rpx * var(--care-scale, 1));
  color: var(--t3);
}

.nav--plain {
  border-bottom: 0;
}

/* 欢迎卡 */
.wel {
  margin-bottom: 22rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: var(--sh);
}

.wel__t {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: calc(27rpx * var(--care-scale, 1));
  font-weight: 800;
}

.wel__t .ic {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  /* ⚠ 必须用 background-color：background 简写会把 icons.wxss 里的
     background-image 一并清空，图标变成纯色块（2026-10-20 首页 8 宫格同因） */
  background-color: var(--indigo-l);
  color: var(--indigo);
  font-size: calc(26rpx * var(--care-scale, 1));
}

.wel__d {
  margin-top: 10rpx;
  font-size: calc(21rpx * var(--care-scale, 1));
  line-height: 1.68;
  color: var(--t2);
}

/* 原型里 `.sug div` / `.think div` / `.mtag b` 依赖 HTML 元素选择器，
   小程序只有 view/text，这里按类名补回同款样式 */
.sug view {
  font-size: calc(19rpx * var(--care-scale, 1));
  border: 1px solid var(--line);
  background: #fff;
  color: var(--blue);
  padding: 6rpx 16rpx;
  border-radius: 198rpx;
}

.think view {
  font-size: calc(20rpx * var(--care-scale, 1));
  color: var(--t3);
  line-height: 1.7;
  display: flex;
  gap: 8rpx;
}

.think view.done {
  color: #5A6472;
}

.mtag__b {
  background: var(--blue-l);
  color: var(--blue);
  padding: 1px 10rpx;
  border-radius: 6rpx;
  font-weight: 800;
}

/* 回答正文保留换行 */
.bub__t {
  font-size: calc(24rpx * var(--care-scale, 1));
  line-height: 1.72;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 来源引用（原型 .cites 内是 span，小程序用 view） */
.cites .cite {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: calc(17rpx * var(--care-scale, 1));
  background: #F1F5FD;
  color: #4A5D78;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.cites .cite .ic {
  width: 24rpx;
  height: 24rpx;
  border-radius: 0;
  font-size: calc(18rpx * var(--care-scale, 1));
  color: #4A5D78;
}

/* 输入区：固定底部，长会话不把输入框推走 */
.aiask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.aiask .voice .ic {
  width: 100%;
  height: 100%;
  border-radius: 0;
  color: inherit;
  font-size: calc(30rpx * var(--care-scale, 1));
}

.send--busy {
  opacity: 0.45;
}

/* 原型按钮是 <button>（自带居中），小程序用 view 需补 flex 居中 */
.aiask .send {
  display: flex;
  align-items: center;
  justify-content: center;
}

.aifoot__link {
  color: var(--blue);
  font-weight: 700;
}

.hv {
  opacity: 0.72;
}

/* 语音能力尚未开放：入口保留但明确标注「规划中」，不伪装成可用能力 */
.aiask .voice--planned {
  width: auto;
  min-width: 116rpx;
  padding: 0 12rpx;
  border-radius: 34rpx;
  gap: 4rpx;
  opacity: .76;
}
.aiask .voice__tag {
  font-size: calc(17rpx * var(--care-scale, 1));
  font-weight: 700;
}
.care-mode .aiask .voice--planned { min-height: 88rpx; }

/* Agent 工具产出的下一步操作 */
.agent-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.agent-action {
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: calc(20rpx * var(--care-scale, 1));
  font-weight: 700;
  display: flex;
  align-items: center;
}
.care-mode .agent-action {
  min-height: 76rpx;
  font-size: var(--font-sub);
}

/* ===== AI 管家 · 暖纸 Agent 视觉 ===== */
.page--chat {
  background-color: var(--bg);
  background-image: radial-gradient(circle at 10% 4%, rgba(196, 106, 46, .10), transparent 28%), radial-gradient(circle at 100% 10%, rgba(36, 92, 115, .10), transparent 30%);
}
.nav--plain { background: rgba(255, 252, 245, .92); }
.aichat { padding: 24rpx; }
.wel {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(89, 74, 58, .10);
  background: linear-gradient(155deg, #FFFCF5 0%, #F7EFE2 100%);
  box-shadow: 0 16rpx 38rpx rgba(46, 54, 64, .09);
}
.wel::before {
  content: '';
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  right: -90rpx;
  top: -110rpx;
  background: rgba(196, 106, 46, .10);
}
.wel__t { font-size: 31rpx; color: var(--text-1); }
.wel__t .ic { background-color: var(--accent-warm-light); color: var(--accent-warm); }
.wel__d { position: relative; z-index: 1; font-size: 22rpx; line-height: 1.7; color: var(--text-2); }
.sug view {
  min-height: 56rpx;
  padding: 8rpx 18rpx;
  border-color: rgba(89, 74, 58, .12);
  background: #FFFDF8;
  color: var(--brand);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(46, 54, 64, .04);
}
.msg.a .bub {
  background: var(--card);
  border: 1rpx solid rgba(89, 74, 58, .09);
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(46, 54, 64, .07);
}
.msg.u .bub {
  background: var(--brand);
  border-radius: 24rpx 8rpx 24rpx 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(23, 58, 94, .16);
}
.mtag__b { background: var(--accent-warm-light); color: var(--accent-warm); }
.think {
  padding: 14rpx 16rpx;
  border-left: 5rpx solid var(--accent-warm);
  border-radius: 0 14rpx 14rpx 0;
  background: #F8F2E8;
}
.cites .cite { background: #EFF3F2; color: var(--brand); }
.cites .cite .ic { color: var(--brand); }
.agent-action {
  min-height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(23, 58, 94, .16);
}
.aiask {
  border-top: 1rpx solid rgba(89, 74, 58, .10);
  background: rgba(255, 252, 245, .96);
  box-shadow: 0 -10rpx 30rpx rgba(46, 54, 64, .06);
}
.aiask input { background: #F5EFE5; border: 1rpx solid rgba(89, 74, 58, .08); }
.aiask .send { background: var(--brand); }
.aifoot { background: transparent; }
