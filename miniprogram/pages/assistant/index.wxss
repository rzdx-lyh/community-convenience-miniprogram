/* AI 助手 · 原型类之外的补充（气泡/思考/引用均在 layout.wxss，这里只补布局与固定输入条） */

.page--chat {
  padding-bottom: 200rpx;
}

.sbar__sig {
  font-size: 17rpx;
  color: var(--t3);
}

.nav--plain {
  border-bottom: 0;
}

/* 欢迎卡 */
.wel {
  margin-bottom: 22rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: var(--sh);
}

.wel__t {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.wel__t .ic {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: var(--indigo-l);
  color: var(--indigo);
  font-size: 26rpx;
}

.wel__d {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.68;
  color: var(--t2);
}

/* 原型里 `.sug div` / `.think div` / `.mtag b` 依赖 HTML 元素选择器，
   小程序只有 view/text，这里按类名补回同款样式 */
.sug view {
  font-size: 19rpx;
  border: 1px solid var(--line);
  background: #fff;
  color: var(--blue);
  padding: 6rpx 16rpx;
  border-radius: 198rpx;
}

.think view {
  font-size: 20rpx;
  color: var(--t3);
  line-height: 1.7;
  display: flex;
  gap: 8rpx;
}

.think view.done {
  color: #5A6472;
}

.mtag__b {
  background: var(--blue-l);
  color: var(--blue);
  padding: 1px 10rpx;
  border-radius: 6rpx;
  font-weight: 800;
}

/* 回答正文保留换行 */
.bub__t {
  font-size: 24rpx;
  line-height: 1.72;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 来源引用（原型 .cites 内是 span，小程序用 view） */
.cites .cite {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 17rpx;
  background: #F1F5FD;
  color: #4A5D78;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.cites .cite .ic {
  width: 24rpx;
  height: 24rpx;
  border-radius: 0;
  font-size: 18rpx;
  color: #4A5D78;
}

/* 输入区：固定底部，长会话不把输入框推走 */
.aiask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.aiask .voice .ic {
  width: 100%;
  height: 100%;
  border-radius: 0;
  color: inherit;
  font-size: 30rpx;
}

.send--busy {
  opacity: 0.45;
}

/* 原型按钮是 <button>（自带居中），小程序用 view 需补 flex 居中 */
.aiask .send {
  display: flex;
  align-items: center;
  justify-content: center;
}

.aifoot__link {
  color: var(--blue);
  font-weight: 700;
}

.hv {
  opacity: 0.72;
}
