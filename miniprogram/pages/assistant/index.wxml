<!-- AI 助手（CR-028 · 对照 demo.html pgAi 重建） -->
<view class="page page--chat">
  <view class="sbar dark" style="padding-top:{{statusBarHeight}}px">
    <text>AI 助手</text>
    <text class="sbar__sig">{{busy ? '思考中' : '在线'}}</text>
  </view>

  <view class="nav nav--plain">
    <view class="bk" bindtap="goBack"><text>‹</text></view>
    <text>AI 助手</text>
    <view class="rt" bindtap="onClear">清空</view>
  </view>

  <view class="aichat">
    <!-- 欢迎卡（无消息时） -->
    <view wx:if="{{showWelcome}}" class="wel">
      <view class="wel__t">
        <view class="ic ic-m ic-robot"></view>
        <text>我是社区 AI 管家</text>
      </view>
      <view class="wel__d">
        能查办事材料、指路找点位、解释健康指标。回答会标注来源；涉及医疗只做提示，不替代医生诊断。
      </view>
      <view class="sug">
        <view
          wx:for="{{suggestions}}"
          wx:key="*this"
          data-q="{{item}}"
          bindtap="onSuggestTap"
          hover-class="hv"
        >{{item}}</view>
      </view>
    </view>

    <!-- 会话流 -->
    <block wx:for="{{msgs}}" wx:key="id">
      <view wx:if="{{item.role === 'user'}}" class="msg u">
        <view class="bub"><text>{{item.text}}</text></view>
      </view>

      <view wx:else class="msg a">
        <view class="bub">
          <view class="mtag">
            <text class="mtag__b">{{item.badge}}</text>
            <text>{{item.pending ? '思考中…' : item.msText}}</text>
          </view>

          <!-- 思考过程 -->
          <view wx:if="{{item.steps.length > 0}}" class="think">
            <view wx:for="{{item.steps}}" wx:for-item="s" wx:key="t" class="{{s.done ? 'done' : ''}}">
              <text class="ok2">{{s.done ? '✓' : '○'}}</text>
              <text>{{s.t}}</text>
            </view>
          </view>

          <view wx:if="{{item.text}}" class="bub__t">{{item.text}}</view>

          <!-- 来源引用 -->
          <view wx:if="{{item.sources.length > 0}}" class="cites">
            <view wx:for="{{item.sources}}" wx:for-item="c" wx:key="*this" class="cite">
              <view class="ic ic-s ic-clip"></view>
              <text>{{c}}</text>
            </view>
          </view>

          <!-- 降级 / 安全提示 -->
          <view wx:if="{{item.degradedTip}}" class="warn2">{{item.degradedTip}}</view>

          <!-- 追问 -->
          <view wx:if="{{!item.pending}}" class="sug">
            <view
              wx:for="{{followUps}}"
              wx:for-item="f"
              wx:key="*this"
              data-q="{{f}}"
              bindtap="onSuggestTap"
              hover-class="hv"
            >{{f}}</view>
          </view>
        </view>
      </view>
    </block>

    <view class="aifoot">
      {{footerText}} · 回答由社区知识库与免费模型生成，办事以窗口指南为准。
      <text class="aifoot__link" bindtap="onManual">转人工 ›</text>
    </view>
  </view>

  <!-- 输入区（固定底部，避免长会话把输入框推走） -->
  <view class="aiask">
    <view class="voice" bindtap="onVoice"><view class="ic ic-m ic-mic"></view></view>
    <input
      value="{{input}}"
      placeholder="问点什么：雨伞怎么借、血压高怎么办…"
      maxlength="300"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
    />
    <view class="send {{busy ? 'send--busy' : ''}}" bindtap="onSend">
      <text>{{busy ? '…' : '发送'}}</text>
    </view>
  </view>
</view>
