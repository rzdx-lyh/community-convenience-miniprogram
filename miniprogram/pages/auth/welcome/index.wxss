/* 引导页补充样式（原型类未覆盖部分） */
.page.authp {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.au-pts text {
  display: block;
}
.au-pts .n {
  font-size: calc(32rpx * var(--care-scale, 1));
  font-weight: 800;
}
.au-pts .l {
  font-size: calc(17rpx * var(--care-scale, 1));
  opacity: 0.8;
}

.feat {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1px solid #EEE8DD;
}
.feat:last-of-type {
  border-bottom: 0;
  padding-bottom: 8rpx;
}
.feat__i {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.fi--blue {
  background: #E8F0F2;
  color: #173A5E;
}
.fi--teal {
  background: #E4F3EE;
  color: #147D70;
}
.fi--gold {
  background: #F8E8D8;
  color: #C46A2E;
}
.fi--indigo {
  background: #EEEAF6;
  color: #4A4E86;
}
.feat__b {
  flex: 1;
  min-width: 0;
}
.feat__n {
  display: block;
  font-size: calc(25rpx * var(--care-scale, 1));
  font-weight: 800;
  color: var(--t1);
}
.feat__d {
  display: block;
  margin-top: 4rpx;
  font-size: calc(19rpx * var(--care-scale, 1));
  color: var(--t3);
  line-height: 1.5;
}

.au-btn {
  margin-top: 24rpx;
}
.au-btn--hover {
  transform: scale(0.985);
  filter: brightness(0.95);
}
.au-btn .ar {
  font-size: calc(34rpx * var(--care-scale, 1));
  opacity: 0.8;
}
.lnk {
  color: var(--blue);
  font-weight: 600;
}
.au-tip .ic {
  flex: none;
  color: var(--t3);
}
