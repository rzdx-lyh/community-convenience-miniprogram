.page.staff-pw {
  min-height: 100vh;
  padding: 120rpx 28rpx 60rpx;
  box-sizing: border-box;
  background: var(--bg);
}
.pw-card { background: var(--card); border-radius: 28rpx; box-shadow: var(--shadow-card); padding: 36rpx 28rpx; }
.pw-icon { width: 76rpx; height: 76rpx; border-radius: 22rpx; background: var(--brand-light); color: var(--brand); display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.pw-title { font-size: var(--font-title); font-weight: 800; }
.pw-sub { margin-top: 8rpx; font-size: var(--font-sub); color: var(--text-2); line-height: 1.6; }
.pw-field { margin-top: 24rpx; }
.pw-label { display: block; margin-bottom: 8rpx; font-size: var(--font-cap); color: var(--text-2); font-weight: 700; }
.pw-input { width: 100%; height: 88rpx; box-sizing: border-box; padding: 0 20rpx; border-radius: var(--radius-m); border: 2rpx solid var(--line); background: var(--card); font-size: var(--font-body); }
.pw-submit { margin-top: 32rpx; min-height: 92rpx; border-radius: var(--radius-full); background: var(--brand); color: #fff; font-size: var(--font-btn); font-weight: 800; display: flex; align-items: center; justify-content: center; }
.pw-submit.off { opacity: .45; }
.pw-back { margin-top: 20rpx; text-align: center; font-size: var(--font-sub); color: var(--text-2); padding: 18rpx; }
.care-mode .pw-input { min-height: 96rpx; }
