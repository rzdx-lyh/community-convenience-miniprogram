<!-- 三页签登录页：居民 / 管理端 / 维修端 -->
<view class="page authp {{careMode ? 'care-mode' : ''}}">
  <view class="sbar dark" style="padding-top:{{statusBarHeight}}px">
    <text>08:42</text>
    <text>●●● ▮</text>
  </view>

  <view class="au-hero">
    <view class="au-logo">邻</view>
    <view class="au-nm">邻里百事通小助手</view>
    <view class="au-sb">阳光社区 · 报修缴费挂号，一个入口办完</view>
    <view class="au-pts">
      <view><text class="n">38</text><text class="l">项服务</text></view>
      <view><text class="n">8</text><text class="l">个板块</text></view>
      <view><text class="n">24h</text><text class="l">自助办理</text></view>
    </view>
  </view>

  <view class="portal-tabs">
    <view
      wx:for="{{portals}}"
      wx:key="key"
      class="portal-tab {{portal === item.key ? 'on' : ''}}"
      data-portal="{{item.key}}"
      bindtap="onPortalTap"
      hover-class="portal-tab--hover"
    >
      <text class="portal-tab__n">{{item.label}}</text>
      <text class="portal-tab__d">{{item.desc}}</text>
    </view>
  </view>

  <view class="au-card">
    <view wx:if="{{portal === 'resident'}}">
      <view class="au-t">登录后即可预约、报修与登记</view>

      <view class="au-btn {{busy ? 'busy' : ''}} {{agree ? '' : 'off'}}" hover-class="au-btn--hover" bindtap="onWxLogin">
        <view class="au-wx"><view class="ic ic-s icw ic-chat" /></view>
        <text>{{busy ? '正在登录…' : '微信一键登录'}}</text>
      </view>

      <view class="au-alt" bindtap="onPhoneLogin">
        <text>手机号登录</text>
        <text class="em">个人主体无法获取手机号，当前版本未开放</text>
      </view>
    </view>

    <view wx:else>
      <view class="au-t">{{portal === 'management' ? '管理端工作人员登录' : '维修端工作人员登录'}}</view>
      <view class="staff-form">
        <view class="staff-field">
          <text class="staff-label">工作人员账号</text>
          <input
            class="staff-input"
            value="{{username}}"
            placeholder="请输入账号"
            maxlength="30"
            bindinput="onUsernameInput"
          />
        </view>
        <view class="staff-field">
          <text class="staff-label">密码</text>
          <input
            class="staff-input"
            value="{{password}}"
            password
            placeholder="请输入密码"
            maxlength="64"
            confirm-type="done"
            bindinput="onPasswordInput"
            bindconfirm="onStaffLogin"
          />
        </view>
      </view>
      <view class="au-btn {{staffBusy ? 'busy' : ''}} {{agree ? '' : 'off'}}" hover-class="au-btn--hover" bindtap="onStaffLogin">
        <view class="au-wx"><view class="ic ic-s icw ic-home" /></view>
        <text>{{staffBusy ? '正在登录…' : '账号密码登录'}}</text>
      </view>
      <view class="au-alt">
        <text>工作人员账号由社区超级管理员创建</text>
        <text class="em">首次登录需修改初始密码；连续失败 5 次锁定 15 分钟</text>
      </view>
    </view>

    <view class="ckb {{agree ? 'on' : ''}}" bindtap="onToggleAgree">
      <view class="box"><text wx:if="{{agree}}" class="tick">✓</text></view>
      <view class="ckb__t">我已阅读并同意
        <text class="lnk" data-kind="user" catchtap="onOpenDoc">《用户协议》</text>
        和
        <text class="lnk" data-kind="privacy" catchtap="onOpenDoc">《隐私政策》</text>
      </view>
    </view>

    <view class="au-tip">
      <view class="ic ic-s ic-lock" />
      <text>仅收集办事必需信息；工作人员登录会记录账号、角色、登录时间与操作审计，不保存明文密码。</text>
    </view>
  </view>

  <view wx:if="{{portal === 'resident'}}" class="skip" bindtap="onSkip">先逛逛社区 ›</view>
  <view class="au-foot">{{appVersion}} · 阳光社区 · {{portal === 'resident' ? '居民服务' : '工作人员入口'}}</view>
</view>
