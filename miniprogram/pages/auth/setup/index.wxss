/* 首启资料设置页 */
.page.setup {
  min-height: 100vh;
  background: var(--bg);
}

/* 顶部：状态栏 + 标题行，沿用胶囊让位/白线规则 */
.setup-hd {
  background: var(--brand-gradient);
  color: #fff;
  padding: 0 28rpx 96rpx;
}

.setup-nav {
  box-sizing: border-box;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.55);
}

.setup-nav__t {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.6rpx;
}

.setup-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 28rpx;
}

.setup-ava {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  overflow: visible;
  box-shadow: 0 12rpx 36rpx rgba(8, 26, 64, 0.24);
}
.setup-ava::after { border: none; }

.setup-ava__img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.setup-ava__t {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
}

.setup-ava__cam {
  position: absolute;
  right: 0;
  bottom: 2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--brand);
}

.setup-hero__t {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
}

.setup-hero__s {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* 白色表单卡：向上叠在蓝色头部上 */
.setup-body {
  margin-top: -52rpx;
  padding: 0 28rpx calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 2;
}

.setup-card {
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
}

.setup-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  border-bottom: 2rpx solid var(--line);
}

.setup-field--col {
  display: block;
  padding: 24rpx 0;
}

.setup-lb {
  width: 100rpx;
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-1);
}

.setup-lb-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.setup-lb-tip {
  font-size: 19rpx;
  color: var(--text-3);
}

.setup-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--text-1);
}

.setup-ph {
  color: var(--text-3);
}

.setup-count {
  flex: none;
  font-size: 19rpx;
  color: var(--text-3);
}

.setup-loc {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-m);
  background: var(--brand-light);
}

.setup-loc--hover { opacity: 0.82; }

.setup-loc__ic {
  flex: none;
  color: var(--brand);
}

.setup-loc__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setup-loc__t {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-1);
}

.setup-loc__s {
  font-size: 19rpx;
  color: var(--text-3);
}

.setup-loc__ar {
  flex: none;
  font-size: 32rpx;
  color: var(--text-3);
}

.setup-agree {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx 0 8rpx;
}

.setup-box {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--text-3);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
}

.setup-box.is-on {
  background: var(--brand);
  border-color: var(--brand);
}

.setup-tick {
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.setup-agree__t {
  flex: 1;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--text-3);
}

.setup-lnk {
  color: var(--brand);
}

.setup-submit {
  margin-top: 20rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  border-radius: var(--radius-full);
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
}

.setup-submit::after { border: none; }

.setup-submit--hover {
  background: var(--brand-press);
}

.setup-submit.is-busy {
  opacity: 0.72;
}

.setup-skip {
  margin-top: 22rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}

.setup-foot {
  margin-top: 28rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--text-3);
}
