/* 社区地图 · 原生 map 适配 + 原型类覆盖（原型类见 styles/layout.wxss） */

.sbar__sig { font-size: 17rpx; color: var(--t3); }

/* 分类条/图例不再绝对定位压在地图上（原生 map 覆盖层层级不可控），改为地图上下常规流 */
.mapbar { position: static; left: auto; top: auto; padding: 14rpx 18rpx; background: #fff; gap: 12rpx; }
.mapbar .mc { height: 52rpx; padding: 0 20rpx; font-size: 20rpx; }

.tmap { display: block; width: 100%; height: 420rpx; }

.maplegend { position: static; right: auto; top: auto; display: flex; flex-wrap: wrap; gap: 10rpx 20rpx;
  margin: 0; padding: 12rpx 18rpx; background: #fff; border-radius: 0; box-shadow: none; }
.maplegend .lg { display: flex; align-items: center; gap: 6rpx; font-size: 17rpx; color: var(--t2); }
.maplegend .lgd { width: 12rpx; height: 12rpx; border-radius: 50%; }

/* 点位列表：图标填满色块、文字单行省略 */
.poi .pd .ic { width: 100%; height: 100%; border-radius: 0; color: inherit; }
.pi__m { flex: 1; min-width: 0; }
.pi__m .pn, .pi__m .ps { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pw__v { display: block; }
.pw__lb { display: block; font-weight: 400; color: var(--t3); }

.st--poi { margin-top: 16rpx; padding: 0 28rpx 10rpx; }

/* 原型 `.st b / .st em` 是 HTML 元素选择器，小程序里 b/em 不可用，改类名继承同款样式 */
.st__t { font-size: 28rpx; font-weight: 800; flex: 1; }
.st__d { font-style: normal; font-size: 19rpx; color: var(--t3); }

/* 选中点位详情（替代原型 poiSheet） */
.mapd { padding: 22rpx 24rpx; }
.mapd__h { display: flex; align-items: center; gap: 16rpx; }
.mapd__i { width: 64rpx; height: 64rpx; border-radius: 18rpx; display: flex; align-items: center;
  justify-content: center; flex: none; }
.mapd__i .ic { width: 100%; height: 100%; border-radius: 0; color: inherit; }
.mapd__m { flex: 1; min-width: 0; }
.mapd__n { font-size: 26rpx; font-weight: 800; }
.mapd__d { margin-top: 4rpx; font-size: 19rpx; color: var(--t3); }
.mapd__x { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--t3); flex: none; }

.mapd__rows { margin-top: 16rpx; padding-top: 14rpx; border-top: 1px dashed var(--line); }
.mapd__row { display: flex; justify-content: space-between; gap: 16rpx; font-size: 20rpx;
  line-height: 1.9; color: var(--t2); }
.mapd__k { color: var(--t3); flex: none; }

.mapd__btn { margin-top: 16rpx; height: 76rpx; border-radius: 16rpx; background: var(--blue);
  color: #fff; font-size: 25rpx; font-weight: 800; display: flex; align-items: center;
  justify-content: center; }

.aifoot__n { display: block; }

.hv { opacity: 0.72; }
