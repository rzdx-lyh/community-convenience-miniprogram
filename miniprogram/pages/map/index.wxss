/* 社区地图 · 原生 map 适配 + 地图/列表双视图 */

.sbar__sig { font-size: calc(17rpx * var(--care-scale, 1)); color: var(--t3); }

/* 地图/列表分段开关 */
.view-switch {
  display: flex;
  gap: 10rpx;
  margin: 20rpx 28rpx 0;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #EEE8DD;
}
.view-switch__item {
  flex: 1;
  min-height: 68rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--t2);
  font-size: calc(22rpx * var(--care-scale, 1));
  font-weight: 700;
}
.view-switch__item.on {
  color: var(--blue);
  background: var(--card);
  box-shadow: 0 4rpx 12rpx rgba(23,58,94, .12);
}

/* 分类条不再绝对定位压在地图上（原生 map 覆盖层层级不可控） */
.mapbar { position: static; left: auto; top: auto; padding: 14rpx 18rpx; background: var(--card); gap: 12rpx; flex-wrap: wrap; }
.mapbar .mc { height: 52rpx; padding: 0 18rpx; font-size: calc(20rpx * var(--care-scale, 1)); flex: none; }

.tmap { display: block; width: 100%; height: 520rpx; }

.maplegend { position: static; right: auto; top: auto; display: flex; flex-wrap: wrap; gap: 10rpx 20rpx;
  margin: 0; padding: 12rpx 18rpx; background: var(--card); border-radius: 0; box-shadow: none; }
.maplegend .lg { display: flex; align-items: center; gap: 6rpx; font-size: calc(17rpx * var(--care-scale, 1)); color: var(--t2); }
.maplegend .lgd { width: 12rpx; height: 12rpx; border-radius: 50%; flex: none; }

.map-actions { display: flex; flex-wrap: wrap; gap: 14rpx; padding: 14rpx 18rpx 18rpx; background: var(--card); }
.map-action { flex: 1; min-height: 72rpx; border-radius: 14rpx; border: 2rpx solid var(--line);
  display: flex; align-items: center; justify-content: center; color: var(--t2); font-size: calc(21rpx * var(--care-scale, 1)); font-weight: 700; }
.map-action--main { flex: 1 1 100%; border-color: var(--blue); color: var(--blue); background: var(--brand-light); }
.map-actions .map-action:not(.map-action--main) { flex: 1 1 calc(50% - 7rpx); }

/* 点位列表：图标填满色块、关键信息不截断 */
.poi .pd .ic { width: 100%; height: 100%; border-radius: 0; color: inherit; }
.pi__m { flex: 1; min-width: 0; }
.pi__m .pn { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pi__m .ps { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pw__v { display: block; }
.pw__lb { display: block; font-weight: 400; color: var(--t3); }

.pmeta { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; margin-top: 8rpx; }
.pmeta__walk { font-size: calc(18rpx * var(--care-scale, 1)); color: var(--t3); }

.pstatus { display: inline-flex; align-items: center; min-height: 38rpx; padding: 0 12rpx;
  border-radius: 999rpx; font-size: calc(17rpx * var(--care-scale, 1)); font-weight: 700; }
.pstatus--ok { color: #0F625B; background: #E4F3EE; }
.pstatus--busy { color: #9A531F; background: #F8E8D8; }
.pstatus--off { color: #7A8596; background: #EEF1F5; }

.st--poi { margin-top: 16rpx; padding: 0 28rpx 10rpx; }

/* 原型 `.st b / .st em` 是 HTML 元素选择器，小程序里 b/em 不可用，改类名继承同款样式 */
.st__t { font-size: calc(28rpx * var(--care-scale, 1)); font-weight: 800; flex: 1; }
.st__d { font-style: normal; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); text-align: right; }

/* 选中点位详情（替代原型 poiSheet） */
.mapd { padding: 22rpx 24rpx; }
.mapd__h { display: flex; align-items: center; gap: 16rpx; }
.mapd__i { width: 64rpx; height: 64rpx; border-radius: 18rpx; display: flex; align-items: center;
  justify-content: center; flex: none; }
.mapd__i .ic { width: 100%; height: 100%; border-radius: 0; color: inherit; }
.mapd__m { flex: 1; min-width: 0; }
.mapd__n { font-size: calc(26rpx * var(--care-scale, 1)); font-weight: 800; }
.mapd__d { margin-top: 4rpx; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); }
.mapd__x { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  font-size: calc(26rpx * var(--care-scale, 1)); color: var(--t3); flex: none; }

.mapd__rows { margin-top: 16rpx; padding-top: 14rpx; border-top: 1px dashed var(--line); }
.mapd__row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; font-size: calc(20rpx * var(--care-scale, 1));
  line-height: 1.9; color: var(--t2); }
.mapd__k { color: var(--t3); flex: none; }

.mapd__btn { margin-top: 16rpx; min-height: 76rpx; border-radius: 16rpx; background: var(--blue);
  color: #fff; font-size: calc(25rpx * var(--care-scale, 1)); font-weight: 800; display: flex; align-items: center;
  justify-content: center; }

.aifoot__n { display: block; }

.hv { opacity: 0.72; }

/* 关怀模式：所有筛选项等宽、操作按钮单列，列表改为稳定两列布局 */
.care-mode .view-switch {
  padding: 10rpx;
  gap: 12rpx;
}
.care-mode .view-switch__item {
  min-height: 88rpx;
  padding: 8rpx 10rpx;
  line-height: 1.3;
}
.care-mode .mapbar {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 18rpx;
}
.care-mode .mapbar .mc {
  width: 100%;
  min-width: 0;
  min-height: 80rpx;
  height: auto;
  padding: 10rpx 12rpx;
  justify-content: center;
  text-align: center;
  white-space: normal;
  line-height: 1.3;
  box-sizing: border-box;
}
.care-mode .mapbar .mc:last-child {
  grid-column: 1 / -1;
}
.care-mode .tmap {
  height: 620rpx;
}
.care-mode .maplegend {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx 18rpx;
  padding: 16rpx 18rpx;
}
.care-mode .maplegend .lg {
  min-width: 0;
}
.care-mode .map-actions {
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 18rpx 20rpx;
}
.care-mode .map-action {
  width: 100%;
  min-height: 88rpx;
  padding: 10rpx 14rpx;
  box-sizing: border-box;
  text-align: center;
  line-height: 1.3;
}
.care-mode .mapd__h {
  align-items: flex-start;
}
.care-mode .mapd__m {
  padding-top: 2rpx;
}
.care-mode .mapd__n,
.care-mode .mapd__d {
  white-space: normal;
  overflow-wrap: anywhere;
}
.care-mode .mapd__x {
  width: 72rpx;
  min-height: 72rpx;
}
.care-mode .mapd__row {
  align-items: flex-start;
  flex-wrap: wrap;
  line-height: 1.55;
}
.care-mode .mapd__row > text:last-child {
  flex: 1;
  min-width: 0;
  text-align: right;
  overflow-wrap: anywhere;
}
.care-mode .mapd__btn {
  min-height: 96rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  text-align: center;
}
.care-mode .st--poi {
  align-items: flex-start;
}
.care-mode .st--poi .st__t {
  flex: 1 1 100%;
}
.care-mode .st--poi .st__d {
  max-width: 100%;
  text-align: left;
}
.care-mode .poi {
  padding: 8rpx 24rpx;
}
.care-mode .pi {
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr);
  column-gap: 18rpx;
  row-gap: 8rpx;
  align-items: start;
  padding: 24rpx 0;
  box-sizing: border-box;
}
.care-mode .pi .pd {
  grid-column: 1;
  grid-row: 1 / span 2;
  width: 64rpx;
  height: 64rpx;
}
.care-mode .pi__m {
  grid-column: 2;
  grid-row: 1;
  width: auto;
}
.care-mode .pi .pw {
  grid-column: 2;
  grid-row: 2;
  margin-left: 0;
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  gap: 10rpx;
  text-align: left;
}
.care-mode .pi .pw__v,
.care-mode .pi .pw__lb {
  display: inline;
}
.care-mode .pi__m .pn,
.care-mode .pi__m .ps {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
}
.care-mode .pmeta {
  align-items: flex-start;
}

/* ===== 地图页 · 暖纸社区视觉 ===== */
.view-switch {
  background: #ECE4D7;
  border: 1rpx solid rgba(89, 74, 58, .08);
}
.view-switch__item { color: var(--text-2); }
.view-switch__item.on {
  color: var(--brand);
  background: #FFFDF8;
  box-shadow: 0 6rpx 16rpx rgba(46, 54, 64, .08);
}
.mapcard {
  margin: 20rpx 24rpx 0;
  border-radius: 30rpx;
  border: 1rpx solid rgba(89, 74, 58, .10);
  box-shadow: 0 16rpx 38rpx rgba(46, 54, 64, .10);
  overflow: hidden;
  background: var(--card);
}
.mapbar { background: #FFFDF8; border-bottom: 1rpx solid var(--line); }
.mapbar .mc {
  background: #F4EEE4;
  box-shadow: none;
  color: var(--text-2);
}
.mapbar .mc.on {
  background: var(--brand);
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(23, 58, 94, .18);
}
.maplegend { background: #FFFDF8; border-top: 1rpx solid var(--line); }
.map-actions { background: #FFFDF8; }
.map-action {
  border-color: rgba(89, 74, 58, .14);
  color: var(--text-2);
  background: #FFFDF8;
}
.map-action--main {
  border-color: var(--brand);
  color: #fff;
  background: var(--brand);
  box-shadow: 0 8rpx 18rpx rgba(23, 58, 94, .16);
}
.tip {
  margin: 18rpx 28rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 252, 245, .72);
  border: 1rpx dashed var(--line);
  color: var(--text-3);
}
.poi {
  border: 1rpx solid rgba(89, 74, 58, .08);
  box-shadow: var(--shadow-card);
}
.poi .pi { border-bottom-color: var(--line); }
.mapd {
  border: 1rpx solid rgba(89, 74, 58, .08);
  box-shadow: var(--shadow-card);
}
.mapd__btn { background: var(--brand); }
.pstatus--ok { background: var(--green-light); }
.pstatus--busy { background: var(--accent-warm-light); color: var(--accent-warm); }
