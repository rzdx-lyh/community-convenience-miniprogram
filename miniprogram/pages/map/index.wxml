<!-- 社区地图（CR-028 新建 · 原生 map 组件替代原型 GL JS） -->
<view class="page">
  <view class="sbar dark" style="padding-top:{{statusBarHeight}}px">
    <text>社区地图</text>
    <text class="sbar__sig">{{locState === 'ok' ? '已定位' : locState === 'locating' ? '定位中' : '未授权'}}</text>
  </view>

  <view class="nav">
    <view class="bk" bindtap="goBack"><text>‹</text></view>
    <text>社区地图</text>
    <view class="rt" bindtap="onRelocate">{{locState === 'ok' ? '重新定位' : '定位'}}</view>
  </view>

  <!-- 地图卡：分类条 + 原生地图 + 图例 -->
  <view class="mapcard">
    <view class="mapbar">
      <view
        wx:for="{{cats}}"
        wx:key="k"
        class="mc {{cat === item.k ? 'on' : ''}}"
        data-k="{{item.k}}"
        bindtap="onCatTap"
      ><text>{{item.n}}</text></view>
    </view>

    <map
      id="tmap"
      class="tmap"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      show-location
      enable-zoom
      enable-scroll
      bindmarkertap="onMarkerTap"
    ></map>

    <view class="maplegend">
      <view class="lg"><view class="lgd" style="background:#1F5FD6"></view><text>服务点</text></view>
      <view class="lg"><view class="lgd" style="background:#0E7C6B"></view><text>便民设备</text></view>
      <view class="lg"><view class="lgd" style="background:#A86A05"></view><text>生活配套</text></view>
      <view class="lg"><view class="lgd" style="background:#C9302C"></view><text>我的位置</text></view>
    </view>
  </view>

  <view wx:if="{{locState === 'denied'}}" class="tip">
    未获取到定位权限，已显示社区中心位置。可在右上角「定位」重试，或到「设置 → 位置信息」开启授权。
  </view>
  <view wx:if="{{locState === 'locating'}}" class="tip blue">正在获取当前位置…</view>

  <!-- 选中点位详情（替代原型底部弹层） -->
  <view wx:if="{{selected}}" class="blk mapd">
    <view class="mapd__h">
      <view class="mapd__i" style="background:{{selected.bg}};color:{{selected.color}}">
        <view class="ic ic-m {{selected.icon}}"></view>
      </view>
      <view class="mapd__m">
        <view class="mapd__n">{{selected.name}}</view>
        <view class="mapd__d">{{selected.desc}}</view>
      </view>
      <view class="mapd__x" bindtap="onClosePoi"><text>✕</text></view>
    </view>
    <view class="mapd__rows">
      <view class="mapd__row"><text class="mapd__k">距离</text><text>{{selected.walk}} · 步行约 {{selected.walkMin}} 分钟</text></view>
      <view class="mapd__row"><text class="mapd__k">开放时间</text><text>{{selected.open}}</text></view>
    </view>
    <view class="mapd__btn" bindtap="onOpenLocation"><text>打开地图导航</text></view>
  </view>

  <view class="st st--poi">
    <view class="st__t">附近 {{points.length}} 个点位</view>
    <text class="st__d">按步行距离排序</text>
  </view>

  <view class="poi">
    <view
      wx:for="{{points}}"
      wx:key="id"
      class="pi"
      data-id="{{item.id}}"
      bindtap="onPoiTap"
      hover-class="hv"
    >
      <view class="pd" style="background:{{item.bg}};color:{{item.color}}">
        <view class="ic ic-m {{item.icon}}"></view>
      </view>
      <view class="pi__m">
        <view class="pn">{{item.name}}</view>
        <view class="ps">{{item.desc}} · {{item.open}}</view>
      </view>
      <view class="pw">
        <text class="pw__v">{{item.walk}}</text>
        <text class="pw__lb">步行</text>
      </view>
    </view>
  </view>

  <view wx:if="{{points.length === 0}}" class="empty">该分类暂无点位</view>

  <view class="aifoot">
    坐标采用 GCJ-02 火星坐标系，底图由微信原生地图提供。
    <text class="aifoot__n">位置仅用于就近匹配，不保存轨迹、不对其他居民展示。</text>
  </view>
</view>
