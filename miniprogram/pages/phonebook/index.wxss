/* 便民电话簿（FE-7）· 全部取 Design Token v1.1 */
.page {
  min-height: 100vh;
  padding-bottom: var(--space-6);
  background: var(--bg);
}

/* 分类 Tab */
.tabs {
  display: flex;
  padding: var(--space-3) var(--space-4);
  gap: var(--space-2);
  background: var(--card);
  border-bottom: 2rpx solid var(--line);
  overflow-x: auto;
  white-space: nowrap;
}
.tab {
  height: 64rpx;
  padding: 0 var(--space-3);
  border-radius: var(--radius-full);
  border: 2rpx solid var(--line);
  font-size: var(--font-sub);
  color: var(--text-2);
  display: inline-flex;
  align-items: center;
  flex: none;
}
.tab-on {
  background: var(--brand-light);
  border-color: var(--brand);
  color: var(--brand);
  font-weight: 600;
}

/* 搜索 */
.search {
  display: flex;
  align-items: center;
  margin: var(--space-3) var(--space-4) 0;
  padding: 0 var(--space-3);
  height: 80rpx;
  border-radius: var(--radius-full);
  background: var(--card);
  box-shadow: var(--shadow-card);
}
.search-input {
  flex: 1;
  height: 80rpx;
  font-size: var(--font-sub);
  color: var(--text-1);
}
.search-ph {
  color: var(--text-3);
}
.search-clear {
  font-size: var(--font-card);
  color: var(--text-3);
  padding-left: var(--space-2);
}

/* 分组 */
.groups {
  padding: var(--space-3) var(--space-4);
}
.group {
  margin-bottom: var(--space-4);
}
.group-head {
  padding: 0 var(--space-1) var(--space-2);
}
.group-title {
  font-size: var(--font-sub);
  font-weight: 700;
  color: var(--text-3);
}

/* 号码行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-2);
}
.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.row-name {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--text-1);
}
.row-remark {
  margin-top: 4rpx;
  font-size: var(--font-cap);
  color: var(--text-3);
}
.row-right {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: var(--space-3);
}
/* 公共服务号码不脱敏，完整可见（110/119/120 等短号同样原样展示） */
.row-phone {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--brand);
}
.row-call {
  margin-left: var(--space-3);
  padding: 0 var(--space-3);
  height: 56rpx;
  border-radius: var(--radius-full);
  background: var(--brand-light);
  color: var(--brand);
  font-size: var(--font-cap);
  font-weight: 700;
  display: flex;
  align-items: center;
}

.loading {
  padding: var(--space-6);
  text-align: center;
}
.loading-text {
  font-size: var(--font-cap);
  color: var(--text-3);
}

.foot {
  display: block;
  padding: 0 var(--space-4) var(--space-4);
  font-size: var(--font-cap);
  color: var(--text-3);
  text-align: center;
}

/* 关怀模式 */
.care-mode .row-name {
  font-size: var(--font-card);
}
.care-mode .row-phone {
  font-size: var(--font-card);
}
.care-mode .row-call {
  height: 72rpx;
}
