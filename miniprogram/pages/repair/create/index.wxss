/* 我要报修（FE-3）· 全部取 Design Token v1.1 */
.page {
  min-height: 100vh;
  padding: var(--space-3) var(--space-4) 200rpx;
  background: var(--bg);
}
.block {
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}
.block-title {
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--text-1);
}
.required {
  color: var(--urgent);
}

/* 分类宫格 */
.cats {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.cat {
  height: 80rpx;
  padding: 0 var(--space-4);
  border-radius: var(--radius-m);
  border: 2rpx solid var(--line);
  background: var(--card);
  display: flex;
  align-items: center;
}
.cat-on {
  background: var(--brand-light);
  border-color: var(--brand);
}
.cat-text {
  font-size: var(--font-sub);
  color: var(--text-1);
}
.cat-on .cat-text {
  color: var(--brand);
  font-weight: 600;
}

/* 输入 */
.input,
.textarea {
  width: 100%;
  margin-top: var(--space-3);
  padding: var(--space-3);
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-m);
  font-size: var(--font-body);
  background: var(--card);
}

/* ⚠ 原生 <input> 默认高度很小，只加 padding 会把文字/placeholder 压到裁切
   （2026-10-22 用户截图「如：卫生间水管漏水」上下截断）。
   明确高度 + 只留左右内边距，原生组件会在高度内自动垂直居中。 */
.input {
  height: 88rpx;
  padding: 0 var(--space-3);
}
.textarea {
  min-height: 160rpx;
}
.input-ph {
  color: var(--text-3);
}
.counter {
  display: block;
  margin-top: var(--space-1);
  text-align: right;
  font-size: var(--font-cap);
  color: var(--text-3);
}

/* 图片 */
.imgs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.img-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-m);
}
.img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-del-text {
  color: #ffffff;
  font-size: 28rpx;
}
.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-m);
  border: 2rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add-text {
  font-size: var(--font-cap);
  color: var(--text-3);
}

/* 提交 */
.footer {
  padding: var(--space-3) 0;
}
.submit {
  height: 96rpx;
  border-radius: var(--radius-m);
  background: var(--brand-gradient);
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-off {
  opacity: 0.5;
}
.submit-text {
  font-size: var(--font-btn);
  font-weight: 700;
  color: #ffffff;
}
.tip {
  display: block;
  margin-top: var(--space-2);
  text-align: center;
  font-size: var(--font-cap);
  color: var(--text-3);
}

/* 关怀模式 */
.care-mode .submit {
  height: 110rpx;
}
.care-mode .cat {
  height: 96rpx;
}

/* 返回条 v2（2026-10-22）：弃用悬浮胶囊按钮，改用全站标准 .nav 栏——
   ‹ 返回 + ⌂ 回主页 两个左置圆钮，标题居中，与其它页面视觉一致 */
.homebtn {
  position: absolute;
  left: 92rpx;
  top: 0;
  height: 86rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: 34rpx;
  color: var(--text-1);
  font-weight: 600;
}
.tb-hv { opacity: 0.72; }
