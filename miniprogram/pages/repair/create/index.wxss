/* 我要报修（FE-3）· 全部取 Design Token v1.1 */
.page {
  min-height: 100vh;
  padding: var(--space-3) var(--space-4) 200rpx;
  background: var(--bg);
}
.block {
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}
.block-title {
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--text-1);
}
.required {
  color: var(--urgent);
}

/* 分类宫格 */
.cats {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.cat {
  height: 80rpx;
  padding: 0 var(--space-4);
  border-radius: var(--radius-m);
  border: 2rpx solid var(--line);
  background: var(--card);
  display: flex;
  align-items: center;
}
.cat-on {
  background: var(--brand-light);
  border-color: var(--brand);
}
.cat-text {
  font-size: var(--font-sub);
  color: var(--text-1);
}
.cat-on .cat-text {
  color: var(--brand);
  font-weight: 600;
}

/* 输入 */
.input,
.textarea {
  width: 100%;
  margin-top: var(--space-3);
  padding: var(--space-3);
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-m);
  font-size: var(--font-body);
  background: var(--card);
}

/* ⚠ 原生 <input> 默认高度很小，只加 padding 会把文字/placeholder 压到裁切
   （2026-10-22 用户截图「如：卫生间水管漏水」上下截断）。
   明确高度 + 只留左右内边距，原生组件会在高度内自动垂直居中。 */
.input {
  height: 88rpx;
  padding: 0 var(--space-3);
}
.textarea {
  min-height: 160rpx;
}
.input-ph {
  color: var(--text-3);
}
.counter {
  display: block;
  margin-top: var(--space-1);
  text-align: right;
  font-size: var(--font-cap);
  color: var(--text-3);
}

/* 图片 */
.imgs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.img-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-m);
}
.img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-del-text {
  color: #ffffff;
  font-size: calc(28rpx * var(--care-scale, 1));
}
.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-m);
  border: 2rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add-text {
  font-size: var(--font-cap);
  color: var(--text-3);
}

/* 提交 */
.footer {
  padding: var(--space-3) 0;
}
.submit {
  height: 96rpx;
  border-radius: var(--radius-m);
  background: var(--brand-gradient);
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-off {
  opacity: 0.5;
}
.submit-text {
  font-size: var(--font-btn);
  font-weight: 700;
  color: #ffffff;
}
.tip {
  display: block;
  margin-top: var(--space-2);
  text-align: center;
  font-size: var(--font-cap);
  color: var(--text-3);
}

/* 关怀模式 */
.care-mode .submit {
  height: 110rpx;
}
.care-mode .cat {
  height: 96rpx;
}

/* 返回条 v2（2026-10-22）：弃用悬浮胶囊按钮，改用全站标准 .nav 栏——
   ‹ 返回 + ⌂ 回主页 两个左置圆钮，标题居中，与其它页面视觉一致 */
.homebtn {
  position: absolute;
  left: 92rpx;
  top: 0;
  height: 86rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: calc(34rpx * var(--care-scale, 1));
  color: var(--text-1);
  font-weight: 600;
}
.tb-hv { opacity: 0.72; }

/* ===== 报修位置（下一阶段阶段 2） ===== */
.loc-card {
  border: 2rpx solid var(--line);
  border-radius: var(--radius-m);
  background: #fff;
  overflow: hidden;
}
.loc-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
}
.loc-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--brand-light);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.loc-m { flex: 1; min-width: 0; }
.loc-name { display: block; font-size: var(--font-body); font-weight: 700; }
.loc-desc { display: block; margin-top: 4rpx; font-size: var(--font-cap); color: var(--text-2); }
.loc-actions {
  display: flex;
  gap: 12rpx;
  padding: 0 20rpx 20rpx;
}
.loc-btn {
  flex: 1;
  min-height: 72rpx;
  border-radius: var(--radius-m);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sub);
  color: var(--text-2);
  font-weight: 700;
}
.loc-btn--main {
  border-color: var(--brand);
  background: var(--brand-light);
  color: var(--brand);
}

.spot-picker {
  margin-top: 16rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-m);
  overflow: hidden;
  background: #fff;
}
.spot-map { width: 100%; height: 420rpx; display: block; }
.spot-list { padding: 4rpx 20rpx; }
.spot-item {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--line);
}
.spot-item:last-child { border-bottom: 0; }
.spot-item.on { color: var(--brand); }
.spot-item__m { flex: 1; min-width: 0; }
.spot-item__n { display: block; font-size: var(--font-body); font-weight: 700; }
.spot-item__d { display: block; margin-top: 2rpx; font-size: var(--font-cap); color: var(--text-3); }
.spot-item__s { flex: none; font-size: var(--font-cap); font-weight: 700; color: var(--brand); }
.spot-close {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  color: var(--text-2);
  font-size: var(--font-sub);
  font-weight: 700;
}

.care-mode .loc-btn,
.care-mode .spot-item,
.care-mode .spot-close { min-height: 96rpx; }
.care-mode .spot-map { height: 520rpx; }

/* 关怀模式下位置操作按钮单列，避免长文案被挤压 */
.care-mode .loc-actions {
  flex-direction: column;
}
.care-mode .loc-btn {
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 10rpx 14rpx;
  text-align: center;
  line-height: 1.3;
}

/* 关怀模式下为返回 + 回主页双按钮留出标题空间 */
.care-mode .nav {
  padding-left: 156rpx;
}
.care-mode .homebtn {
  top: 0;
  bottom: 0;
  height: auto;
  min-height: 104rpx;
  box-sizing: border-box;
}

/* AI 识图辅助 */
.ai-img-btn {
  min-height: 82rpx;
  border-radius: var(--radius-m);
  background: var(--brand-light);
  color: var(--brand);
  border: 2rpx solid rgba(31, 95, 214, .24);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: var(--font-sub);
  font-weight: 800;
}
.ai-img-btn.off { opacity: .55; }
.ai-result {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: var(--radius-m);
  background: #F7FAFF;
  border-left: 6rpx solid var(--brand);
}
.ai-result__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-3);
  font-size: var(--font-cap);
}
.ai-result__badge {
  min-height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
}
.ai-result__title {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-body);
  font-weight: 800;
}
.ai-result__desc,
.ai-result__tip {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sub);
  color: var(--text-2);
  line-height: 1.6;
}
.ai-result__tip { color: var(--warning); }
.ai-reason {
  margin-top: 12rpx;
  color: var(--warning);
  font-size: var(--font-cap);
  line-height: 1.5;
}
.care-mode .ai-img-btn { min-height: 96rpx; }
