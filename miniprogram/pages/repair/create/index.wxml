<!-- 我要报修（FE-3）· 单页表单（老人友好，不做分步向导） -->
<view class="page {{elderMode ? 'care-mode' : ''}}">
  <!-- 标准导航栏（与全站 .nav 一致）：‹ 返回 + ⌂ 回主页 + 居中标题；
       sbar 仅作状态栏占位（文字已被全局隐藏），padding-top 避开系统状态栏 -->
  <view class="sbar" style="padding-top:{{statusBarHeight}}px"></view>
  <view class="nav">
    <view class="bk" hover-class="tb-hv" bindtap="goBack"><text>‹</text></view>
    <view class="homebtn" hover-class="tb-hv" bindtap="goHome"><text>⌂</text></view>
    <text>我要报修</text>
  </view>

  <!-- 报修类型（单选，必选） -->
  <view class="block">
    <text class="block-title">报修类型 <text class="required">*</text></text>
    <view class="cats">
      <block wx:for="{{categories}}" wx:key="key">
        <view class="cat {{item.key === category ? 'cat-on' : ''}}" data-key="{{item.key}}" bindtap="onPickCategory">
          <text class="cat-text">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 标题 -->
  <view class="block">
    <text class="block-title">问题标题 <text class="required">*</text></text>
    <input
      class="input"
      value="{{title}}"
      placeholder="如：卫生间水管漏水"
      placeholder-class="input-ph"
      maxlength="30"
      bindinput="onTitleInput"
    />
  </view>

  <!-- 描述 -->
  <view class="block">
    <text class="block-title">问题描述 <text class="required">*</text></text>
    <textarea
      class="textarea"
      value="{{description}}"
      placeholder="请描述问题，至少 5 个字（可说明位置、出现时间）"
      placeholder-class="input-ph"
      maxlength="200"
      bindinput="onDescInput"
    />
    <text class="counter">{{description.length}}/200</text>
  </view>

  <!-- 问题位置：使用当前手选楼栋，或在地图上选择社区点位；不读取手机定位 -->
  <view class="block">
    <text class="block-title">问题位置</text>
    <view class="loc-card">
      <view class="loc-main">
        <view class="loc-ic"><view class="ic ic-m ic-pin"></view></view>
        <view class="loc-m">
          <text class="loc-name">{{location.name || '未选择位置'}}</text>
          <text class="loc-desc">{{locationDesc || '请选择楼栋或社区点位'}}</text>
        </view>
      </view>
      <view class="loc-actions">
        <view class="loc-btn" bindtap="onUseCurrentSpot"><text>使用当前楼栋</text></view>
        <view class="loc-btn loc-btn--main" bindtap="onToggleSpotPicker"><text>{{spotPickerVisible ? '收起地图' : '在地图上选点'}}</text></view>
      </view>
    </view>

    <view wx:if="{{spotPickerVisible}}" class="spot-picker">
      <map
        class="spot-map"
        latitude="{{spotMapLat}}"
        longitude="{{spotMapLng}}"
        scale="18"
        markers="{{spotMarkers}}"
        enable-zoom
        enable-scroll
        bindmarkertap="onSpotMarkerTap"
      ></map>
      <view class="spot-list">
        <view
          wx:for="{{spots}}"
          wx:key="key"
          class="spot-item {{selectedSpotKey === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSpotListItemTap"
        >
          <view class="spot-item__m">
            <text class="spot-item__n">{{item.name}}</text>
            <text class="spot-item__d">{{item.desc}}</text>
          </view>
          <text class="spot-item__s">{{selectedSpotKey === item.key ? '已选' : '选择'}}</text>
        </view>
      </view>
      <view class="spot-close" bindtap="onCloseSpotPicker"><text>收起选点</text></view>
    </view>
  </view>

  <!-- CR-024：页面级 AI 入口（上下文 = 报修登记） -->
  <ai-bar page="repair-create" />

  <!-- 照片（选填） -->
  <view class="block">
    <text class="block-title">现场照片（选填，最多 {{maxImages}} 张）</text>
    <view class="imgs">
      <block wx:for="{{images}}" wx:key="*this">
        <view class="img-wrap">
          <image class="img" src="{{item}}" mode="aspectFill" />
          <view class="img-del" data-index="{{index}}" bindtap="onRemoveImage">
            <text class="img-del-text">×</text>
          </view>
        </view>
      </block>
      <view wx:if="{{images.length < maxImages}}" class="img-add" bindtap="onChooseImage">
        <text class="img-add-text">+ 拍照/相册</text>
      </view>
    </view>
  </view>

  <!-- 提交 -->
  <view class="footer">
    <view class="submit {{submitting ? 'submit-off' : ''}}" bindtap="onSubmit">
      <text class="submit-text">{{submitting ? '提交中…' : '提交报修'}}</text>
    </view>
    <text class="tip">提交后 AI 会自动生成工单摘要，方便物业快速处理</text>
  </view>
</view>
