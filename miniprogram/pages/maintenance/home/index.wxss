/* 维修端工作台 · 暖纸社区 */
.page.repair-wb {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}
.rw-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 34rpx;
  color: #fff;
  background: linear-gradient(145deg, #173A5E 0%, #147D70 72%, #245C73 100%);
  box-shadow: 0 20rpx 48rpx rgba(23, 58, 94, .20);
}
.rw-hero::before,
.rw-hero::after { content: ''; position: absolute; border-radius: 50%; background: rgba(255,255,255,.08); }
.rw-hero::before { width: 300rpx; height: 300rpx; right: -130rpx; top: -160rpx; }
.rw-hero::after { width: 180rpx; height: 180rpx; left: -100rpx; bottom: -110rpx; }
.rw-hero__top, .rw-greeting, .rw-subline, .rw-skills, .rw-loading { position: relative; z-index: 1; }
.rw-hero__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.rw-brand { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.rw-brand__mark { width: 74rpx; height: 74rpx; border-radius: 22rpx; flex: none; background: rgba(255,252,245,.96); color: var(--green); display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 900; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.12); }
.rw-brand__copy { display: flex; flex-direction: column; gap: 3rpx; min-width: 0; }
.rw-kicker { font-size: 16rpx; letter-spacing: 3rpx; opacity: .62; font-weight: 800; }
.rw-title { font-size: 38rpx; line-height: 1.2; font-weight: 900; }
.rw-online { min-height: 54rpx; padding: 0 16rpx; border-radius: 999rpx; flex: none; display: flex; align-items: center; gap: 8rpx; background: rgba(255,255,255,.12); border: 1rpx solid rgba(255,255,255,.18); font-size: 18rpx; font-weight: 800; }
.rw-online__dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #D9B08C; }
.rw-online.on .rw-online__dot { background: #8FE3B0; box-shadow: 0 0 0 6rpx rgba(143,227,176,.14); }
.rw-greeting { margin-top: 26rpx; font-size: 32rpx; font-weight: 900; }
.rw-subline { margin-top: 6rpx; font-size: 21rpx; color: rgba(255,255,255,.72); line-height: 1.5; }
.rw-loading { margin-top: 12rpx; font-size: 20rpx; color: rgba(255,255,255,.76); }
.rw-skills { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 18rpx; }
.rw-skill { padding: 6rpx 12rpx; border-radius: 999rpx; background: rgba(255,255,255,.12); border: 1rpx solid rgba(255,255,255,.16); font-size: 17rpx; font-weight: 700; }

.rw-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 16rpx; }
.rw-stat { padding: 20rpx 12rpx; border-radius: 22rpx; background: var(--card); border: 1rpx solid rgba(89,74,58,.08); box-shadow: var(--shadow-card); display: flex; flex-direction: column; align-items: center; gap: 3rpx; }
.rw-stat__n { font-size: 40rpx; line-height: 1; font-weight: 900; color: var(--brand); }
.rw-stat__n--green { color: var(--green); }
.rw-stat__n--warm { color: var(--accent-warm); }
.rw-stat__l { font-size: 18rpx; color: var(--text-3); }

.rw-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; padding: 32rpx 4rpx 14rpx; }
.rw-section-head--mine { margin-top: 8rpx; }
.rw-section-head > view { display: flex; flex-direction: column; gap: 3rpx; }
.rw-section-kicker { font-size: 15rpx; letter-spacing: 3rpx; color: var(--green); font-weight: 900; }
.rw-section-title { font-size: 30rpx; color: var(--text-1); font-weight: 900; }
.rw-section-note { font-size: 19rpx; color: var(--text-3); }

.rw-offline { display: flex; align-items: flex-start; gap: 14rpx; padding: 18rpx; border-radius: 20rpx; background: var(--accent-warm-light); color: var(--text-2); }
.rw-offline > view:last-child { display: flex; flex-direction: column; gap: 3rpx; }
.rw-offline text:first-child { font-size: 21rpx; font-weight: 800; color: var(--text-1); }
.rw-offline text:last-child { font-size: 18rpx; line-height: 1.5; }

.rw-list { display: flex; flex-direction: column; gap: 12rpx; }
.rw-card { padding: 20rpx; border-radius: 24rpx; background: var(--card); border: 1rpx solid rgba(89,74,58,.09); box-shadow: var(--shadow-card); }
.rw-card--queue { border-left: 6rpx solid var(--accent-warm); }
.rw-card__top, .rw-card__foot, .rw-card__main, .rw-card__meta { display: flex; align-items: center; }
.rw-card__top, .rw-card__foot { justify-content: space-between; gap: 14rpx; }
.rw-card__time { font-size: 18rpx; color: var(--text-3); }
.rw-status { padding: 6rpx 14rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; }
.rw-status--pending { color: #9A531F; background: var(--accent-warm-light); }
.rw-status--assigned { color: var(--brand); background: var(--brand-light); }
.rw-status--processing { color: var(--green); background: var(--green-light); }
.rw-status--done { color: #2F7D4C; background: #E8F1E8; }
.rw-status--off { color: var(--text-2); background: var(--bg); }
.rw-card__main { align-items: flex-start; gap: 16rpx; margin-top: 14rpx; }
.rw-card__copy { flex: 1; min-width: 0; }
.rw-card__title { display: block; font-size: 25rpx; font-weight: 900; color: var(--text-1); }
.rw-card__desc { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-top: 7rpx; font-size: 20rpx; line-height: 1.55; color: var(--text-2); }
.rw-card__meta { flex-wrap: wrap; gap: 5rpx; margin-top: 9rpx; font-size: 17rpx; color: var(--text-3); }
.rw-card__cover { width: 112rpx; height: 112rpx; border-radius: 18rpx; flex: none; background: var(--bg); }
.rw-card__foot { margin-top: 15rpx; padding-top: 14rpx; border-top: 1rpx solid var(--line); }
.rw-link { font-size: 18rpx; color: var(--text-3); }
.rw-primary { min-height: 54rpx; padding: 0 20rpx; border-radius: 999rpx; background: var(--accent-warm); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 19rpx; font-weight: 800; }
.rw-primary--assigned { background: var(--brand); }
.rw-primary--processing { background: var(--green); }
.rw-done { font-size: 18rpx; color: #2F7D4C; font-weight: 800; }

.rw-empty { padding: 44rpx 24rpx; border-radius: 24rpx; background: var(--card); border: 1rpx solid rgba(89,74,58,.08); display: flex; flex-direction: column; align-items: center; gap: 8rpx; color: var(--text-2); font-size: 21rpx; }
.rw-empty__icon { width: 88rpx; height: 88rpx; border-radius: 28rpx; background: var(--green-light); color: var(--green); display: flex; align-items: center; justify-content: center; }
.rw-empty__t { font-size: 25rpx; font-weight: 800; color: var(--text-1); }
.rw-empty__d { font-size: 19rpx; color: var(--text-3); line-height: 1.5; }

.rw-account { display: flex; gap: 12rpx; margin-top: 30rpx; }
.rw-account__btn { flex: 1; min-height: 82rpx; border-radius: 22rpx; background: var(--card); border: 1rpx solid var(--line); color: var(--text-1); display: flex; align-items: center; justify-content: center; font-size: 21rpx; font-weight: 800; }
.rw-account__btn--danger { color: var(--urgent); border-color: var(--urgent-line); background: var(--urgent-bg); }

.rw-mask { position: fixed; inset: 0; z-index: 900; background: rgba(20,28,36,.52); display: flex; align-items: flex-end; }
.rw-sheet { width: 100%; max-height: 82vh; box-sizing: border-box; padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: var(--card); box-shadow: 0 -18rpx 48rpx rgba(20,28,36,.18); display: flex; flex-direction: column; }
.rw-sheet__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.rw-sheet__head > view:first-child { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.rw-sheet__k { font-size: 16rpx; letter-spacing: 2rpx; color: var(--green); font-weight: 900; }
.rw-sheet__t { font-size: 31rpx; line-height: 1.35; color: var(--text-1); font-weight: 900; }
.rw-sheet__close { width: 52rpx; height: 52rpx; border-radius: 50%; flex: none; background: var(--bg); color: var(--text-2); display: flex; align-items: center; justify-content: center; font-size: 34rpx; }
.rw-sheet__badges { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.rw-badge { padding: 6rpx 13rpx; border-radius: 999rpx; background: var(--bg); color: var(--text-2); font-size: 18rpx; }
.rw-sheet__scroll { max-height: 56vh; margin-top: 18rpx; }
.rw-sheet__desc { display: block; font-size: 22rpx; line-height: 1.7; color: var(--text-2); white-space: pre-wrap; }
.rw-sheet__images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 18rpx; }
.rw-sheet__img { width: 100%; height: 180rpx; border-radius: 18rpx; background: var(--bg); }
.rw-sheet__facts { margin-top: 18rpx; padding: 6rpx 18rpx; border-radius: 18rpx; background: var(--bg); }
.rw-sheet__facts view { display: flex; justify-content: space-between; gap: 20rpx; padding: 13rpx 0; border-bottom: 1rpx solid var(--line); }
.rw-sheet__facts view:last-child { border-bottom: 0; }
.rw-sheet__facts text:first-child { flex: none; font-size: 18rpx; color: var(--text-3); }
.rw-sheet__facts text:last-child { flex: 1; text-align: right; font-size: 19rpx; line-height: 1.5; color: var(--text-1); }
.rw-sheet__foot { display: flex; gap: 12rpx; margin-top: 20rpx; }
.rw-sheet__ghost, .rw-sheet__primary { flex: 1; min-height: 82rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800; }
.rw-sheet__ghost { background: var(--bg); color: var(--text-2); }
.rw-sheet__primary { background: var(--green); color: #fff; }

.care-mode .rw-hero__top,
.care-mode .rw-card__main,
.care-mode .rw-account { flex-direction: column; align-items: stretch; }
.care-mode .rw-stats { grid-template-columns: 1fr; }
.care-mode .rw-online { align-self: flex-start; }
.care-mode .rw-card__cover { width: 100%; height: 240rpx; }
.care-mode .rw-sheet__images { grid-template-columns: 1fr 1fr; }