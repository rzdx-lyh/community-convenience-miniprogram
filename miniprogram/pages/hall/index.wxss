/* 办事大厅补充样式 */

/* 恢复图标尺寸档（layout 的 .ic 覆盖了 icons 的 .ic-s/.ic-m） */
.ic.ic-s { width: 32rpx; height: 32rpx; }
.ic.ic-m { width: 40rpx; height: 40rpx; }

.hover-dim { opacity: .86; }

.nav--flat { border-bottom: 0; }

.hall-search { background: var(--card); padding: 0 24rpx 20rpx; }
.sbox--flat { background: #F4EFE6; border: 1px solid var(--line); }
.sbox .s-ic { opacity: .55; }

/* 原型用 HTML 标签选择器（b/p），换成类名后补排版 */
.st .b { font-size: calc(28rpx * var(--care-scale, 1)); font-weight: 800; flex: 1; }
.st .em { font-style: normal; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); }

.gh .b { font-size: calc(25rpx * var(--care-scale, 1)); font-weight: 800; display: flex; align-items: center; gap: 12rpx; }
.gh-bar { width: 5rpx; height: 22rpx; border-radius: 4rpx; background: var(--blue); flex: none; }
.gh .p { display: block; margin-top: 8rpx; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); line-height: 1.4; }

/* AI 集群卡文案 */
.aigc .h .b { font-size: calc(23rpx * var(--care-scale, 1)); font-weight: 800; }
.aigc .p { display: block; font-size: calc(18rpx * var(--care-scale, 1)); color: var(--t3); line-height: 1.5; }

/* 场景图标底色（原型为内联 color，这里用色板类） */
.tone-blue { background: #E8F0F2; }
.tone-red { background: #FAE8E3; }
.tone-teal { background: #E4F3EE; }
.tone-green { background: #E8F6EF; }
.tone-gold { background: #F8E8D8; }
.tone-indigo { background: #EEEAF6; }
.tone-cyan { background: #E4F5F8; }

/* 宫格图标底色（按分类主题） */
.th-blue .ic { background-color: #E8F0F2; }
.th-teal .ic { background-color: #E4F3EE; }
.th-gold .ic { background-color: #F8E8D8; }
.th-indigo .ic { background-color: #EEEAF6; }

/* 板块宫格内图标略小，四列才不挤 */
.grp .gi .ic { width: 72rpx; height: 72rpx; }

.hall-foot { height: 28rpx; }
