<!--
  首页 v1.2（FE-11 · 对照 docs/03-preview/index.html 1:1 实现）
  ⚠ 红线：绿色头部与下方内容在**同一滚动容器**（整页自然流）内做负边距叠压，
    不得把内容放进独立 overflow:auto 容器，否则通知卡顶部会被裁切。
-->
<view class="page {{elderMode ? 'care-mode' : ''}}">
  <!-- ========== 区域 1：政务蓝渐变头部（填满顶部，含状态栏） ========== -->
  <view class="header" style="padding-top: {{statusBarHeight}}px">
    <!-- 胶囊占位行：独占一行避让微信胶囊/灵动岛，社区定位放在它的下面 -->
    <view class="header__capsule-row">
      <view class="header__capsule" style="width: {{capsuleWidth}}px"></view>
    </view>

    <!-- 品牌行：logo + 服务名 + 定位 + 紧急求助 + 头像 -->
    <view class="brand">
      <view class="brand__logo">猎</view>
      <view class="brand__info">
        <view class="brand__name">猎奇便民服务</view>
        <view class="brand__loc"><view class="ic ic-s icw ic-pin"></view>{{communityName}}</view>
      </view>
      <view class="brand__urgent" hover-class="brand__urgent--hover" bindtap="onUrgentTap">
        <view class="ic ic-s ic-bolt"></view>
        <text>紧急</text>
      </view>
      <view class="brand__avatar" bindtap="onProfileTap">{{avatarText}}</view>
    </view>

    <!-- 搜索框（点击进办事大厅，完整检索在那里） -->
    <view class="search" hover-class="search--hover" bindtap="onSearchTap">
      <view class="ic ic-m ic-search"></view>
      <text class="search__ph">搜服务：保洁、助餐、雨伞、租…</text>
      <text class="search__go">搜索</text>
    </view>

    <!-- 4 个快捷入口 -->
    <view class="qk">
      <view
        wx:for="{{quick}}"
        wx:key="k"
        class="qk__i"
        hover-class="qk__i--hover"
        data-k="{{item.k}}"
        bindtap="onQuickTap"
      >
        <view class="qk__ico ic ic-l icw ic-{{item.i}}"></view>
        <text class="qk__tx">{{item.t}}</text>
      </view>
    </view>
  </view>

  <!-- ========== 区域 2~4：内容区（通知卡负边距压在头部下缘） ========== -->
  <view class="content">
    <!-- 白色通知卡 -->
    <view class="notice" bindtap="onNoticeTap">
      <view class="notice__main">
        <view class="notice__icon">
          <view wx:if="{{urgentState === 'empty'}}" class="ic ic-l ic-check-c"></view>
          <view wx:elif="{{urgentState === 'error'}}" class="ic ic-l ic-warn"></view>
          <view wx:else class="ic ic-l ic-file"></view>
        </view>
        <view class="notice__text">
          <view class="notice__title">{{urgentTitle}}</view>
          <view class="notice__sub">{{urgentSub}}</view>
        </view>
        <view class="notice__deco"></view>
      </view>

      <view wx:if="{{urgentState === 'error'}}" class="notice__retry" catchtap="onRetryUrgent">重试</view>
      <view wx:else class="notice__divider"></view>

      <!-- 快捷 pill -->
      <view class="pills">
        <view class="pill" catchtap="onNoticePillTap">
          <view class="ic ic-m ic-megaphone"></view>
          <text class="pill__text">本周公告</text>
        </view>
        <view class="pill" catchtap="onRoadPillTap">
          <view class="ic ic-m ic-cone"></view>
          <text class="pill__text">最近路况</text>
        </view>
      </view>
    </view>

    <!-- 服务分类（4 张竖卡：名称 + 板块 + 项数），对齐原型首页「服务分类」区 -->
    <view class="section">
      <view class="section__head">
        <view class="section__title section__title--inline">服务分类</view>
        <view class="section__more" catchtap="onHallMore">
          <text>全部</text>
          <text class="section__more-arrow">›</text>
        </view>
      </view>
      <view class="zq">
        <view
          wx:for="{{grid}}"
          wx:key="key"
          class="zqc"
          hover-class="zqc--hover"
          data-key="{{item.key}}"
          bindtap="onGridTap"
        >
          <view class="zqc__top">
            <text class="zqc__name">{{item.title}}</text>
            <text class="zqc__cnt">{{item.count}} 项</text>
          </view>
          <view class="zqc__sub">{{item.subLine1}} · {{item.subLine2}}</view>
          <text class="zqc__ar">›</text>
        </view>
      </view>
    </view>

    <!-- v1.0.1 / CR-019：AI 助手入口卡（首屏纵向补全 · 第 1 块） -->
    <view class="ai-entry" hover-class="ai-entry--hover" bindtap="onAiEntryTap">
      <view class="ai-entry__icon ic ic-l ic-robot"></view>
      <view class="ai-entry__body">
        <view class="ai-entry__title">AI 办事助手</view>
        <view class="ai-entry__sub">办事流程、报修缴费，一句话问清楚</view>
      </view>
      <view class="ai-entry__go">去问问</view>
    </view>

    <!-- v1.0.1 / CR-019：社区动态 3 条（首屏纵向补全 · 第 2 块；为空整块隐藏） -->
    <view wx:if="{{feed.length > 0}}" class="section">
      <view class="section__head">
        <view class="section__title section__title--inline">社区动态</view>
        <view class="section__more" catchtap="onMoreNotices">
          <text>全部</text>
          <text class="section__more-arrow">›</text>
        </view>
      </view>
      <view class="feed">
        <view
          wx:for="{{feed}}"
          wx:key="id"
          class="feed__item"
          hover-class="feed__item--hover"
          data-type="{{item.type}}"
          bindtap="onFeedTap"
        >
          <view class="feed__tag feed__tag--{{item.type}}">{{item.typeLabel}}</view>
          <view class="feed__body">
            <view class="feed__title">{{item.title}}</view>
            <view class="feed__meta">
              <text>{{item.meta}}</text>
              <view wx:if="{{item.location}}" class="feed__loc">
                <view class="ic ic-s ic-pin"></view>
                <text>{{item.location}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 紧急求助半屏弹层（设计预览 §4.2） ========== -->
  <view wx:if="{{showEmergency}}" class="mask" bindtap="closeEmergency">
    <view class="sheet" catchtap="noop">
      <view class="sheet__title">紧急求助</view>
      <view wx:for="{{contacts}}" wx:key="phone" class="sheet__row">
        <view class="sheet__info">
          <view class="sheet__name">{{item.name}}</view>
          <view wx:if="{{item.remark}}" class="sheet__remark">{{item.remark}}</view>
        </view>
        <view class="sheet__btn" hover-class="sheet__btn--hover" data-phone="{{item.phone}}" catchtap="onCallPhone">
          拨号
        </view>
      </view>
      <view class="sheet__footer">{{emergencyTip}}</view>
    </view>
  </view>
</view>
