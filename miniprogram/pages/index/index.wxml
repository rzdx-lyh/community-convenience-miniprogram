<!-- 首页（设计稿 pgHome v1.4） -->
<view class="page page--tab {{careMode ? 'care-mode' : ''}}">
  <!-- 渐变头部 -->
  <view class="hd">
    <view class="sbar light" style="padding-top:{{statusBarHeight}}px">
      <text>08:42</text>
      <text>●●● ▮</text>
    </view>

    <!-- padding-right 避开右上角微信胶囊按钮（2026-10-22：定位胶囊与胶囊按钮重叠） -->
    <view class="r1" style="padding-right:{{navRightPad}}px">
      <view class="lg">邻</view>
      <view class="nm">邻里百事通小助手</view>
      <view class="lb {{locState}}" bindtap="onLocTap">
        <view class="ic ic-s ic-pin icw" />
        <text class="tx">{{locText}}</text>
        <text class="ch">›</text>
      </view>
    </view>

    <view class="sbox">
      <view class="ic ic-s ic-search s-ic" />
      <input
        placeholder="搜服务：保洁、助餐、雨伞、租…"
        value="{{kw}}"
        confirm-type="search"
        bindinput="onKwInput"
        bindconfirm="onSearch"
      />
      <view class="go" bindtap="onSearch">搜索</view>
    </view>

    <view class="qk">
      <view
        class="qk-i"
        wx:for="{{quick}}"
        wx:key="k"
        data-k="{{item.k}}"
        bindtap="onQuickTap"
        hover-class="hover-dim"
      >
        <view class="ic ic-s ic-{{item.i}} icw" />
        <text>{{item.t}}</text>
      </view>
    </view>
    <!-- 关怀模式快捷入口：与「我的」开关共用同一状态源 -->
    <view class="care-entry {{careMode ? 'on' : ''}}" bindtap="onToggleCare" hover-class="hover-dim" role="button">
      <view class="care-entry__ic"><view class="ic ic-s ic-elder"></view></view>
      <view class="care-entry__m">
        <text class="care-entry__t">关怀模式</text>
        <text class="care-entry__d">{{careMode ? '已开启 · 全站大字与大按钮' : '未开启 · 点击放大字号和按钮'}}</text>
      </view>
      <text class="care-entry__state">{{careMode ? '已开启' : '未开启'}}</text>
    </view>
  </view>

  <view class="body">
    <!-- 服务分类 -->
    <view class="sec">
      <view class="st">
        <text class="b">服务分类</text>
        <text class="em">4 类 · 8 板块 · {{totalItems}} 项</text>
        <text class="more" bindtap="onMoreHall">全部 ›</text>
      </view>
      <view class="zq">
        <view
          class="zqc"
          wx:for="{{cats}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onCatTap"
          hover-class="hover-dim"
        >
          <text class="b">{{item.title}}</text>
          <text class="p">{{item.groups}}</text>
          <text class="cnt">{{item.count}} 项</text>
          <text class="ar">›</text>
        </view>
      </view>
    </view>

    <!-- 常用服务 -->
    <view class="sec">
      <view class="st">
        <text class="b">常用服务</text>
        <text class="more" bindtap="onMoreHall">更多 ›</text>
      </view>
      <view class="card">
        <view class="g4 th-blue">
          <view
            class="gi"
            wx:for="{{common}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onCellTap"
            hover-class="hover-dim"
          >
            <view class="ic ic-m ic-{{item.icon}}" />
            <text class="n">{{item.name}}</text>
            <text class="d">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 附近服务：直接展示最近 3 个点位，点击进入地图并聚焦 -->
    <view class="sec">
      <view class="st">
        <text class="b">附近服务</text>
        <text class="em">{{locText}} · 最近 3 个</text>
        <text class="more" data-url="/pages/map/index" bindtap="onGo">全部 {{nearbyTotal}} 个 ›</text>
      </view>
      <view class="card card--pad">
        <view
          class="row nearby-row"
          wx:for="{{nearby}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onNearbyTap"
          hover-class="hover-dim"
        >
          <view class="k" style="background:{{item.bg}};color:{{item.color}}">
            <view class="ic ic-m {{item.icon}}" />
          </view>
          <view class="m">
            <text class="m-t">{{item.name}}</text>
            <text class="m-s">{{item.walk}} · 步行约 {{item.walkMin}} 分钟</text>
          </view>
          <text class="pstatus pstatus--{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <view class="row map-entry" data-url="/pages/map/index" bindtap="onGo" hover-class="hover-dim">
          <view class="k k-blue"><view class="ic ic-m ic-map" /></view>
          <view class="m">
            <text class="m-t">查看完整社区地图</text>
            <text class="m-s">地图 / 列表双视图 · 手选楼栋后自动重排</text>
          </view>
          <text class="ar">›</text>
        </view>
      </view>
    </view>
    <!-- AI 管家提醒 -->
    <view class="sec">
      <view class="st">
        <text class="b">AI 管家提醒</text>
        <text class="em">根据你的工单与社区通知生成</text>
      </view>
      <view class="card card--pad">
        <view class="row" data-url="/pages/service/book/index" bindtap="onGo" hover-class="hover-dim">
          <view class="k k-blue"><view class="ic ic-m ic-wrench" /></view>
          <view class="m">
            <text class="m-t">你的报修已派单</text>
            <text class="m-s">师傅预计 14:00 上门 · 点看进度</text>
          </view>
          <text class="ar">›</text>
        </view>
        <view class="row" data-url="/pages/notice/list/index" bindtap="onGo" hover-class="hover-dim">
          <view class="k k-gold"><view class="ic ic-m ic-droplet" /></view>
          <view class="m">
            <text class="m-t">明天 09:00 起 3 号楼停水</text>
            <text class="m-s">建议今晚先储水 · 家有老人优先</text>
          </view>
          <text class="ar">›</text>
        </view>
      </view>
    </view>

    <!-- 社区动态 -->
    <view class="sec sec--last">
      <view class="st">
        <text class="b">社区动态</text>
        <text class="more" data-filter="" bindtap="onMoreNotice">全部 ›</text>
      </view>
      <view class="card card--pad">
        <view
          class="row"
          wx:for="{{notices}}"
          wx:key="t"
          data-filter="{{item.filter}}"
          bindtap="onMoreNotice"
          hover-class="hover-dim"
        >
          <view class="k k-gray"><text class="tag {{item.type}}">{{item.lb}}</text></view>
          <view class="m">
            <text class="m-t">{{item.t}}</text>
            <text class="m-s">{{item.m}}</text>
          </view>
          <text class="ar">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
