<!-- 首页（设计稿 pgHome v1.4） -->
<view class="page page--tab">
  <!-- 渐变头部 -->
  <view class="hd">
    <view class="sbar light" style="padding-top:{{statusBarHeight}}px">
      <text>08:42</text>
      <text>●●● ▮</text>
    </view>

    <!-- padding-right 避开右上角微信胶囊按钮（2026-10-22：定位胶囊与胶囊按钮重叠） -->
    <view class="r1" style="padding-right:{{navRightPad}}px">
      <view class="lg">邻</view>
      <view class="nm">邻里百事通小助手</view>
      <view class="lb {{locState}}" bindtap="onLocTap">
        <view class="ic ic-s ic-pin icw" />
        <text class="tx">{{locText}}</text>
        <text class="ch">›</text>
      </view>
    </view>

    <view class="sbox">
      <view class="ic ic-s ic-search s-ic" />
      <input
        placeholder="搜服务：保洁、助餐、雨伞、租…"
        value="{{kw}}"
        confirm-type="search"
        bindinput="onKwInput"
        bindconfirm="onSearch"
      />
      <view class="go" bindtap="onSearch">搜索</view>
    </view>

    <view class="qk">
      <view
        class="qk-i"
        wx:for="{{quick}}"
        wx:key="k"
        data-k="{{item.k}}"
        bindtap="onQuickTap"
        hover-class="hover-dim"
      >
        <view class="ic ic-s ic-{{item.i}} icw" />
        <text>{{item.t}}</text>
      </view>
    </view>
  </view>

  <view class="body">
    <!-- 服务分类 -->
    <view class="sec">
      <view class="st">
        <text class="b">服务分类</text>
        <text class="em">4 类 · 8 板块 · {{totalItems}} 项</text>
        <text class="more" bindtap="onMoreHall">全部 ›</text>
      </view>
      <view class="zq">
        <view
          class="zqc"
          wx:for="{{cats}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onCatTap"
          hover-class="hover-dim"
        >
          <text class="b">{{item.title}}</text>
          <text class="p">{{item.groups}}</text>
          <text class="cnt">{{item.count}} 项</text>
          <text class="ar">›</text>
        </view>
      </view>
    </view>

    <!-- 常用服务 -->
    <view class="sec">
      <view class="st">
        <text class="b">常用服务</text>
        <text class="more" bindtap="onMoreHall">更多 ›</text>
      </view>
      <view class="card">
        <view class="g4 th-blue">
          <view
            class="gi"
            wx:for="{{common}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onCellTap"
            hover-class="hover-dim"
          >
            <view class="ic ic-m ic-{{item.icon}}" />
            <text class="n">{{item.name}}</text>
            <text class="d">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 附近服务 -->
    <view class="sec">
      <view class="st">
        <text class="b">附近服务</text>
        <text class="em">按所选位置排序</text>
        <text class="more" data-url="/pages/map/index" bindtap="onGo">地图 ›</text>
      </view>
      <view class="card card--pad">
        <view class="row" data-url="/pages/map/index" bindtap="onGo" hover-class="hover-dim">
          <view class="k k-blue"><view class="ic ic-m ic-map" /></view>
          <view class="m">
            <text class="m-t">社区地图 · 9 个点位</text>
            <text class="m-s">点左上角位置可切换楼栋 · 距离按所选位置算</text>
          </view>
          <text class="ar">›</text>
        </view>
        <view class="row" data-url="/pages/assistant/index" bindtap="onGo" hover-class="hover-dim">
          <view class="k k-indigo"><view class="ic ic-m ic-chat" /></view>
          <view class="m">
            <text class="m-t">问 AI 管家</text>
            <text class="m-s">免费模型在线 · 回答标注来源</text>
          </view>
          <text class="v v-teal">在线</text>
          <text class="ar">›</text>
        </view>
        <view class="row" data-url="/pages/service/meal/index" bindtap="onGo" hover-class="hover-dim">
          <view class="k k-teal"><view class="ic ic-m ic-bowl" /></view>
          <view class="m">
            <text class="m-t">智慧配餐 · 今日三餐</text>
            <text class="m-s">控糖方案 · 1560 kcal · 可换菜</text>
          </view>
          <text class="v v-teal">新</text>
          <text class="ar">›</text>
        </view>
      </view>
    </view>

    <!-- AI 管家提醒 -->
    <view class="sec">
      <view class="st">
        <text class="b">AI 管家提醒</text>
        <text class="em">根据你的工单与社区通知生成</text>
      </view>
      <view class="card card--pad">
        <view class="row" data-url="/pages/service/book/index" bindtap="onGo" hover-class="hover-dim">
          <view class="k k-blue"><view class="ic ic-m ic-wrench" /></view>
          <view class="m">
            <text class="m-t">你的报修已派单</text>
            <text class="m-s">师傅预计 14:00 上门 · 点看进度</text>
          </view>
          <text class="ar">›</text>
        </view>
        <view class="row" data-url="/pages/notice/list/index" bindtap="onGo" hover-class="hover-dim">
          <view class="k k-gold"><view class="ic ic-m ic-droplet" /></view>
          <view class="m">
            <text class="m-t">明天 09:00 起 3 号楼停水</text>
            <text class="m-s">建议今晚先储水 · 家有老人优先</text>
          </view>
          <text class="ar">›</text>
        </view>
      </view>
    </view>

    <!-- 社区动态 -->
    <view class="sec sec--last">
      <view class="st">
        <text class="b">社区动态</text>
        <text class="more" data-filter="" bindtap="onMoreNotice">全部 ›</text>
      </view>
      <view class="card card--pad">
        <view
          class="row"
          wx:for="{{notices}}"
          wx:key="t"
          data-filter="{{item.filter}}"
          bindtap="onMoreNotice"
          hover-class="hover-dim"
        >
          <view class="k k-gray"><text class="tag {{item.type}}">{{item.lb}}</text></view>
          <view class="m">
            <text class="m-t">{{item.t}}</text>
            <text class="m-s">{{item.m}}</text>
          </view>
          <text class="ar">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
