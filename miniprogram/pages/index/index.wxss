/* 首页补充（原型类之外的桥接层） */

/* layout.wxss 的 .ic 尺寸覆盖了 icons 的尺寸档，这里恢复 */
.ic.ic-s { width: 32rpx; height: 32rpx; }
.ic.ic-m { width: 40rpx; height: 40rpx; }

.hover-dim { opacity: .86; }

/* 首页头部：标题必须横排，不能被右侧定位胶囊挤成一字一行；
 * 标题与胶囊放不下时让定位胶囊换到第二行，而不是压缩标题。 */
.hd .nm {
  white-space: nowrap;
  flex: none;
}

.hd .r1 {
  flex-wrap: wrap;
  row-gap: 12rpx;
}

.hd .r1 .lb {
  margin-left: 0;
}

.sbox .s-ic { opacity: .55; }

/* 快捷入口行下移（2026-10-22 用户微调）：全局 .qk margin-top 20rpx → 44rpx */
.qk { margin-top: 44rpx; }

/* 「服务分类」区块上移（2026-10-22 用户微调）：渐变头底部留白 96rpx → 72rpx */
.hd { padding-bottom: 72rpx; }

/* 原型用 HTML 标签选择器（b/p/span/div/li），WXML 里换成类名后补齐排版 */
.st .b { font-size: calc(28rpx * var(--care-scale, 1)); font-weight: 800; flex: 1; }
.st .em { font-style: normal; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); }

/* 头部快捷项（原型 .qk div） */
.qk .qk-i {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .15);
  border: 1px solid rgba(255, 255, 255, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: calc(20rpx * var(--care-scale, 1));
}

/* 服务分类卡文案 */
.zqc .b { font-size: calc(27rpx * var(--care-scale, 1)); font-weight: 800; display: block; letter-spacing: .4rpx; }
.zqc .p {
  display: block;
  margin-top: 6rpx;
  font-size: calc(19rpx * var(--care-scale, 1));
  opacity: .85;
  line-height: 1.35;
  padding-right: 28rpx;
}

.card--pad { padding: 0 24rpx; }

.row .m-t { font-size: calc(25rpx * var(--care-scale, 1)); font-weight: 700; display: block; }
.row .m-s { font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); display: block; margin-top: 4rpx; }

/* 行内图标底色（原型内联 style，改为修饰类） */
.k-blue { background: #E8F0F2; }
.k-indigo { background: #EEEAF6; }
.k-teal { background: #E8F6EF; }
.k-gold { background: #F8E8D8; }
.k-gray { background: #EEE8DD; }

.v-teal { color: #0F625B; font-size: calc(19rpx * var(--care-scale, 1)); }

/* 宫格图标底色 */
.th-blue .ic { background-color: #E8F0F2; }
.th-teal .ic { background-color: #E4F3EE; }
.th-gold .ic { background-color: #F8E8D8; }
.th-indigo .ic { background-color: #EEEAF6; }

.sec--last { margin-bottom: 16rpx; padding-bottom: 24rpx; }

/* ===== 关怀模式快捷入口 ===== */
.care-entry {
  min-height: 72rpx;
  margin-top: 18rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255, 255, 255, .28);
  background: rgba(255, 255, 255, .13);
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #fff;
}
.care-entry.on {
  border-color: #fff;
  background: rgba(255, 255, 255, .24);
}
.care-entry__ic {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.care-entry__m { flex: 1; min-width: 0; }
.care-entry__t { display: block; font-size: calc(23rpx * var(--care-scale, 1)); font-weight: 800; }
.care-entry__d { display: block; margin-top: 2rpx; font-size: calc(18rpx * var(--care-scale, 1)); opacity: .88; }
.care-entry__state {
  flex: none;
  min-height: 48rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .2);
  font-size: calc(18rpx * var(--care-scale, 1));
  font-weight: 700;
  display: flex;
  align-items: center;
}

/* ===== 首页最近 3 个服务点 ===== */
.nearby-row .m { min-width: 0; }
.nearby-row .m-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nearby-row .m-s { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nearby-row .pstatus { flex: none; margin-left: 8rpx; }
.map-entry { border-top: 1px dashed var(--line); }
.pstatus {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: calc(17rpx * var(--care-scale, 1));
  font-weight: 700;
}
.pstatus--ok { color: #0F625B; background: #E4F3EE; }
.pstatus--busy { color: #9A531F; background: #F8E8D8; }
.pstatus--off { color: #7A8596; background: #EEF1F5; }

.care-mode .care-entry {
  min-height: 112rpx;
  align-items: flex-start;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}
.care-mode .care-entry__d,
.care-mode .nearby-row .m-s { white-space: normal; }
.care-mode .care-entry__state { min-height: 56rpx; }
.care-mode .nearby-row { min-height: 124rpx; align-items: flex-start; }
.care-mode .nearby-row .pstatus { align-self: center; }

/* 关怀模式下快捷入口改成两列网格，状态徽标独立换行，避免横向挤压 */
.care-mode .care-entry {
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr);
  align-items: start;
  column-gap: 14rpx;
  row-gap: 8rpx;
  min-height: 112rpx;
  padding: 16rpx;
  box-sizing: border-box;
}
.care-mode .care-entry__ic {
  grid-column: 1;
  grid-row: 1 / span 2;
}
.care-mode .care-entry__m {
  grid-column: 2;
  grid-row: 1;
}
.care-mode .care-entry__state {
  grid-column: 2;
  grid-row: 2;
  justify-self: start;
  min-height: 52rpx;
}
.care-mode .care-entry__d,
.care-mode .nearby-row .m-s {
  white-space: normal;
  overflow-wrap: anywhere;
}

/* ===== 暖纸社区首页视觉强化 ===== */
.hd {
  position: relative;
  overflow: hidden;
  background: var(--brand-gradient);
  padding: 0 26rpx 54rpx;
  border-radius: 0 0 38rpx 38rpx;
  box-shadow: 0 18rpx 40rpx rgba(23, 58, 94, .18);
}
.hd::before,
.hd::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  background: rgba(255, 255, 255, .07);
}
.hd::before { width: 330rpx; height: 330rpx; right: -140rpx; top: -90rpx; }
.hd::after { width: 190rpx; height: 190rpx; left: -100rpx; bottom: 20rpx; }
.hd .r1,
.hd .hero-copy,
.hd .sbox,
.hd .qk,
.hd .care-entry { position: relative; z-index: 1; }

.hero-copy { margin-top: 22rpx; display: flex; flex-direction: column; gap: 6rpx; }
.hero-copy__k { font-size: 16rpx; letter-spacing: 4rpx; color: rgba(255, 255, 255, .58); font-weight: 800; }
.hero-copy__t { font-size: 38rpx; line-height: 1.3; font-weight: 900; color: #fff; letter-spacing: .5rpx; }
.hero-copy__d { font-size: 20rpx; color: rgba(255, 255, 255, .72); }

.hd .sbox {
  margin-top: 24rpx;
  min-height: 82rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, .55);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, .10);
}
.hd .qk { margin-top: 24rpx; }
.hd .qk .qk-i {
  flex-direction: column;
  gap: 5rpx;
  min-height: 92rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .11);
  border-color: rgba(255, 255, 255, .15);
}
.hd .care-entry { border-radius: 22rpx; background: rgba(255, 255, 255, .10); }
.body { margin-top: -30rpx; }
.sec { margin-top: 30rpx; }
.sec .st { padding-bottom: 18rpx; }
.sec .st::before { width: 8rpx; height: 30rpx; border-radius: 999rpx; background: var(--accent-warm); }
.sec .st .b { letter-spacing: .5rpx; }
.card,
.blk {
  border: 1rpx solid rgba(89, 74, 58, .08);
  box-shadow: var(--shadow-card);
}
.zq { gap: 18rpx; }
.zqc { border: 1rpx solid rgba(255, 255, 255, .13); box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, .03); }
.zqc:nth-child(1) { background: linear-gradient(145deg, #173A5E, #245C73); }
.zqc:nth-child(2) { background: linear-gradient(145deg, #147D70, #0F625B); }
.zqc:nth-child(3) { background: linear-gradient(145deg, #B06B21, #8C4F19); }
.zqc:nth-child(4) { background: linear-gradient(145deg, #8C4F3B, #6E382C); }
.row { border-bottom-color: var(--line); }
.row:last-child { border-bottom: 0; }
.row .k { border-radius: 18rpx; }
.nearby-row .pstatus { box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, .03); }
.map-entry { background: #FBF7EF; }
