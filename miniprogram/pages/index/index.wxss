/* ============================================================
 * 首页 v1.2（FE-11）
 * 规格来源：docs/03-设计预览表.md §0 v1.1 现行版式 + docs/03-preview/index.html
 * 硬规则：一律 var(--token)，禁止硬编码色值与字号。
 * ============================================================ */

.page {
  min-height: 100vh;
  background: var(--bg);
}

/* ================= 区域 1：绿色渐变头部（填满顶部） ================= */
.header {
  background: var(--brand-gradient);
  padding: 0 var(--space-4) 96rpx; /* 底部留白供通知卡负边距叠压 */
  position: relative;
}

/* 胶囊占位行（88rpx）：与微信胶囊/灵动岛等高对齐，独占一行 */
.header__capsule-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 定位行（88rpx）：位于胶囊/灵动岛下方 */
.header__nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.header__pin {
  font-size: var(--font-sub);
}

.header__loc {
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--card);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.header__capsule {
  height: 1rpx;
  flex: none;
}

/* 用户信息行 */
.header__user {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-1) 0 var(--space-3);
}

.header__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid var(--card);
  background: rgba(255, 255, 255, 0.25);
  color: var(--card);
  font-size: var(--font-title);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.header__info {
  min-width: 0;
  flex: 1;
}

.header__nick {
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--card);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.header__account {
  margin-top: 4rpx;
  font-size: var(--font-cap);
  color: rgba(255, 255, 255, 0.7);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 紧急援助行（96rpx） */
.header__aid {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header__aid-left {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
}

.header__badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-m);
  background: var(--urgent);
  color: var(--card);
  font-size: var(--font-sub);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: var(--shadow-urgent);
}

.header__aid-text {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--card);
}

.header__aid-btn {
  height: 72rpx;
  min-width: 200rpx;
  padding: 0 var(--space-4);
  border-radius: var(--radius-full);
  background: var(--card);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  flex: none;
  box-shadow: var(--shadow-urgent);
}

.header__aid-btn--hover {
  background: var(--urgent-bg);
  transform: scale(0.98);
}

.header__aid-btn-icon {
  font-size: var(--font-sub);
  color: var(--urgent);
}

.header__aid-btn-text {
  font-size: var(--font-sub);
  font-weight: 700;
  color: var(--urgent);
}

/* ================= 内容区（与头部同一滚动容器） ================= */
.content {
  padding: 0 var(--space-4) var(--space-5);
}

/* 白色通知卡：负边距 -72rpx 叠压头部 */
.notice {
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
  margin-top: -72rpx;
  position: relative;
  z-index: var(--z-sticky);
}

.notice__main {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.notice__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.notice__text {
  flex: 1;
  min-width: 0;
}

.notice__title {
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notice__sub {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 右侧浅绿装饰区（PNG 素材就位前用渐变占位，尺寸 128×88rpx） */
.notice__deco {
  width: 128rpx;
  height: 88rpx;
  border-radius: var(--radius-m);
  background: linear-gradient(135deg, #DFF2E8, #C8E8D8);
  flex: none;
  position: relative;
  overflow: hidden;
}

.notice__deco::after {
  content: '';
  position: absolute;
  left: 24rpx;
  bottom: 0;
  width: 36rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.75);
  border-radius: var(--radius-s) var(--radius-s) 0 0;
  box-shadow: 44rpx 12rpx 0 -8rpx rgba(255, 255, 255, 0.6);
}

.notice__divider {
  height: 2rpx;
  background: var(--line);
  margin: var(--space-3) 0;
}

.notice__retry {
  margin: var(--space-3) 0;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--radius-m);
  background: var(--brand-light);
  color: var(--brand);
  font-size: var(--font-sub);
  font-weight: 600;
}

/* 快捷 pill：本周公告 / 最近路况 */
.pills {
  display: flex;
  gap: var(--space-2);
}

.pill {
  height: 56rpx;
  padding: 0 var(--space-3);
  border-radius: var(--radius-full);
  background: var(--brand-light);
  color: var(--brand);
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: 26rpx;
  font-weight: 600;
}

.pill__icon {
  font-size: var(--font-cap);
}

/* ================= 核心功能宫格 ================= */
.section {
  margin-top: var(--space-4);
}

.section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-2);
}

.section__title {
  font-size: var(--font-title);
  font-weight: 800;
  color: var(--text-1);
  margin-bottom: var(--space-3);
}

/* 带右侧「全部 ›」时必须去掉自身下边距，否则标题与卡片之间空一大截 */
.section__title--inline {
  margin-bottom: 0;
}

.section__more {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-cap);
  color: var(--text-3);
  padding: var(--space-1) 0 var(--space-1) var(--space-2);
}

.section__more-arrow {
  font-size: var(--font-sub);
  line-height: 1;
}

/* v1.0.1 / CR-019 · 栅格改为百分比等分
 * 旧实现：.fn { width: calc((750rpx - 64rpx - 24rpx) / 2) } = 331rpx，
 * 两列需 331×2+24(gap) = 686rpx，而内容区可用宽也正好 686rpx —— 余量为 0。
 * 任何 1rpx 舍入、边框/滚动条占位都会把第 2 张卡挤到下一行 → 变成 1 列 4 行，
 * 右侧整片空白（v1.0.1 用户截图即此形态）。改为 50% - 半间距后与设备宽度无关。
 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.fn {
  width: calc(50% - 12rpx); /* 半间距 = gap/2 = 24rpx/2 */
  min-height: 260rpx; /* 旧实现写死 320rpx，内容仅约 230rpx → 卡内大片竖向空白 */
  margin-bottom: var(--space-3);
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: var(--space-3);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center; /* 内容纵向居中，不再顶部堆一堆、底部空一片 */
  align-items: center;
  text-align: center;
}

.fn--hover {
  background: #FBF8F4;
  transform: scale(0.98);
}

.fn__icon {
  font-size: 72rpx;
  line-height: 1;
  color: var(--brand);
}

.fn--warm .fn__icon {
  color: var(--accent-warm);
}

.fn__name {
  margin-top: var(--space-2);
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--text-1);
}

.fn__sub {
  margin-top: var(--space-1);
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.fn__deco {
  position: absolute;
  right: var(--space-2);
  bottom: var(--space-2);
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-m);
  background: var(--brand-light);
  color: var(--brand);
  opacity: 0.85;
  font-size: var(--font-cap);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fn--warm .fn__deco {
  background: var(--accent-warm-light);
  color: var(--accent-warm);
}

/* ================= v1.0.1 / CR-019：AI 助手入口卡 ================= */
.ai-entry {
  margin-top: 0; /* 宫格最后一行已有 24rpx margin-bottom，这里不再叠加 */
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-l);
  background: var(--brand-light);
  border: 2rpx solid rgba(30, 130, 82, 0.14);
}

.ai-entry--hover {
  background: #DCF0E6;
  transform: scale(0.99);
}

.ai-entry__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-m);
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex: none;
}

.ai-entry__body {
  flex: 1;
  min-width: 0;
}

.ai-entry__title {
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--brand-press);
}

.ai-entry__sub {
  margin-top: 4rpx;
  font-size: var(--font-cap);
  color: var(--brand);
  opacity: 0.88;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ai-entry__go {
  height: 56rpx;
  padding: 0 var(--space-3);
  border-radius: var(--radius-full);
  background: var(--brand);
  color: var(--card);
  font-size: var(--font-cap);
  font-weight: 600;
  display: flex;
  align-items: center;
  flex: none;
}

/* ================= v1.0.1 / CR-019：社区动态 ================= */
.feed {
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: 0 var(--space-4);
}

.feed__item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  padding: var(--space-3) 0;
}

.feed__item + .feed__item {
  border-top: 2rpx solid var(--line);
}

.feed__item--hover {
  background: #FBF8F4;
}

.feed__tag {
  flex: none;
  margin-top: 4rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-s);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  background: var(--green-light);
  color: var(--green);
}

.feed__tag--activity {
  background: var(--brand-light);
  color: var(--brand);
}

.feed__tag--urgent {
  background: var(--urgent-bg);
  color: var(--urgent);
}

.feed__body {
  flex: 1;
  min-width: 0;
}

.feed__title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.feed__meta {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--font-cap);
  color: var(--text-3);
}

.feed__loc {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ================= 紧急求助半屏弹层 ================= */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--mask);
  z-index: var(--z-mask);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background: var(--card);
  border-radius: var(--radius-l) var(--radius-l) 0 0;
  padding: var(--space-4) var(--space-4) var(--space-5);
  z-index: var(--z-modal);
}

.sheet__title {
  font-size: var(--font-title);
  font-weight: 700;
  text-align: center;
  margin-bottom: var(--space-3);
}

.sheet__row {
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid var(--line);
}

.sheet__info {
  min-width: 0;
  flex: 1;
}

.sheet__name {
  font-size: var(--font-card);
  font-weight: 600;
  color: var(--text-1);
}

.sheet__remark {
  margin-top: 4rpx;
  font-size: var(--font-cap);
  color: var(--text-2);
}

.sheet__btn {
  height: 72rpx;
  padding: 0 var(--space-4);
  border-radius: var(--radius-full);
  background: var(--brand);
  color: var(--card);
  font-size: var(--font-sub);
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  flex: none;
}

.sheet__btn--hover {
  background: var(--brand-press);
}

.sheet__footer {
  margin-top: var(--space-3);
  font-size: var(--font-cap);
  color: var(--text-2);
  text-align: center;
}

/* ================= 关怀模式（.care-mode） ================= */
/* 规则：字号重排 + 布局重排（宫格 1 列 4 行）+ 对比度升级，不做整页 scale */
.care-mode .header__nav {
  height: 110rpx;
}

.care-mode .header__user {
  padding: var(--space-2) 0 var(--space-4);
}

.care-mode .header__aid {
  height: 120rpx;
}

.care-mode .header__aid-btn {
  height: 96rpx;
}

.care-mode .notice__icon {
  width: 104rpx;
  height: 104rpx;
}

.care-mode .notice__sub {
  font-size: var(--font-sub);
}

.care-mode .pill {
  height: 72rpx;
  font-size: var(--font-cap);
}

.care-mode .grid {
  flex-direction: column;
}

.care-mode .fn {
  width: 100%;
  min-height: 0; /* 关怀模式由内容撑高，避免固定高度造成卡内空白 */
  margin-bottom: var(--space-3);
}

.care-mode .fn__icon {
  font-size: 96rpx;
}

.care-mode .fn__sub {
  font-size: var(--font-sub);
}

/* v1.0.1：新模块在关怀模式下同样放大 */
.care-mode .ai-entry {
  padding: var(--space-4);
}

.care-mode .ai-entry__icon {
  width: 104rpx;
  height: 104rpx;
  font-size: 52rpx;
}

.care-mode .ai-entry__go {
  height: 72rpx;
  font-size: var(--font-sub);
}

.care-mode .feed__item {
  padding: var(--space-4) 0;
}

.care-mode .feed__tag {
  height: 48rpx;
  font-size: var(--font-cap);
}

.care-mode .sheet__row {
  height: 160rpx;
}

/* ============================================================
 * v1.5 首页改版（对齐设计原型 · 政务蓝）
 * 结构：品牌行 → 搜索框 → 4 快捷 → 通知卡 → 服务分类竖卡 → AI → 动态
 * ============================================================ */

/* 品牌行 */
.brand {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding-bottom: var(--space-3);
}
.brand__logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.brand__info {
  flex: 1;
  min-width: 0;
}
.brand__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}
.brand__loc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
.brand__urgent {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-full);
  background: #fff;
  color: var(--urgent);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex: none;
}
.brand__urgent--hover {
  opacity: 0.85;
}
.brand__urgent-ico {
  font-size: 22rpx;
}
.brand__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

/* 搜索框 */
.search {
  height: 80rpx;
  background: #fff;
  border-radius: var(--radius-m);
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding: 0 var(--space-2) 0 var(--space-3);
  box-shadow: 0 4rpx 16rpx rgba(8, 26, 64, 0.08);
}
.search--hover {
  opacity: 0.94;
}
.search__ico {
  font-size: 26rpx;
  opacity: 0.55;
}
.search__ph {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
}
.search__go {
  flex: none;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-s);
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

/* 4 快捷 */
.qk {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.qk__i {
  flex: 1;
  height: 96rpx;
  border-radius: var(--radius-m);
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}
.qk__i--hover {
  background: rgba(255, 255, 255, 0.28);
}
.qk__ico {
  font-size: 30rpx;
  line-height: 1.2;
}
.qk__tx {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

/* 服务分类竖卡 */
.zq {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.zqc {
  position: relative;
  background: var(--card);
  border-radius: var(--radius-l);
  padding: var(--space-3) 56rpx var(--space-3) var(--space-3);
  box-shadow: var(--shadow-card, 0 2rpx 12rpx rgba(16, 32, 64, 0.06));
}
.zqc--hover {
  background: var(--brand-light);
}
.zqc__top {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
}
.zqc__name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}
.zqc__cnt {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: var(--radius-full);
  padding: 2rpx 12rpx;
}
.zqc__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.zqc__ar {
  position: absolute;
  right: var(--space-3);
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  color: var(--text-3);
}
