/* 首页补充（原型类之外的桥接层） */

/* layout.wxss 的 .ic 尺寸覆盖了 icons 的尺寸档，这里恢复 */
.ic.ic-s { width: 32rpx; height: 32rpx; }
.ic.ic-m { width: 40rpx; height: 40rpx; }

.hover-dim { opacity: .86; }

/* 首页头部：标题必须横排，不能被右侧定位胶囊挤成一字一行；
 * 标题与胶囊放不下时让定位胶囊换到第二行，而不是压缩标题。 */
.hd .nm {
  white-space: nowrap;
  flex: none;
}

.hd .r1 {
  flex-wrap: wrap;
  row-gap: 12rpx;
}

.hd .r1 .lb {
  margin-left: 0;
}

.sbox .s-ic { opacity: .55; }

/* 快捷入口行下移（2026-10-22 用户微调）：全局 .qk margin-top 20rpx → 44rpx */
.qk { margin-top: 44rpx; }

/* 「服务分类」区块上移（2026-10-22 用户微调）：渐变头底部留白 96rpx → 72rpx */
.hd { padding-bottom: 72rpx; }

/* 原型用 HTML 标签选择器（b/p/span/div/li），WXML 里换成类名后补齐排版 */
.st .b { font-size: calc(28rpx * var(--care-scale, 1)); font-weight: 800; flex: 1; }
.st .em { font-style: normal; font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); }

/* 头部快捷项（原型 .qk div） */
.qk .qk-i {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .15);
  border: 1px solid rgba(255, 255, 255, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: calc(20rpx * var(--care-scale, 1));
}

/* 服务分类卡文案 */
.zqc .b { font-size: calc(27rpx * var(--care-scale, 1)); font-weight: 800; display: block; letter-spacing: .4rpx; }
.zqc .p {
  display: block;
  margin-top: 6rpx;
  font-size: calc(19rpx * var(--care-scale, 1));
  opacity: .85;
  line-height: 1.35;
  padding-right: 28rpx;
}

.card--pad { padding: 0 24rpx; }

.row .m-t { font-size: calc(25rpx * var(--care-scale, 1)); font-weight: 700; display: block; }
.row .m-s { font-size: calc(19rpx * var(--care-scale, 1)); color: var(--t3); display: block; margin-top: 4rpx; }

/* 行内图标底色（原型内联 style，改为修饰类） */
.k-blue { background: #EAF1FE; }
.k-indigo { background: #EDEAFE; }
.k-teal { background: #E8F6EF; }
.k-gold { background: #FDF3E1; }
.k-gray { background: #F1F4F9; }

.v-teal { color: #0B6146; font-size: calc(19rpx * var(--care-scale, 1)); }

/* 宫格图标底色 */
.th-blue .ic { background-color: #EAF1FE; }
.th-teal .ic { background-color: #E6F5F2; }
.th-gold .ic { background-color: #FDF3E1; }
.th-indigo .ic { background-color: #EDECFB; }

.sec--last { margin-bottom: 16rpx; padding-bottom: 24rpx; }

/* ===== 关怀模式快捷入口 ===== */
.care-entry {
  min-height: 72rpx;
  margin-top: 18rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255, 255, 255, .28);
  background: rgba(255, 255, 255, .13);
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #fff;
}
.care-entry.on {
  border-color: #fff;
  background: rgba(255, 255, 255, .24);
}
.care-entry__ic {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.care-entry__m { flex: 1; min-width: 0; }
.care-entry__t { display: block; font-size: calc(23rpx * var(--care-scale, 1)); font-weight: 800; }
.care-entry__d { display: block; margin-top: 2rpx; font-size: calc(18rpx * var(--care-scale, 1)); opacity: .88; }
.care-entry__state {
  flex: none;
  min-height: 48rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .2);
  font-size: calc(18rpx * var(--care-scale, 1));
  font-weight: 700;
  display: flex;
  align-items: center;
}

/* ===== 首页最近 3 个服务点 ===== */
.nearby-row .m { min-width: 0; }
.nearby-row .m-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nearby-row .m-s { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nearby-row .pstatus { flex: none; margin-left: 8rpx; }
.map-entry { border-top: 1px dashed var(--line); }
.pstatus {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: calc(17rpx * var(--care-scale, 1));
  font-weight: 700;
}
.pstatus--ok { color: #0B6146; background: #E6F5F2; }
.pstatus--busy { color: #8A5700; background: #FDF3E1; }
.pstatus--off { color: #7A8596; background: #EEF1F5; }

.care-mode .care-entry {
  min-height: 112rpx;
  align-items: flex-start;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}
.care-mode .care-entry__d,
.care-mode .nearby-row .m-s { white-space: normal; }
.care-mode .care-entry__state { min-height: 56rpx; }
.care-mode .nearby-row { min-height: 124rpx; align-items: flex-start; }
.care-mode .nearby-row .pstatus { align-self: center; }

/* 关怀模式下快捷入口改成两列网格，状态徽标独立换行，避免横向挤压 */
.care-mode .care-entry {
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr);
  align-items: start;
  column-gap: 14rpx;
  row-gap: 8rpx;
  min-height: 112rpx;
  padding: 16rpx;
  box-sizing: border-box;
}
.care-mode .care-entry__ic {
  grid-column: 1;
  grid-row: 1 / span 2;
}
.care-mode .care-entry__m {
  grid-column: 2;
  grid-row: 1;
}
.care-mode .care-entry__state {
  grid-column: 2;
  grid-row: 2;
  justify-self: start;
  min-height: 52rpx;
}
.care-mode .care-entry__d,
.care-mode .nearby-row .m-s {
  white-space: normal;
  overflow-wrap: anywhere;
}
