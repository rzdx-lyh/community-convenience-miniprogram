.page.workbench { min-height: 100vh; background: var(--bg); padding: 28rpx; box-sizing: border-box; }
.wb-head { background: linear-gradient(145deg, #173A5E, #102A44); color: #fff; border-radius: 26rpx; padding: 34rpx 30rpx; }
.wb-kicker { font-size: var(--font-cap); opacity: .82; }
.wb-title { margin-top: 8rpx; font-size: var(--font-title); font-weight: 800; }
.wb-user { margin-top: 14rpx; font-size: var(--font-sub); opacity: .9; }
.wb-loading { margin-top: 14rpx; font-size: var(--font-cap); }
.wb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 24rpx; }
.wb-card { background: var(--card); border-radius: 20rpx; padding: 22rpx; box-shadow: var(--shadow-card); }
.wb-card__n { font-size: var(--font-title); font-weight: 800; color: var(--brand); }
.wb-card__t { margin-top: 4rpx; font-size: var(--font-body); font-weight: 800; }
.wb-card__d { margin-top: 8rpx; font-size: var(--font-cap); color: var(--text-2); line-height: 1.5; }
.wb-note { margin-top: 24rpx; padding: 22rpx; border-radius: 18rpx; background: var(--brand-light); color: var(--text-2); font-size: var(--font-sub); line-height: 1.65; }
.wb-actions { margin-top: 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.wb-action { min-height: 88rpx; border-radius: var(--radius-full); border: 2rpx solid var(--line); background: var(--card); color: var(--text-1); font-size: var(--font-sub); font-weight: 700; display: flex; align-items: center; justify-content: center; }
.wb-action--danger { color: var(--urgent); border-color: var(--urgent-line); }
.care-mode .wb-grid { grid-template-columns: 1fr; }
.care-mode .wb-action { min-height: 100rpx; }

/* 赛事版工作台视觉统一 */
.page.workbench { background-color: var(--bg); }
.wb-head { background: var(--brand-gradient); box-shadow: 0 18rpx 40rpx rgba(23, 58, 94, .18); }
.wb-card { border: 1rpx solid rgba(89, 74, 58, .08); box-shadow: var(--shadow-card); }
.wb-card__n { color: var(--accent-warm); }
.wb-note { background: #F4EEE4; border-left: 6rpx solid var(--accent-warm); }
.wb-action { border-color: rgba(89, 74, 58, .12); background: #FFFDF8; }

/* ===== 最近工单列表（2026-11-12） ===== */
.wb-sec { margin-top: 24rpx; }
.wb-sec__h { display: flex; align-items: baseline; justify-content: space-between; padding: 0 4rpx 12rpx; }
.wb-sec__h text:first-child { font-size: var(--font-card); font-weight: 800; color: var(--text-1); }
.wb-sec__n { font-size: var(--font-cap); color: var(--text-3); }
.wb-empty { padding: 26rpx 22rpx; border-radius: 18rpx; background: var(--card); color: var(--text-2); font-size: var(--font-sub); line-height: 1.6; text-align: center; }
.wb-list { display: flex; flex-direction: column; gap: 12rpx; }
.wb-item { border-radius: 18rpx; padding: 20rpx 22rpx; background: var(--card); border: 1rpx solid rgba(89, 74, 58, .08); box-shadow: var(--shadow-card); }
.wb-item--hover { opacity: .9; }
.wb-item__top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.wb-item__t { flex: 1; min-width: 0; font-size: var(--font-body); font-weight: 800; color: var(--text-1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wb-item__s { flex: none; font-size: var(--font-cap); font-weight: 700; color: var(--accent-warm); }
.wb-item__d { margin-top: 8rpx; font-size: var(--font-cap); color: var(--text-2); line-height: 1.55; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.wb-item__m { margin-top: 10rpx; font-size: var(--font-cap); color: var(--text-3); }
