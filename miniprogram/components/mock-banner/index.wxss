/*
 * 演示模式标识（CR-017-c）
 * 三条硬约束：
 *   1. position: fixed 浮层，绝不占文档流高度（首页负边距叠压版式不能插入常规 view）；
 *   2. 禁用品牌绿 #1E8252 与主渐变 —— 用中性警示黄，避免被误认为产品视觉元素；
 *      配色取自设计 token 的中性/警示语义，不新增 token 依赖。
 *   3. 右下角小胶囊，避开 TabBar 与页面既有悬浮按钮。
 */
.mock-banner {
  position: fixed;
  right: 24rpx;
  /* TabBar 高度约 100rpx + 安全边距，再抬 32rpx 避开首页/订单页的悬浮按钮 */
  bottom: 140rpx;
  z-index: var(--z-toast, 9999);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-full, 999rpx);
  background: #fff8e1;
  border: 1rpx solid #f0e0b8;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  /* 标识是辅助信息，不拦截下方页面的点击（首页紧急求助弹层等仍可操作） */
  pointer-events: none;
}

.mock-banner__dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #8a6d3b;
}

.mock-banner__text {
  font-size: var(--font-cap, 22rpx);
  line-height: 1.4;
  color: #8a6d3b;
}
