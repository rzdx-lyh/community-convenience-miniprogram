.care-mode .chip,
.care-mode .ctabs .c,
.care-mode .seg .g,
.care-mode .pgh-chip,
.care-mode .slot-chip,
.care-mode .dept-chip,
.care-mode .bp,
.care-mode .glucose,
.care-mode .fasting,
.care-mode .post,
.care-mode .pickup,
