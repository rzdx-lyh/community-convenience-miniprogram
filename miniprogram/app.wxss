  font-size: var(--font-btn);
}

.care-mode input,
.care-mode textarea,
.care-mode .search__input,
.care-mode .ap__input {
  min-height: 88rpx;
}

.care-mode .sbox,
.care-mode .search__box,
.care-mode .aibar__in {
  height: 96rpx;
