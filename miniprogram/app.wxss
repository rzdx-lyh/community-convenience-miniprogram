/* ===== 关怀模式 2.0：通用布局防错位 =====
 * 字号放大后，固定高度、绝对定位页头和单行标题最容易互相挤压。
 * 这里只调整布局容器，不改变业务颜色与字号阶梯。
 */
.care-mode .sbar {
  height: auto;
  min-height: 64rpx;
  padding-bottom: 6rpx;
  box-sizing: border-box;
}
.care-mode .nav {
  height: auto;
  min-height: 104rpx;
  padding: 8rpx 148rpx 8rpx 72rpx;
  box-sizing: border-box;
}
.care-mode .nav .bk,
.care-mode .nav .rt {
  top: 0;
  bottom: 0;
  height: auto;
  min-height: 104rpx;
  box-sizing: border-box;
}
.care-mode .nav .rt {
  right: 16rpx;
  max-width: 136rpx;
  justify-content: flex-end;
  text-align: right;
  white-space: normal;
  line-height: 1.25;
}
.care-mode .nav > text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.care-mode .st {
  flex-wrap: wrap;
  align-items: center;
  row-gap: 8rpx;
}
.care-mode .st .b,
.care-mode .st b {
  min-width: 0;
  flex: 1 1 auto;
}
.care-mode .st .em,
.care-mode .st .more {
  flex: none;
  white-space: normal;
}
.care-mode .row > .m,
.care-mode .pr .plb {
  min-width: 0;
}
.care-mode .row > .ar,
.care-mode .row > .v,
.care-mode .pr > .ar,
.care-mode .pr > .asw {
  flex: none;
}
.care-mode .ctabs,
.care-mode .tabs,
.care-mode .tb,
.care-mode .styrow {
  flex-wrap: wrap;
  overflow-x: visible;
}
.care-mode .seg {
  flex-wrap: wrap;
}
