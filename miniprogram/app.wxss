.care-mode .btn3,
.care-mode .btn--ghost,
.care-mode .au-btn,
.care-mode .submit,
.care-mode .setup-submit,
.care-mode .sheet__btn,
.care-mode .sht-btn,
.care-mode .sht-btn2,
.care-mode .rec-btn,
.care-mode .ls__btn,
.care-mode .mapd__btn,
.care-mode .act-signup,
.care-mode .empty__btn,
.care-mode .ap__send,
.care-mode .send {
