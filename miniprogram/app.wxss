/* 矢量图标系统（CR-025 · 生成物，见 scripts/gen-icons.mjs）
   布局类体系（CR-028 · 生成物，见 scripts/gen-layout-wxss.mjs）
   必须在最顶部：@import 只允许出现在文件开头 */
@import "./styles/icons.wxss";
@import "./styles/layout.wxss";

/* ============================================================
 * app.wxss · 全局样式与 Design Token
 * 来源：设计原型（政务蓝版，与 docs/03-preview/demo.html 取值一致）
 * 硬规则：组件/页面样式一律 var(--token)，禁止硬编码色值与字号。
 *
 * ⚠ 从「清新绿 v1.1」升级而来：只改本文件的 token 即可整体换肤，
 *   页面层不应出现色值——若发现页面里写死了颜色，应改用 token。
 * ============================================================ */

/* ===== Design Token v1.5（政务蓝 · 对齐设计原型） ===== */
page {
  /* 品牌色（政务蓝：主色 / 亮色 / 按下色 / 浅底 / 渐变） */
  --brand: #1F5FD6;
  --brand-mid: #3B7DEE;
  --brand-press: #153F9B;
  --brand-light: #EAF1FE;
  --brand-gradient: linear-gradient(160deg, #3B7DEE 0%, #1F5FD6 52%, #153F9B 100%);
  /* 辅助色（金：缴费类；青：健康/设备类；靛：圈子/工具类） */
  --accent-warm: #A86A05;
  --accent-warm-light: #FDF3E1;
  --green: #0E7C6B;
  --green-light: #E6F5F2;
  --indigo: #4B45B8;
  --indigo-light: #EDECFB;
  /* 中性色（冷灰，替代原暖米色） */
  --bg: #F3F5F9;
  --card: #FFFFFF;
  --text-1: #12203A;
  --text-2: #4A5A73;
  --text-3: #8593A8;
  --line: #E6EBF2;
  --mask: rgba(10, 15, 25, 0.45);
  /* 功能色 */
  --success: #0E7C6B;
  --warning: #A86A05;
  --info: #1F5FD6;
  --processing: #7A5AF8;
  --error: #C9302C;
  --disabled: #A3ADBB;
  /* 紧急模块 */
  --urgent: #C9302C;
  --urgent-press: #A32E22;
  --urgent-bg: #FDECEA;
  --urgent-line: #E0532F;
  /* 字号阶梯（常规） */
  --font-hero: 48rpx;
  --font-title: 40rpx;
  --font-card: 34rpx;
  --font-body: 32rpx;
  --font-sub: 28rpx;
  --font-cap: 24rpx;
  --font-btn: 34rpx;
  --care-scale: 1;
  /* 间距（8px 栅格） */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --space-6: 64rpx;
  /* 圆角 */
  --radius-s: 8rpx;
  --radius-m: 16rpx;
  --radius-l: 24rpx;
  --radius-full: 999rpx;
  /* 阴影 */
  --shadow-card: 0 4rpx 16rpx rgba(43, 43, 43, 0.06);
  --shadow-urgent: 0 4rpx 16rpx rgba(192, 57, 43, 0.18);
  --shadow-float: 0 8rpx 24rpx rgba(31, 95, 214, 0.28);
  --shadow-modal: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  /* 层级 */
  --z-content: 0;
  --z-sticky: 10;
  --z-fab: 100;
  --z-mask: 900;
  --z-modal: 1000;
  --z-toast: 2000;

  /* ----- 旧占位变量别名（迁移对照 design-tokens §⑧，页面替换完成后删除） ----- */
  --color-primary: var(--brand);
  --color-primary-light: var(--brand-light);
  --color-text: var(--text-1);
  --color-text-secondary: var(--text-2);
  --color-bg: var(--bg);
  --color-card: var(--card);
  --color-success: var(--success);
  --color-warning: var(--warning);
  --color-danger: var(--error);
  --radius-sm: var(--radius-s);
  --radius-md: var(--radius-m);
  --radius-lg: var(--radius-l);
  --font-xs: var(--font-cap);
  --font-sm: var(--font-sub);
  --font-md: var(--font-body);
  --font-lg: var(--font-card);
  --font-xl: var(--font-title);
  --font-xxl: var(--font-hero);

  background: var(--bg);
  color: var(--text-1);
  font-size: var(--font-body);
  line-height: 1.4;
}

/* ===== 关怀模式（全局唯一类名 .care-mode；旧 .elder-mode 保留别名过渡） ===== */
page.care-mode,
.care-mode,
.elder-mode {
  --font-hero: 66rpx;
  --font-title: 58rpx;
  --font-card: 50rpx;
  --font-body: 44rpx;
  --font-sub: 40rpx;
  --font-cap: 36rpx;
  --font-btn: 46rpx;
  --care-scale: 1.35;
  line-height: 1.55;
}

/* ===== 通用工具类 ===== */
.u-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.u-ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.u-card {
  background: var(--card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
}

/* ===== 按压态工具类（CR-028）=====
 * 原型用 CSS :active 表达按压反馈，小程序不支持 :active，
 * 统一改用 hover-class="u-hover" / "u-hover-bg"，避免每页各写一套。
 */
.u-hover {
  opacity: 0.88;
}

.u-hover-bg {
  background: #f3f6fc;
}

.u-hover-scale {
  transform: scale(0.985);
  filter: brightness(0.94);
}

/* ===== 全局导航胶囊行（2026-10-22 用户要求）=====
 * 微信原生白色胶囊固定在上方；页面导航行与胶囊同高，
 * 右侧预留胶囊宽度，胶囊下沿画一条小白线，线下方才开始页面功能。
 * 覆盖 .pgh 彩色页头、首页 .hd 资料行、我的页 .pf-row。
 */
.pgh .pgh-nav {
  box-sizing: border-box;
  height: 76rpx;
  padding-right: 190rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.55);
}

.hd .r1 {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.45);
  padding-bottom: 16rpx;
}

.page .pf-row {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.45);
  padding-bottom: 16rpx;
}

/* 白底二级页导航（.nav）：同样在胶囊行下方给一条可见细线；
 * 白底页头用浅灰线（白色线在白底上不可见），彩色页头仍用白线。
 * 右侧操作位避让微信胶囊。 */
.nav {
  box-sizing: border-box;
  border-bottom: 2rpx solid #DCE3ED;
}

.nav .rt {
  right: 190rpx;
}

/* 白底导航行与胶囊同高（76rpx），分隔线正好落在胶囊下沿 */
.nav,
.nav .bk,
.nav .rt {
  height: 76rpx;
}


/* ===== 关怀模式：栅格重排（2026-11-04） =====
 * 字号统一由 --care-scale 放大，这里只处理「放大后放不下」的栅格。
 */
.care-mode .zq {
  grid-template-columns: 1fr;
}
.care-mode .zqc {
  box-sizing: border-box;
  min-height: 250rpx;
  padding: 26rpx 28rpx 76rpx;
}
.care-mode .zqc .p {
  padding-right: 0;
  line-height: 1.5;
}
.care-mode .zqc .cnt {
  bottom: 20rpx;
  font-size: var(--font-cap);
  padding: 4rpx 14rpx;
}
.care-mode .zqc .ar {
  right: 22rpx;
  bottom: 18rpx;
  font-size: 48rpx;
}
.care-mode .g4 {
  grid-template-columns: repeat(2, 1fr);
}
.care-mode .qk {
  flex-wrap: wrap;
}
.care-mode .qk .qk-i {
  flex: 1 1 calc(50% - 7rpx);
}
.care-mode .pf-row {
  gap: 16rpx;
}

/* ===== 关怀模式：全局可点击控件（2026-11-09） =====
 * 字号放大之外，统一保证按钮、输入框、标签、筛选和列表行的可读性与触控高度。
 */
.care-mode button,
.care-mode input,
.care-mode textarea,
.care-mode picker {
  font-size: var(--font-body);
}

