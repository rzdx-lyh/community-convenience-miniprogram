/* ============================================================
 * ui-kit.wxss · 暖纸社区 UI Kit v3
 * 统一导航、页头、卡片、按钮、筛选、表单、弹层与基础动效。
 * 页面专属样式仍可在后面做业务级覆盖。
 * ============================================================ */

.page {
  overflow-x: hidden;
  background-color: var(--bg);
  color: var(--text-1);
}

.page text {
  overflow-wrap: anywhere;
}

.page > .body {
  animation: ui-enter .24s ease-out both;
}

@keyframes ui-enter {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---------- 导航栏 ---------- */
.page .nav {
  height: 88rpx;
  padding: 0 116rpx;
  box-sizing: border-box;
  background: rgba(255, 252, 245, .96);
  border-bottom: 1rpx solid rgba(89, 74, 58, .08);
  box-shadow: 0 8rpx 24rpx rgba(38, 46, 56, .045);
  color: var(--text-1);
  font-size: var(--font-sub);
  font-weight: 900;
  letter-spacing: .4rpx;
}

.page .nav .bk,
.page .nav .rt {
  position: absolute;
  top: 50%;
  height: 62rpx;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-2);
  font-size: var(--font-sub);
  font-weight: 800;
}

.page .nav .bk {
  left: 18rpx;
  width: 62rpx;
  border-radius: 50%;
  background: var(--bg);
  border: 1rpx solid var(--line);
  color: var(--brand);
}

.page .nav .rt {
  right: 20rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: var(--accent-warm);
  background: var(--accent-warm-light);
  font-size: var(--font-cap);
}

/* ---------- 彩色页头 ---------- */
.page .pgh {
  position: relative;
  overflow: hidden;
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 18rpx 44rpx rgba(23, 58, 94, .16);
}

.page .pgh::after {
  content: '';
  position: absolute;
  width: 330rpx;
  height: 330rpx;
  right: -140rpx;
  top: -170rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .07);
  pointer-events: none;
}

.page .pgh-nav {
  position: relative;
  z-index: 2;
  min-height: 76rpx;
  padding: 8rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page .pgh-bk {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, .13);
  border: 1rpx solid rgba(255, 255, 255, .18);
  color: #fff;
  font-size: 38rpx;
  line-height: 1;
}

.page .pgh-t {
  color: #fff;
  font-size: var(--font-sub);
  font-weight: 900;
  letter-spacing: .8rpx;
}

.page .pgh-rt {
  min-height: 48rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, .12);
  color: rgba(255, 255, 255, .86);
  font-size: var(--font-cap);
  font-weight: 700;
}

.page .pgh-ic {
  border: 1rpx solid rgba(255, 255, 255, .22);
  background: rgba(255, 255, 255, .13);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .15);
}

/* ---------- 卡片与列表 ---------- */
.page .card,
.page .blk,
.page .grp,
.page .tool,
.page .nt,
.page .hs,
.page .rcpt,
.page .bill,
.page .skc {
  box-sizing: border-box;
  background: var(--card);
  border: 1rpx solid rgba(89, 74, 58, .085);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(38, 46, 56, .065);
}

.page .grp,
.page .card,
.page .skc {
  overflow: hidden;
}

.page .gh {
  padding: 24rpx 24rpx 4rpx;
}

.page .gh b,
.page .gh .b {
  color: var(--text-1);
  font-weight: 900;
  letter-spacing: .3rpx;
}

.page .gh b::before,
.page .gh .b::before {
  width: 7rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: var(--accent-warm);
}

.page .grp__bd {
  padding-bottom: 22rpx;
}

.page .row,
.page .pr,
.page .acell,
.page .tc {
  transition: background-color .18s ease, transform .18s ease;
}

.page .row:last-child {
  border-bottom: 0;
}

.page .row .k,
.page .row .a,
.page .pr .a {
  border-radius: 18rpx;
}

/* ---------- 区块标题 ---------- */
.page .st {
  padding: 4rpx 28rpx 18rpx;
}

.page .st::before {
  width: 7rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--accent-warm), #8C4F19);
  box-shadow: 0 4rpx 12rpx rgba(196, 106, 46, .18);
}

.page .st b,
.page .st .b {
  color: var(--text-1);
  font-weight: 900;
  letter-spacing: .2rpx;
}

.page .st .more {
  color: var(--accent-warm);
  font-weight: 700;
}

/* ---------- 按钮 ---------- */
.page .btn,
.page .btn2,
.page .btn3,
.page .sht-main,
.page .sheet__btn--main {
  min-height: 86rpx;
  border: 0;
  border-radius: 22rpx;
  background: linear-gradient(145deg, var(--brand), var(--brand-mid));
  color: var(--card);
  font-size: var(--font-sub);
  font-weight: 900;
  letter-spacing: .4rpx;
  box-shadow: 0 10rpx 26rpx rgba(23, 58, 94, .18);
  transition: transform .12s ease, filter .12s ease, opacity .12s ease;
}

.page .btn.ghost,
.page .btn2.ghost,
.page .btn3.ghost,
.page .sheet__btn--ghost {
  background: var(--bg);
  color: var(--text-2);
  border: 1rpx solid var(--line);
  box-shadow: none;
}

.page .btn3.solid {
  background: var(--accent-warm);
  box-shadow: 0 10rpx 26rpx rgba(196, 106, 46, .2);
}

.page .btn[disabled],
.page .btn2[disabled],
.page .btn3[disabled] {
  background: var(--line);
  color: var(--text-3);
  box-shadow: none;
}

/* ---------- 筛选与标签 ---------- */
.page .chip,
.page .ctabs .c,
.page .seg .g,
.page .pgh-chip,
.page .slot-chip,
.page .dept-chip {
  min-height: 60rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--text-2);
  font-size: var(--font-cap);
  font-weight: 800;
  transition: background-color .16s ease, color .16s ease, border-color .16s ease;
}

.page .chip.on,
.page .ctabs .c.on,
.page .seg .g.on,
.page .pgh-chip.on,
.page .slot-chip.on,
.page .dept-chip.on {
  background: var(--brand);
  border-color: var(--brand);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(23, 58, 94, .16);
}

.page .tag,
.page .pbadge,
.page .bdg {
  border-radius: 999rpx;
  font-weight: 800;
}

/* ---------- 表单 ---------- */
.page .inp,
.page .staff-field,
.page .search__box,
.page .sbox {
  border: 1rpx solid var(--line);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .6);
}

.page .inp {
  min-height: 78rpx;
  border-radius: 18rpx;
  background: var(--card);
  color: var(--text-1);
}

.page .inp:focus {
  border-color: var(--brand-mid);
  box-shadow: 0 0 0 6rpx rgba(46, 107, 120, .08);
}

.page .search__box,
.page .sbox {
  border-radius: 999rpx;
  background: var(--card);
  box-shadow: 0 6rpx 18rpx rgba(38, 46, 56, .055);
}

/* ---------- 弹层 ---------- */
.page .mask {
  background: var(--mask);
}

.page .sheet {
  border-radius: 34rpx 34rpx 0 0;
  background: var(--card);
  box-shadow: 0 -20rpx 52rpx rgba(20, 28, 36, .18);
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

/* ---------- 空态与状态 ---------- */
.page .empty,
.page .wb-empty,
.page .rw-empty,
.page .med-empty {
  color: var(--text-2);
}

.page .zqc,
.page .mcard,
.page .pfa {
  box-shadow: 0 12rpx 30rpx rgba(23, 58, 94, .16);
}

/* ---------- 图形与图标底座 ---------- */
.page .ib {
  border: 1rpx solid rgba(89, 74, 58, .075);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .65);
  transition: transform .16s ease, background-color .16s ease;
}

.page .gi,
.page .cat,
.page .aigc {
  transition: transform .16s ease, opacity .16s ease, background-color .16s ease;
}

/* ---------- 响应式与关怀模式 ---------- */
@media (max-width: 360px) {
  .page .card,
  .page .blk,
  .page .grp {
    margin-left: 20rpx;
    margin-right: 20rpx;
  }
}

.page.care-mode .nav {
  height: auto;
  min-height: 104rpx;
  padding-left: 88rpx;
  padding-right: 160rpx;
}

.page.care-mode .card,
.page.care-mode .blk,
.page.care-mode .grp,
.page.care-mode .tool,
.page.care-mode .nt,
.page.care-mode .hs {
  border-radius: 26rpx;
}

.page.care-mode .btn,
.page.care-mode .btn2,
.page.care-mode .btn3,
.page.care-mode .sht-main,
.page.care-mode .sheet__btn--main {
  min-height: 104rpx;
}

.page.care-mode .chip,
.page.care-mode .ctabs .c,
.page.care-mode .seg .g {
  min-height: 76rpx;
  padding-left: 22rpx;
  padding-right: 22rpx;
}