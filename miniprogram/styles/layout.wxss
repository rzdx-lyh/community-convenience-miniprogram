  38%{transform:translateX(12rpx)}58%{transform:translateX(-8rpx)}78%{transform:translateX(8rpx)}}
.apctx{font-size:19rpx;color:var(--t3);margin:-4rpx 0 16rpx;display:flex;align-items:center;gap:8rpx;flex-wrap:wrap}
.apctx b,.apctx .b{color:var(--blue);font-weight:700}
.apqs{display:flex;flex-direction:column;gap:12rpx;margin-bottom:18rpx}
.apq{font-size:22rpx;color:var(--blue);background:var(--blue-l);border-radius:14rpx;padding:14rpx 20rpx; cursor:pointer;display:flex;align-items:center;gap:10rpx}
.apq:active{opacity:.65}
.aplog{max-height:33vh;overflow-y:auto;display:flex;flex-direction:column;gap:14rpx;margin-bottom:18rpx}
.aplog:empty{display:none}
.apm{font-size:23rpx;line-height:1.7;border-radius:20rpx;padding:16rpx 20rpx;max-width:93%}
.apm.u{align-self:flex-end;background:var(--blue);color:#fff;border-bottom-right-radius:6rpx}
.apm.a{align-self:flex-start;background:#F4F6FA;color:var(--t1);border-bottom-left-radius:6rpx}
.apm.pend{color:var(--t3)}
.apd{display:inline-block;width:20rpx;height:20rpx;border:3.2rpx solid #C3C9D4;border-top-color:var(--blue); border-radius:50%;animation:apsp .8s linear infinite;vertical-align:-1px;margin-right:10rpx}
@keyframes apsp{to{transform:rotate(360deg)}}
.apc{font-size:17rpx;color:var(--t3);margin-top:10rpx;display:flex;gap:12rpx;flex-wrap:wrap;align-items:center}
.apw{font-size:17rpx;color:#8A5A00;background:var(--gold-l);border-radius:10rpx;padding:6rpx 12rpx; margin-top:10rpx;display:flex;align-items:center;gap:6rpx}
.apops{display:flex;gap:20rpx;margin-top:14rpx;font-size:20rpx;font-weight:700}
.apops span,.apops .sp{color:var(--blue);cursor:pointer}
.apops span.cl,.apops .sp.cl{color:var(--t3)}
.apin{display:flex;gap:12rpx;align-items:center}
.apin input{flex:1;height:68rpx;border-radius:16rpx;border:1px solid #E3E8F0;background:#FAFBFD; padding:0 20rpx;font-size:23rpx;outline:none;font-family:inherit;min-width:0}
.apin input:focus{border-color:var(--blue);background:#fff}
.apin .sd{height:68rpx;padding:0 24rpx;border-radius:16rpx;background:var(--blue);color:#fff;font-size:23rpx; font-weight:700;display:flex;align-items:center;flex:none;cursor:pointer}
.apin .sd:active{filter:brightness(.92)}
.aig{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;padding:0 24rpx}
.aigc{background:#fff;border:1px solid var(--line);border-radius:20rpx;padding:20rpx 22rpx; cursor:pointer;box-shadow:var(--sh)}
.aigc:active{transform:scale(.985)}
.aigc .h{display:flex;align-items:center;gap:12rpx;margin-bottom:6rpx}
.aigc .h .k2{width:40rpx;height:40rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;flex:none}
.aigc .h b,.aigc .h .b{font-size:23rpx;font-weight:800}
.aigc p,.aigc .p{font-size:18rpx;color:var(--t3);line-height:1.5}

/* ============================================================
 * 小程序适配层（生成器内联，非原型内容）
 * ============================================================ */

/* 状态栏占位（真机适配，2026-10-21 修正）：
   - 页面统一在 .sbar / .pgh / .hd 上用内联 style="padding-top:{{statusBarHeight}}px"
     由 JS 拿到的精确值撑开刘海，这是唯一的高度来源；
   - 这里**不再叠加** min-height / env(safe-area-inset-top)，避免双重 padding 在真机错位
     （旧版 .sbar 同时有 min-height:48rpx + box-sizing:content-box，padding 叠在 min-height 上，
      不同机型 statusBarHeight 不同 → 状态栏条忽高忽低、内容错位）。
   - box-sizing 用 border-box：padding 计入元素高度，不额外撑高。
   - env() 仅作兜底（无内联时才生效），且与内联不冲突。 */
.sbar {
  box-sizing: border-box;
  /* min-height 同时计入 env(safe-area-inset-top)：个别机型 statusBarHeight 略小于
     真实状态栏高度，内容会顶进系统状态栏被图标压住（2026-10-22 用户截图实锤：
     首页定位胶囊与灵动岛两侧图标重叠）。env 在非刘海屏为 0，无副作用。 */
  min-height: calc(48rpx + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
}
.pgh .sbar,
.hd .sbar {
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top);
}

/* 假状态栏内容隐藏（2026-10-21 真机错位反馈）：
   项目是 navigationStyle:custom，系统真状态栏本来就显示；
   原型自带的假时钟/信号条（08:42 · ●●● · 邻里小助手）会与之重复，
   真机上是「两条状态栏 + 灵动岛压中间」的错位观感。
   .sbar 仅保留 spacer 职责（padding-top 撑开状态栏高度），文字一律隐藏。
   已核实 22 处 .sbar 内均为纯装饰文本，无交互内容（map 的定位状态在
   下方「重新定位」按钮仍有入口）。 */
.sbar text {
  display: none;
}

/* fixed 底部操作条会盖住内容：页面根节点加 .page--fbar 自动留白 */
.page--fbar {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 原生 tabBar 页面：底部无需再给固定条留白 */
.page--tab {
  padding-bottom: 0;
}

/* 底部安全区（iPhone 全面屏 home indicator，2026-10-21 修正）：
   fixed bottom:0 的元素若不补 env(safe-area-inset-bottom)，会被底部小黑条盖住或贴死，
   真机表现为底部操作条/弹层错位。这里只改 padding-bottom（保留各自原有横向 padding），
   内容留白由 .page--fbar 的 padding 承担。 */
.footbar,
.fbar {
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}
.fab2 {
  bottom: calc(132rpx + env(safe-area-inset-bottom));
}
.sheet {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

/* 弹层默认不占位（显隐交给 wx:if），避免空节点参与布局 */
.mask--wx {
  z-index: 900;
}
.sheet--wx {
  z-index: 950;
  border-radius: 32rpx 32rpx 0 0;
}

/* 小程序 button 原生样式重置：原型里 .btn/.btn2 是全宽块按钮 */
button.btn,
button.btn2,
button.btn3 {
  margin: 0;
  padding: 0;
  line-height: normal;
  font-weight: inherit;
  border-radius: inherit;
}
button.btn::after,
button.btn2::after,
button.btn3::after {
  border: 0;
}

/* input / textarea 在小程序里默认有内边距与高度差异，统一按原型尺寸 */
input.inp,
textarea.ta {
  box-sizing: border-box;
}

/* 按钮文字居中（2026-10-22 用户截图：弹层「取消/提交借用登记」文字顶左上角）：
   原型 .btn 按浏览器 <button> 默认居中设计；小程序里这些按钮多用 <view class="btn">
   承载，view 无默认居中 → 这里统一补 flex 居中（.fbar .btn2 已自带，不冲突）。 */
.btn,
.btn2,
.btn3 {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* 单行/多行截断工具（原型用 CSS 实现，小程序同样适用，此处仅补 -webkit 前缀） */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 滚动条隐藏（原型各横向滚动容器用） */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

/* 内联 CSS 变量兜底：原型有 .xc / .mring 依赖内联 style 传 --xk/--mc/--p，
   小程序对「style 里写自定义属性」支持不稳定，这里给默认值，页面改用修饰类传色。 */
.xc {
  --xbg: #FFF9ED;
  --xbd: #F1E2C2;
  --xk: #A86A05;
}
.xc.x-sell { --xbg: #F5F3FF; --xbd: #E3DDFB; --xk: #4B45B8; }
.xc.x-event { --xbg: #ECF9F6; --xbd: #CFEBE4; --xk: #0E7C6B; }
.xc.x-road { --xbg: #F1F5FD; --xbd: #DAE5F8; --xk: #1F5FD6; }
.mring { --mc: #1FA97A; --p: 0; }

/* 彩色页头主题（原型每个 .pgh 用内联 style="--h1:..;--h2:.." 传色，
   小程序不认内联变量 → 收敛成 5 套主题类，页面写 class="pgh pgh--teal" 即可）。
   取色与原型一致：蓝=家政/通用，金=缴费，青=健康/设备，靛=圈子/工具，红=紧急。 */
.pgh--blue { --h1: #2E6BE0; --h2: #153F9B; }
.pgh--gold { --h1: #F2A93B; --h2: #A85A08; }
.pgh--teal { --h1: #0E8F9E; --h2: #0A5A66; }
.pgh--indigo { --h1: #6C63D8; --h2: #4B45B8; }
.pgh--red { --h1: #D9534F; --h2: #A32E22; }
.pgh--green { --h1: #12A08A; --h2: #0B6E5F; }
